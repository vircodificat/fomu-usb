import uart

//> The echo server: the bridge between the USB core's byte stream and
//> the raw UART wires (wired up in src/top.vir).
//>
//> Data path (the echo):
//>
//>     host --USB--> usb_rx (Pipe) --> EchoFifo --> UartSender --> txd
//>                                                                    | (loop wire,
//>                                                                    |  see top.vir)
//>     host <--USB-- usb_tx (Pipe) <-- hold slot <-- UartReceiver <-- rxd
//>
//> Bytes from the host are *rendered* onto the raw `txd` line at
//> 115200 8N1 (src/uart.vir); bytes read from the raw `rxd` line are
//> pushed back to the host unmodified.  The loop that turns this into
//> an echo lives at the top level (`txd` registered into `rxd`), so
//> the lines stay consumable: cut that one wire and drive `rxd` from
//> something else.
//>
//> Flow control, end to end (nothing in this chain can drop a byte):
//>
//> - `usb_rx.ready` is low once the EchoFifo holds 12 bytes; the USB core then
//>   stops popping its rx FIFO and NAKs bulk-OUT packets, and the host
//>   retries.
//> - The sender only starts a new byte once the previously *received*
//>   byte has been handed to the USB core (`tx_drained`), so the hold
//>   slot can never be overwritten by a later received byte.
//> - Bytes are only pushed into the USB core's tx FIFO when it has
//>   room (`usb_tx.ready`).

ext mod EchoFifo {
    //> A 16x8 circular FIFO (storage in ext/echo_fifo.sv -- Virdant
    //> cannot express indexed memories inside a plain `mod`, so the
    //> storage primitive is Verilog while the echo server stays
    //> Virdant).  Interface contract:
    //>
    //> - `push_valid` pushes `push_data` onto the tail on that clk
    //>   edge.  There is no push-side backpressure; the `room` throttle
    //>   below is what keeps the queue from overflowing.
    //> - `pop_en` consumes the head byte on that clk edge.  `pop_data`
    //>   is a registered read: the head mux is captured on every clk
    //>   edge, so the byte consumed at cycle N appears on `pop_data`
    //>   during cycle N+1 (and pop_data tracks the new head again from
    //>   cycle N+2 on).  The echo server pairs its registered sender
    //>   load strobe (`pop_r`, below) with exactly that one-clk-later
    //>   byte; it pops at most one byte per sender frame (~4170 clks
    //>   apart) and never pops an empty queue, so the pairing holds.
    //> - `count` is the number of stored bytes (0..16, saturating:
    //>   a simultaneous push and pop is a no-op).  `room` is high while
    //>   count < 12; the 4 slots still free at that threshold absorb
    //>   the bytes in flight in the USB core's pop pipeline (rx_pop_d
    //>   -> rx_valid_r -> rx_valid (outgoing reg) in src/usb.vir) after the
    //>   throttle takes effect.
    incoming clock      : Clock
    incoming push_data  : Word[8]
    incoming push_valid : Bit
    incoming pop_en     : Bit
    outgoing pop_data   : Word[8]
    outgoing count      : Word[5]
    outgoing room       : Bit
}

pub mod EchoServer {
    //> System clock, 48 MHz on Fomu (one UART bit time is 417 clks;
    //> see src/uart.vir).
    incoming clock : Clock

    //> The USB core's bulk-OUT byte stream (host -> echo): the echo
    //> is the consumer (server) side.  Each popped byte arrives as a
    //> 1-clock @Valid payload; pushing it into the EchoFifo on that
    //> same edge IS the pop.
    server socket usb_rx of Pipe[Word[8]]
    //> The USB core's bulk-IN byte stream (echo -> host): the echo
    //> is the producer (client) side.  A 1-clock @Valid payload per
    //> byte; ready is the core's registered tx FIFO room (one clk
    //> stale -- the core re-checks !txfifo.full at the write edge,
    //> txfifo_wr_d in src/usb.vir).
    client socket usb_tx of Pipe[Word[8]]

    //> The raw UART lines (115200 8N1).  In the current Top they are
    //> joined through a one-clk registered loopback (src/top.vir).
    outgoing txd : Bit
    incoming rxd : Bit

    //> The rx pipe's payload, unpacked for the EchoFifo push.
    wire rx_strobe : Bit {
        it := match usb_rx.data {
            case @Valid(dontcare) => true
            case @Invalid()       => false
        }
    }
    wire rx_byte : Word[8] {
        it := match usb_rx.data {
            case @Valid(b)  => b
            case @Invalid() => 0w8
        }
    }

    mod fifo of EchoFifo {
        it.clock      := clock
        it.push_data  := rx_byte
        it.push_valid := rx_strobe
        it.pop_en     := fifo_pop
    }

    // Flow control back to the USB core (= fifo.room): low once the
    // EchoFifo holds 12 bytes = stop popping bytes out of the rx
    // FIFO (the core will NAK bulk-OUT packets instead).  The 4
    // slots still free at that threshold absorb the bytes in flight
    // in the core's pop pipeline (see the EchoFifo contract).
    usb_rx.ready := fifo.room

    mod sender of uart::UartSender {
        it.clock := clock
        it.data  := fifo.pop_data
    }

    // Hand the head of the queue to the sender whenever it is idle,
    // the queue has a byte, and the echo side has drained the previous
    // received byte (tx_drained, below).
    //
    // The fifo's head mux is REGISTERED (see the EchoFifo contract):
    // pop_en at cycle N consumes the head, and the byte appears on
    // pop_data during cycle N+1 -- so the sender's load strobe is the
    // registered pop_r, not fifo_pop.  !pop_r in the pop condition
    // keeps exactly one byte in flight between the pop and the load
    // (without it the still-idle sender would trigger a second pop one
    // cycle after the first and strand the byte it just popped).
    wire fifo_pop : Bit {
        it := (fifo.count != 0w5) && sender.ready && tx_drained && !pop_r
    }

    reg pop_r : Bit on clock {
        initial it <= false
        it <= fifo_pop
    }

    sender.data_valid := pop_r

    txd := sender.tx

    mod receiver of uart::UartReceiver {
        it.clock   := clock
        it.uart_rx := rxd
    }

    reg hold_valid : Bit on clock {
        initial it <= false
        it <= when {
            case receiver.data_valid => true
            case do_push             => false
            else                     => it
        }
    }

    // One-slot holding register between the receiver and the USB core.
    // `tx_drained` guarantees the slot is empty before the sender
    // starts the next byte, so an incoming byte can never overwrite an
    // untransmitted one (the two events below can therefore never
    // coincide).
    reg tx_data : Word[8] on clock {
        initial it <= 0w8
        it <= when {
            case receiver.data_valid => receiver.data
            else                     => it
        }
    }

    wire do_push : Bit {
        it := hold_valid && usb_tx.ready
    }

    // The tx pipe's payload: the hold slot's registered byte rides
    // @Valid for exactly the 1-clock push strobe.  The core
    // registers the write and re-checks !txfifo.full at the write
    // edge (txfifo_wr_d in src/usb.vir).
    usb_tx.data := when {
        case do_push => @Valid(tx_data)
        else         => @Invalid()
    }

    // The sender may start the next byte only once the previously
    // received byte has been handed to the USB core.
    wire tx_drained : Bit {
        it := !hold_valid
    }
}
