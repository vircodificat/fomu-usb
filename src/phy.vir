import crc

//> The USB physical layer ("PHY") mods: everything between the raw
//> pad samples and the decoded / encoded bit streams.
//>
//> Receive side: usb::RxPhy synchronizes the raw D+/D- pads, decodes
//> the line states (SE0/SE1/J/K), recovers the bit clock (4x
//> oversampling: 48 MHz core clock = 4 clock cycles per FS bit), and
//> emits the decoded bit stream plus the SOP/EOP/error/bus_reset
//> strobes.  The NRZI decode and bit destuffing it builds on live in
//> their own mods (usb::NrziDecoder, usb::BitDestuffer).
//>
//> Transmit side: usb::TxPhy is the mirror image -- packet records
//> (pid / len / byte stream) in, NRZI-encoded bit-stuffed pad drive
//> out, with EOP/SE0 sequencing and the payload CRC16 from
//> crc::Crc16.
//>
//> The bidirectional pad cells themselves stay vendored in
//> ext/usb_pads.sv (UsbPads) -- see src/usb.vir.

//> NRZI decoder: recovers the data bit from the synchronized D+/D-
//> levels.  NRZI encodes a 1 as "line level unchanged since the last
//> sample" and a 0 as "level changed", so the decoder keeps the
//> previous sample's levels (lev_d / lev_n) and compares.
//>
//> The parent (usb::RxPhy) owns the pad synchronizers and the clock
//> recovery that generates the `sample` strobe; this mod is pure
//> decode.
mod NrziDecoder {
    //> 48 MHz clock.
    incoming clock : Clock
    //> Synchronous reset (core reset from UsbController).  Parks the
    //> level history at the idle line state (J: D+ high, D- low).
    incoming reset : Bit
    //> 1-clock strobe at the mid-bit sample point (generated by the
    //> parent's clock recovery: `jk && (ph == 1w2)`).  The decoder
    //> loads its level history and captures `bit_sampled` on this
    //> edge.
    incoming sample : Bit
    //> Synchronized D+ sample (the parent owns the 2-flop `Sync`s;
    //> already aligned to clock).
    incoming dp_sync : Bit
    //> Synchronized D- sample.
    incoming dn_sync : Bit

    // The NRZI decode of the line levels: current synchronized
    // levels against the registered previous-sample reference.
    wire decode : Bit {
        it := (dp_sync == lev_d) && (dn_sync == lev_n)
    }
    //> The NRZI decode of the line levels as they are right now.
    //> Only meaningful at sample instants -- between samples the
    //> line may be mid-transition and this is noise.  Exists so
    //> same-edge logic (the destuffer, `error`) can decide before
    //> the sample edge lands, instead of one bit late.
    outgoing bit_live : Bit {
        it := decode
    }
    //> The decoded bit of the most recent sample: captured on the
    //> sample edge, then held stable for the whole bit time.  This
    //> is the deliverable -- downstream logic reads this (with
    //> `bit_valid`) and never sees the line wiggle.
    outgoing reg bit_sampled : Bit on clock {
        initial it <= false
    }

    //> Previous bit sample on D+ (NRZI decode reference).  Reset/idle
    //> value = J (D+ high).
    reg lev_d : Bit on clock {
        initial it <= true
    }
    //> Previous bit sample on D- (NRZI decode reference).  Reset/idle
    //> value = J (D- low).
    reg lev_n : Bit on clock {
        initial it <= false
    }

    when {
        case reset {
            bit_sampled <= false
            lev_d <= true
            lev_n <= false
        }
        case sample {
            bit_sampled <= decode
            lev_d <= dp_sync
            lev_n <= dn_sync
        }
    }
}

//> Bit destuffer: undoes USB bit stuffing.  The 6th consecutive
//> decoded 1 arms `drop_state`; the next (stuffed 0) bit is dropped
//> -- `bit_valid` is suppressed for it -- and a 1 in that slot is a
//> stuffing violation (`violation`, latched into the parent's
//> `error`).
mod BitDestuffer {
    //> 48 MHz clock.
    incoming clock : Clock
    //> Synchronous reset (core reset from UsbController).
    incoming reset : Bit
    //> In-packet flag: the destuffer state (consecutive-ones count,
    //> drop arm) clears whenever the packet ends or on reset.
    incoming active : Bit
    //> 1-clock strobe at the mid-bit sample point, same edge the
    //> decoder loads on.
    incoming sample : Bit
    //> Decoded NRZI bit for the current cycle (combinational from
    //> the decoder -- pre-edge value at the sample edge).
    incoming bit_live : Bit

    //> 1-clock strobe: `bit_sampled` is good this cycle (suppressed
    //> for the dropped stuff bit).
    outgoing reg bit_valid : Bit on clock {
        initial it <= false
        it <= when {
            case reset                    => false
            case sample && !drop_state  => true
            else                        => false
        }
    }
    //> Stuffing violation at this sample: 6 consecutive ones armed
    //> the drop, and the sampled bit in that slot is a 1.  Sticky in
    //> the parent (`error` latches it until the next sop / reset).
    outgoing violation : Bit {
        it := sample && drop_state && bit_live
    }

    //> Consecutive-ones counter for bit destuffing: the 6th
    //> consecutive decoded 1 arms drop_state, so the next (stuffed 0)
    //> bit is dropped.  3 bits is enough headroom: the drop sample
    //> resets the count to 0, so it stops at 6 and never wraps.
    reg stuff_count : Word[3] on clock {
        initial it <= 0w3
    }
    //> Armed after 6 consecutive ones: the next decoded bit is the
    //> stuffed 0 and is dropped (bit_valid suppressed); a 1 in that
    //> slot is a stuffing violation (error).
    reg drop_state : Bit on clock {
        initial it <= false
    }

    // The destuffer registers clear on reset or leaving a packet,
    // and update together at the sample point (drop_state's two
    // sample sub-cases keep their priority: a held drop clears
    // before the arm-bits check can set it again).
    when {
        case reset {
            stuff_count  <= 0w3
            drop_state <= false
        }
        case !active {
            stuff_count  <= 0w3
            drop_state <= false
        }
        case sample {
            stuff_count <= mux(drop_state, 0w3, mux(bit_live, stuff_count + 1w3, 0w3))
            when {
                case drop_state {
                    drop_state <= false
                }
                case bit_live && (stuff_count == 5w3) {
                    drop_state <= true
                }
            }
        }
    }
}

//> RxPhy is the physical receiver ("PHY") for the USB.
//> It is responsible for converting the raw D+ and D- USB signals (`dp` and `dn`).
//> It takes these and applies the NRZI (non-return to zeror inverting) transform
//> and bit un-stuffing.
//>
//> Since USB is asynchronous, RxPhy also synchronizes the incoming packets.
//> On a 48 MHz clock, each USB signal is 4 cycles long;
//> RxPhy samples on the 2nd cycle to get the most accurate reading.
//>
//> RxPhy watches for Start-of-Packet (SOP) and End-of-Packet (EOF).
//>
//> The output of RxPhy are:
//> - the decoded bit
//> - whether we are at the SOP or EOP.
//> - whether the host requested the device reset
//> - whether there was an error
mod RxPhy {
    //> 48 MHz clock: 4 clock cycles per USB FS bit.
    incoming clock : Clock
    //> Synchronous reset (core reset from UsbController).
    //> Deliberately NOT asserted on bus reset: the bus-reset detector lives here.
    incoming reset : Bit

    //> Raw D+ pad sample. Asynchronous.
    incoming dp  : Bit
    //> Raw D- pad sample. Asynchronous.
    incoming dn  : Bit

    //> Decoded (NRZI-decoded) data bit, captured at every mid-bit
    //> sample (including the dropped stuff bit -- the destuffer
    //> suppresses `bit_valid`, not this).  See NrziDecoder.
    outgoing bit_o : Bit {
        it := nrzi_decoder.bit_sampled
    }
    //> 1-clock strobe: bit_o is good this cycle (suppressed for the
    //> dropped stuff bit).  See BitDestuffer.
    outgoing bit_valid : Bit {
        it := unstuff.bit_valid
    }
    //> 1-clock pulse: J->K seen from idle (start of packet).
    outgoing reg sop : Bit on clock {
        initial it <= false
        it <= when {
            case reset      => false
            case sop_edge => true
            else          => false
        }
    }
    //> 1-clock pulse: SE0 held ~1.75 bit times (end of packet).
    outgoing reg eop : Bit on clock {
        initial it <= false
        it <= when {
            case reset     => false
            case eop_now => true
            else         => false
        }
    }
    //> Inside a packet (from sop until eop): armed at the sop edge,
    //> dropped with the eop pulse or on an SE1 (illegal bus state).
    outgoing reg active : Bit on clock {
        initial it <= false
        it <= when {
            case reset      => false
            case sop_edge => true
            case abort    => false
            case eop_now  => false
            else          => it
        }
    }
    //> Sticky per-packet error: SE1 seen (illegal bus state), or 6
    //> ones then a 1 (stuffing violation); cleared at the next sop
    //> (or by reset).
    outgoing reg error : Bit on clock {
        initial it <= false
        it <= when {
            case reset              => false
            case sop_edge           => false
            case abort              => true
            case unstuff.violation => true
            else                    => it
        }
    }
    //> 1-clock pulse: SE0 held >= 2.5 us (host-issued bus reset;
    //> see se0_count).
    outgoing reg bus_reset : Bit on clock {
        initial it <= false
        it <= when {
            case reset              => false
            case se0_count == 119w7 => true
            else                  => false
        }
    }

    //> `dp` but synchronized to `clock`
    mod sync_dp of Sync {
        it.inp   := dp
        it.clock := clock
    }
    //> `dn` but synchronized to `clock`
    mod sync_dn of Sync {
        it.inp   := dn
        it.clock := clock
    }
    //> NRZI decode of the synchronized pads (see NrziDecoder).
    mod nrzi_decoder of NrziDecoder {
        it.clock   := clock
        it.reset   := reset
        it.sample  := sample
        it.dp_sync := sync_dp.out
        it.dn_sync := sync_dn.out
    }
    //> Bit destuffing of the decoded stream (see BitDestuffer).
    mod unstuff of BitDestuffer {
        it.clock    := clock
        it.reset    := reset
        it.active   := active
        it.sample   := sample
        it.bit_live := nrzi_decoder.bit_live
    }
    //> Previous-cycle synchronized D+ sample
    reg dp_p : Bit on clock {
        initial it <= false
        it <= when {
            case reset => false
            else     => sync_dp.out
        }
    }
    //> Previous-cycle synchronized D- sample
    reg dn_p : Bit on clock {
        initial it <= false
        it <= when {
            case reset => false
            else     => sync_dn.out
        }
    }

    wire trans : Bit {
        it := (sync_dp.out != dp_p) || (sync_dn.out != dn_p)
    }
    // bus states: SE0 (both low), SE1 (illegal), K (the sync edge polarity)
    wire se0 : Bit {
        it := !sync_dp.out && !sync_dn.out
    }
    wire se1 : Bit {
        it := sync_dp.out && sync_dn.out
    }
    wire k : Bit {
        it := !sync_dp.out && sync_dn.out
    }
    // next-state helper cones (mutually exclusive where priority
    // matters; reset always wins as the first case of every reg)
    wire sop_edge : Bit {
        it := !active && k
    }
    wire abort : Bit {
        it := active && se1
    }
    wire eop_now : Bit {
        it := active && se0 && (se0_count == 6w7)
    }
    // inside a packet at a J/K level (not SE0/SE1)
    wire jk : Bit {
        it := active && !se1 && !se0
    }
    // the mid-bit sample point: phase 1 captures the synchronized D+ sample
    // (sync_dp.out) 2-3 clks after the line switch -- inside the bit's
    // visibility window for EVERY
    // achievable quantized window width (3, 4 or 5 clks).  The re-align
    // at every transition (ph reset, below) makes the counter read 0 one
    // clock after the transition, so one sample lands per bit window for
    // run windows of any length (4n-1/4n/4n+1 clks all yield n captures).
    wire sample : Bit {
        it := jk && (ph == 1w2)
    }

    //> Bit-phase counter (0..3 clks into the current bit).  Clock
    //> recovery: re-aligned to 0 on every line transition; phase 1 is
    //> the mid-bit sample (see the `sample` wire).
    reg ph : Word[2] on clock {
        initial it <= 0w2
        it <= when {
            case reset       => 0w2
            case sop_edge  => 0w2
            case jk        => mux(trans, 0w2, it + 1w2)
            else           => it
        }
    }

    //> Standalone SE0 timer: the EOP threshold is checked off
    //> `eop_now` (~1.75 bit times = 7 clks); bus_reset fires when the
    //> count reaches 119, i.e. after 120 SE0 clks = 2.5 us.  The
    //> 7-bit counter wraps, so sustained reset SE0 re-pulses every
    //> 128 clks (the ep0 FSM treats each pulse identically).
    reg se0_count : Word[7] on clock {
        initial it <= 0w7
        it <= when {
            case reset => 0w7
            case se0 => it + 1w7
            else     => 0w7
        }
    }

}

//> usb_tx_phy -- packet records back to pads (USB 2.0 §7.1.x), the
//> mirror of the RxPhy in ext/usb_uart.sv.  Drives a complete FS
//> packet: sync pattern, NRZI-encoded bit-stuffed data, and EOP,
//> plus the output enable that connects the driver to the pads only
//> while transmitting.
//>
//> Every reg's next-state below is a plain priority when-chain,
//> including the registered one-clock-ahead decision flags (s_lt_end_r,
//> guard_last_r, bit_end_r, crc_load_r) that keep the big compare
//> cones off the single-cycle engine path.  Timeline conventions
//> (load-bearing -- see wiki/usb-tx-phy.md):
//>
//>   - the level DURING bit time T encodes raw bit f(S_T - 1) (S_T =
//>     s's value during bit time T); the transition for a 0 bit
//>     appears at that bit time's start;
//>   - s is the raw bit index of the NEXT bit time (it advances at
//>     bit-time boundaries, i.e. it names the bit whose encoding
//>     follows); stuffed bit times do not advance it;
//>   - the CRC16 instance consumes each payload raw bit exactly once:
//>     raw bit r at the btc==2 cycle of bit time r-1 -- the bit time
//>     whose end decides r's NRZI level (stuffed bit times are gated
//>     off via cur_stuff).
enum type TxPhyState {
    Idle  = 0b000w3
    Guard = 0b001
    Data  = 0b010
    Eop0  = 0b011
    EopJ  = 0b100
}

mod TxPhy {
    //> 48 MHz clock: 4 clock cycles per USB FS bit.
    incoming clock : Clock
    //> Synchronous reset (core reset from UsbController).
    incoming reset : Bit
    //> 1-clock pulse: latch tx_pid/tx_len and begin the packet.
    incoming tx_start : Bit
    //> PID nibble (the upper complement is generated here).
    incoming tx_pid : Word[4]
    //> Payload byte count, 0..64 (0 => zero-length packet; a data PID
    //> still appends its 16 CRC wire bits).
    incoming tx_len : Word[7]
    //> Producer payload byte: the core top's mux over registered
    //> snapshot-RAM / descriptor-ROM read stages (addressed through
    //> tx_addr_next, see below).  tx_byte_r (below) re-times it into
    //> the engine, one load per payload byte.
    incoming tx_byte : Word[8]

    //> s - 16: the payload bit index (only meaningful for payload
    //> raw bits; a named wire because the Verilog emitter cannot
    //> part-select a parenthesized expression).
    wire s_m16 : Word[10] {
        it := s - 16w10
    }
    //> s - 9: the preload-hint raw index (see tx_addr_next).
    wire s_m9 : Word[10] {
        it := s - 9w10
    }
    //> Byte index of raw bit f(s) -- the byte the NEXT bit time's
    //> encoding will draw from (equals the byte currently being
    //> consumed except during a byte's last bit time).  A pure
    //> bit-slice of s, no state term; it wraps to 126/127 before the
    //> payload.  Unused by the core's instantiation (the fetch
    //> pipeline runs off tx_addr_next); informational only.
    outgoing tx_addr : Word[7] {
        it := s_m16[10..3]
    }
    //> Fetch preload hint: (s-9)>>3 names the payload byte one ahead
    //> of the byte currently being consumed.  Byte-stable across every
    //> bit time of a byte, so a registered copy can address the source
    //> one byte ahead without flipping mid-byte.  Holds 0 through the
    //> PID bit times (preloading payload byte 0); for s < 9 the
    //> subtraction wraps in Word[10] (landing on 126/127, never read).
    outgoing tx_addr_next : Word[7] {
        it := s_m9[10..3]
    }
    //> A packet is in flight (any state but Idle).
    outgoing tx_busy : Bit {
        it := state != #Idle
    }
    //> 1-clock pulse when the bus is released (end of EOP).
    outgoing reg tx_done : Bit on clock {
        initial it <= false
        it <= (state == #EopJ) && bit_end_r
    }
    //> D+ drive level (meaningful only while output_enable is high;
    //> the Eop0 state drives both lines low = SE0 regardless of lvl).
    outgoing dp : Bit {
        it := mux(state == #Eop0, false, mux(lvl, false, true))
    }
    //> D- drive level (ditto).
    outgoing dn : Bit {
        it := mux(state == #Eop0, false, lvl)
    }
    //> Output enable: drive the pads (SB_IO OUTPUT_ENABLE via
    //> UsbPads).  Raised entering Data, dropped at the EOP's last
    //> bit time (bus release).
    outgoing reg output_enable : Bit on clock {
        initial it <= false
        it <= when {
            case reset => false
            case guard_last => true
            case (state == #EopJ) && bit_end_r => false
            else => it
        }
    }

    //> The tx_start pulse, decoded against the FSM (used by every
    //> packet-geometry register).
    wire arm : Bit {
        it := (state == #Idle) && tx_start
    }
    //> The guard-to-data transition edge (the registered guard_last_r
    //> flag decoded against the FSM).
    wire guard_last : Bit {
        it := (state == #Guard) && guard_last_r
    }

    //> The armed PID is a data packet (PID[1:0] == 11): it carries a
    //> payload + CRC16.  Handshake/token PIDs skip both.
    wire is_data : Bit {
        it := pid_r[2..0] == 0b11w2
    }
    //> Same test on the tx_start INPUT (not pid_r): total_bits_r is
    //> computed at the arm edge, one cycle before pid_r is loaded.
    wire tx_pid_data : Bit {
        it := tx_pid[2..0] == 0b11w2
    }
    //> s mod 8: the bit index within the current byte.  For the PID
    //> nibble selector (s in 8..15) and the payload bit selector
    //> ((s-16) & 7 == s mod 8, so one index serves both).
    wire byte_bit_idx : Word[3] {
        it := s[3..0]
    }
    //> The complemented-nibble selector: byte_bit_idx - 4 (0..3 when
    //> byte_bit_idx is 4..7).  A named wire because the Verilog
    //> emitter cannot part-select a parenthesized expression.
    wire pid_comp_idx : Word[3] {
        it := byte_bit_idx - 4w3
    }
    //> raw bit f(s): sync (00000001, bit 7 is the trailing 1), PID
    //> byte ({~pid[3:0], pid[3:0]}, LSB first), payload (LSB first),
    //> CRC16 wire bits shifted MSB-first out of crc_shift.  Evaluated
    //> against the REGISTERED s (stable for the whole 4-clock bit time)
    //> and pipelined into raw_bit_r, which splits the compare/select
    //> chain from the single-cycle engine path.
    wire raw_bit : Bit {
        it := mux(s < 8w10, s == 7w10,
            mux(s < 16w10,
                mux(byte_bit_idx < 4w3,
                    pid_r[dyn byte_bit_idx[2..0]],
                    !pid_r[dyn pid_comp_idx[2..0]]),
                mux(is_data && (s < payload_end_r),
                    tx_byte_r[dyn byte_bit_idx],
                    mux(is_data,
                        crc_shift[15],
                        false))))
    }
    //> The CRC16 wire bits, complemented (crc_wire[i] = ~crc[i]; the
    //> MSB-first wire order comes from shifting crc_shift right, bit
    //> 15 first).
    wire crc_wire : Word[16] {
        it := crc16.crc ^ 65535w16
    }

    // ---- decision flags, registered one clock ahead --------------------

    //> (s < total_bits_r) REGISTERED one cycle ahead: the 10-bit
    //> compare is a carry chain, and it fed cur_stuff's D-cone every
    //> bit time (the tx-engine critical path).  s changes only at
    //> bit-time edges, so the flag captured the previous cycle is
    //> exact at the decision edge -- +0 clock latency, the compare cone
    //> ends at its own register.
    reg s_lt_end_r : Bit on clock {
        initial it <= false
        it <= when {
            case reset => false
            else     => s < total_bits_r
        }
    }
    //> Final S_GUARD cycle (gcnt == 6), REGISTERED one clock ahead: the
    //> bit-time phase decisions read a 1-bit register instead of a
    //> compare cone (the raw compares would chain through 4 enable
    //> LUTs into s's clock enable).
    reg guard_last_r : Bit on clock {
        initial it <= false
        it <= when {
            case reset => false
            else     => (state == #Guard) && (gcnt == 6w3)
        }
    }
    //> Last clock of a bit time (Data/Eop0/EopJ), REGISTERED one clock
    //> ahead from btc == 2 -- same de-coning as guard_last_r.
    reg bit_end_r : Bit on clock {
        initial it <= false
        it <= when {
            case reset => false
            else => ((state == #Data) || (state == #Eop0)
                || (state == #EopJ)) && (btc == 2w2)
        }
    }
    //> 1 while s holds the last payload raw bit's index
    //> (payload_end_r - 1): arms the crc_shift load one cycle later,
    //> at the edge that consumes the last payload raw bit (the LFSR
    //> is final there: its advance fired at that bit time's btc==2).
    //> Stays 1 through a following stuffed bit time (s does not
    //> advance); the re-load is harmless -- the LFSR is static there,
    //> so the captured value is identical.
    reg crc_load_r : Bit on clock {
        initial it <= false
        it <= when {
            case reset => false
            else     => (state == #Data) && (s == payload_end_m1_r)
        }
    }

    // ---- packet geometry, registered at arm -------------------------

    //> Payload raw-bit end index: 16 + 8*tx_len, registered at tx_start
    //> (payload raw bits are f(16) .. f(payload_end_r - 1)).
    reg payload_end_r : Word[10] on clock {
        initial it <= 0w10
        it <= when {
            case reset => 0w10
            case arm => word(tx_len, 0w3) + 16w10
            else     => it
        }
    }
    //> payload_end_r - 1, precomputed at arm (the -1 would otherwise
    //> sit in crc_load_r's per-cycle compare).
    reg payload_end_m1_r : Word[10] on clock {
        initial it <= 0w10
        it <= when {
            case reset => 0w10
            case arm => word(tx_len, 0w3) + 15w10
            else     => it
        }
    }
    //> Total bit-time count: payload_end_r + 16 CRC wire bits for data
    //> PIDs, + 0 for everything else.  Registered at tx_start.
    reg total_bits_r : Word[10] on clock {
        initial it <= 0w10
        it <= when {
            case reset => 0w10
            case arm => word(tx_len, 0w3) + mux(tx_pid_data, 32w10, 16w10)
            else     => it
        }
    }

    // ---- the engine --------------------------------------------------

    //> FSM: Idle (bus released, waiting for tx_start) -> Guard (8 clks
    //> = 2 bit times inter-packet guard, bus still released) -> Data
    //> (the bit-time engine) -> Eop0 (SE0, 2 bit times) -> EopJ (J for
    //> the last bit time, then release) -> Idle.
    reg state : TxPhyState on clock {
        initial it <= #Idle
        it <= when {
            case reset                                => #Idle
            case (it == #Idle) && tx_start          => #Guard
            case (it == #Guard) && guard_last_r     => #Data
            case (it == #Data) && bit_end_r && !stuff_pending && !s_lt_end_r => #Eop0
            case (it == #Eop0) && bit_end_r && (ecnt == 1w3) => #EopJ
            case (it == #EopJ) && bit_end_r         => #Idle
            else                                    => it
        }
    }
    //> Clk phase within the current bit time (0..3).  Holds during
    //> Idle/Guard; zeroed at every bit-time boundary.
    reg btc : Word[2] on clock {
        initial it <= 0w2
        it <= when {
            case reset => 0w2
            case guard_last => 0w2
            case ((state == #Data) || (state == #Eop0) || (state == #EopJ)) && bit_end_r => 0w2
            case (state == #Data) || (state == #Eop0) || (state == #EopJ) => it + 1w2
            else => it
        }
    }
    //> Guard clock counter (8 clks = 2 bit times of bus release between
    //> packets).
    reg gcnt : Word[3] on clock {
        initial it <= 0w3
        it <= when {
            case reset => 0w3
            case arm => 0w3
            case (state == #Guard) && !guard_last_r => it + 1w3
            else => it
        }
    }
    //> EOP bit-time counter: Eop0 lasts 2 bit times (ecnt 0 and 1).
    reg ecnt : Word[3] on clock {
        initial it <= 0w3
        it <= when {
            case reset => 0w3
            case (state == #Data) && bit_end_r && !stuff_pending && !s_lt_end_r => 0w3
            case (state == #Eop0) && bit_end_r && (it != 1w3) => it + 1w3
            else => it
        }
    }
    //> Raw bit index of the NEXT bit time.  Starts at 1 (bit time 0's
    //> encoding -- the J->K sync transition -- is computed at the
    //> guard->data edge); advances only on raw bit times.
    reg s : Word[10] on clock {
        initial it <= 0w10
        it <= when {
            case reset => 0w10
            case guard_last => 1w10
            case (state == #Data) && bit_end_r && !stuff_pending && s_lt_end_r => it + 1w10
            else => it
        }
    }
    //> Armed PID.
    reg pid_r : Word[4] on clock {
        initial it <= 0w4
        it <= when {
            case reset => 0w4
            case arm => tx_pid
            else => it
        }
    }
    //> Armed payload byte count.
    reg len_r : Word[7] on clock {
        initial it <= 0w7
        it <= when {
            case reset => 0w7
            case arm => tx_len
            else => it
        }
    }
    //> Current drive level: 0 = J, 1 = K.  Toggled for a 0 raw bit at
    //> the edge that consumes it (NRZI: the transition appears at the
    //> next bit time's start); forced low entering EopJ.
    reg lvl : Bit on clock {
        initial it <= false
        it <= when {
            case reset => false
            case guard_last => !it
            case (state == #Data) && bit_end_r && stuff_pending => !it
            case (state == #Data) && bit_end_r && s_lt_end_r => mux(raw_bit_r, it, !it)
            case (state == #Eop0) && bit_end_r && (ecnt == 1w3) => false
            else => it
        }
    }
    //> Consecutive raw-1s run counter (stuffing).  Restarted fresh at
    //> the PID (s == 8); the 6th one arms stuff_pending and resets the
    //> count; a 0 clears it.
    reg ones : Word[3] on clock {
        initial it <= 0w3
        it <= when {
            case reset => 0w3
            case guard_last => 0w3
            case (state == #Data) && bit_end_r && stuff_pending => 0w3
            case (state == #Data) && bit_end_r && s_lt_end_r && (s == 8w10) => 0w3
            case (state == #Data) && bit_end_r && s_lt_end_r && raw_bit_r && (it == 5w3) => 0w3
            case (state == #Data) && bit_end_r && s_lt_end_r && raw_bit_r => it + 1w3
            case (state == #Data) && bit_end_r && s_lt_end_r => 0w3
            else => it
        }
    }
    //> The NEXT bit time is a stuffed 0 (armed when the 6th consecutive
    //> one is consumed).  Consumed at the next bit-time edge: that edge
    //> toggles lvl (the stuffed 0's transition), advances neither s nor
    //> crc_shift, and re-arms the run counter.
    reg stuff_pending : Bit on clock {
        initial it <= false
        it <= when {
            case reset => false
            case guard_last => false
            case (state == #Data) && bit_end_r && it => false
            case (state == #Data) && bit_end_r && s_lt_end_r && raw_bit_r && (ones == 5w3) => true
            else => it
        }
    }
    //> The CURRENT bit time is a stuffed 0: gates the CRC16 advance off
    //> for this bit time (a stuffed bit consumes no raw bit).
    reg cur_stuff : Bit on clock {
        initial it <= false
        it <= when {
            case reset => false
            case guard_last => false
            case (state == #Data) && bit_end_r && stuff_pending => true
            case (state == #Data) && bit_end_r => false
            else => it
        }
    }

    // ---- CRC16 wire-bit shift register -------------------------------

    //> The CRC wire bits are SHIFTED out of this register instead of
    //> muxed live from the LFSR: the raw-bit CRC branch would otherwise
    //> compute 15 - (s - payload_end_r) -- a per-cycle 10-bit subtract
    //> + compare cone off the crc16 flops.  Loaded with the final
    //> wire-ordered CRC (crc_wire) at the edge that consumes the last
    //> payload raw bit, then shifted right (MSB first) once per
    //> consumed raw bit; raw_bit's CRC branch is a single register
    //> bit.  Stuffed bit times don't shift; a re-load on a following
    //> stuffed edge is harmless (see crc_load_r).
    reg crc_shift : Word[16] on clock {
        initial it <= 0w16
        it <= when {
            case reset => 0w16
            case bit_end_r && crc_load_r => crc_wire
            case (state == #Data) && bit_end_r && !stuff_pending && s_lt_end_r => word(it[15..0], false)
            else => it
        }
    }

    // ---- producer byte pipeline + CRC instance -----------------------

    //> Producer byte pipeline: tx_addr leads the engine's read by one
    //> bit time (s advances at bit-time edges, the byte is stable for
    //> the whole 4-clock bit time), so this register stage splits the big
    //> producer mux (64:1 snapshot / descriptor ROM) out of the
    //> single-cycle engine path.  The engine reads tx_byte_r only.
    //> Loaded once per payload byte: during bit time k, s = k+1, and
    //> bit 0 of byte b (raw index 16+8b) is CONSUMED at the end of the
    //> previous byte's last bit time -- so the reload fires when
    //> s[2:0]==0 (s = 16+8b, during byte b-1's bit 7); the registered
    //> producer holds THIS byte's data from the previous byte's fetch
    //> window, and the single load per byte keeps it stable through all
    //> eight bit times.
    reg tx_byte_r : Word[8] on clock {
        initial it <= 0w8
        it <= when {
            case (state == #Data) && (btc == 0w2) && (s[3..0] == 0w3) && (s >= 16w10) => tx_byte
            else => it
        }
    }
    //> raw_bit pipelined one clock: f(s) is evaluated against the
    //> registered s, and the engine reads raw_bit_r one clock later,
    //> which splits the compare/select chain and the stuff/NRZI tail
    //> into separate cycles.
    reg raw_bit_r : Bit on clock {
        initial it <= false
        it <= raw_bit
    }

    //> Payload CRC16 (usb::Crc16).  Re-seeded by tx_start; advances one
    //> serial bit at btc==2 of every non-stuffed bit time whose s is a
    //> payload raw-bit index (16 <= s < payload_end_r); din is
    //> raw_bit_r = f(s), the raw bit whose NRZI level decision fires
    //> at this bit time's end -- one ahead of the bit the current
    //> level encodes.
    mod crc16 of crc::Crc16 {
        it.clock := clock
        it.reset := tx_start
        it.adv := (state == #Data) && (btc == 2w2) && !cur_stuff
            && is_data && (s >= 16w10) && (s < payload_end_r)
        it.din := raw_bit_r
    }
}
