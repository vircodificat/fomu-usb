//! The USB physical layer ("PHY") mods: everything between the raw
//! pad samples and the decoded / encoded bit streams.
//!
//! Receive side: RxPhy synchronizes the raw D+/D- pads, decodes
//! the line states (SE0/SE1/J/K), recovers the bit clock (4x
//! oversampling: 48 MHz core clock = 4 clock cycles per FS bit), and
//! emits the decoded bit stream plus the SOP/EOP/error/bus_reset
//! strobes.  The NRZI decode and bit destuffing it builds on live in
//! their own mods (usb::NrziDecoder, usb::BitDestuffer).
//!
//! Transmit side: TxPhy is the mirror image -- packet records
//! (pid / len / byte stream) in, NRZI-encoded bit-stuffed pad drive
//! out, with EOP/SE0 sequencing and the payload CRC16 from
//! crc::Crc16.  It lives below, factored into usb::BitSource (framer)
//! and usb::BitStuffer (bit stuffing) around the bit-time engine
//! itself.
//!
//! The unified Phy mod bundles both chains behind the pad-facing
//! UsbTxRx socket: consumers instantiate one mod and get the decoded
//! RX bit stream / packet strobes and the packet-record TX interface
//! side by side (see src/usb.vir's UsbUart).
//!
//! The bidirectional pad cells themselves stay vendored in
//! ext/usb_pads.sv (UsbPads) -- see src/usb.vir.

import crc
import usb

//> Phy is the unified USB physical layer: the pad-facing UsbTxRx
//> socket plus the whole receive chain (RxPhy) and transmit chain
//> (TxPhy) behind a single instantiation.  RxPhy and TxPhy remain the
//> actual implementations (the PHY testbench drives them directly);
//> this mod is the packaging the core instantiates.
pub mod Phy {
    //> 48 MHz clock: 4 clock cycles per USB FS bit.
    incoming clock : Clock
    //> Synchronous reset (core reset from UsbController).
    //> Deliberately NOT asserted on bus reset: the bus-reset detector
    //> lives in RxPhy.
    incoming reset : Bit

    //> The arm record: @Valid for the 1-clock arm strobe, payload =
    //> the packet to launch (see TxRec / TxPhy).
    incoming tx_arm : Valid[TxRec]
    //> Producer payload byte: the core's fetch pipeline (registered
    //> snapshot-RAM / descriptor-ROM read stages), re-timed inside
    //> TxPhy's BitSource.
    incoming tx_byte : Word[8]

    // ---- pad-facing socket ---------------------------------------------
    //> The bidirectional USB pad boundary, split into unidirectional
    //> channels: the drive levels / tristate control out (cosi, driven
    //> by TxPhy), the pad samples back (soci, feeding RxPhy).  The
    //> electrical bidirectionality stays inside the UsbPads ext mod.
    client socket usb of usb::UsbTxRx {
        it.dp_tx := txphy.dp
        it.dn_tx := txphy.dn
        it.output_enable := txphy.output_enable
    }

    //> Decoded (NRZI-decoded) data bit, captured at every mid-bit
    //> sample.  See RxPhy / NrziDecoder.
    outgoing bit_o : Bit {
        it := rxphy.bit_o
    }
    //> 1-clock strobe: bit_o is good this cycle (suppressed for the
    //> dropped stuff bit).  See RxPhy / BitDestuffer.
    outgoing bit_valid : Bit {
        it := rxphy.bit_valid
    }
    //> 1-clock pulse: J->K seen from idle (start of packet).
    outgoing sop : Bit {
        it := rxphy.sop
    }
    //> 1-clock pulse: SE0 held ~1.75 bit times (end of packet).
    outgoing eop : Bit {
        it := rxphy.eop
    }
    //> Inside a packet (from sop until eop).
    outgoing active : Bit {
        it := rxphy.active
    }
    //> Sticky per-packet error: SE1 seen, or a bit-stuffing violation;
    //> cleared at the next sop (or by reset).
    outgoing error : Bit {
        it := rxphy.error
    }
    //> Bus reset strobe (SE0 held >= 2.5 us): consumers flush state.
    outgoing bus_reset : Bit {
        it := rxphy.bus_reset
    }

    // ---- TX side -------------------------------------------------------
    //> The payload bit index as a byte address: the byte the NEXT bit
    //> time's encoding draws from (informational).
    outgoing tx_addr : Word[7] {
        it := txphy.tx_addr
    }
    //> Fetch preload hint: the payload byte one ahead of the byte
    //> currently being consumed; the core's fetch pipeline registers
    //> it and addresses the producer mux one byte ahead.
    outgoing tx_addr_next : Word[7] {
        it := txphy.tx_addr_next
    }
    //> A packet is in flight (any state but Idle).
    outgoing tx_busy : Bit {
        it := txphy.tx_busy
    }
    //> 1-clock pulse when the bus is released (end of the EOP).
    outgoing tx_done : Bit {
        it := txphy.tx_done
    }

    mod rxphy of RxPhy {
        it.clock := clock
        it.reset := reset
        it.dp := usb.dp_rx
        it.dn := usb.dn_rx
    }

    mod txphy of TxPhy {
        it.clock := clock
        it.reset := reset
        it.tx_arm := tx_arm
        it.tx_byte := tx_byte
    }
}

//> RxPhy is the physical receiver ("PHY") for the USB.
//> It is responsible for converting the raw D+ and D- USB signals (`dp` and `dn`).
//> It takes these and applies the NRZI (non-return to zeror inverting) transform
//> and bit un-stuffing.
//>
//> Since USB is asynchronous, RxPhy also synchronizes the incoming packets.
//> On a 48 MHz clock, each USB signal is 4 cycles long;
//> RxPhy samples on the 2nd cycle to get the most accurate reading.
//>
//> RxPhy watches for Start-of-Packet (SOP) and End-of-Packet (EOF).
//>
//> The output of RxPhy are:
//> - the decoded bit
//> - whether we are at the SOP or EOP.
//> - whether the host requested the device reset
//> - whether there was an error
mod RxPhy {
    //> 48 MHz clock: 4 clock cycles per USB FS bit.
    incoming clock : Clock
    //> Synchronous reset (core reset from UsbController).
    //> Deliberately NOT asserted on bus reset: the bus-reset detector lives here.
    incoming reset : Bit

    //> Raw D+ pad sample. Asynchronous.
    incoming dp  : Bit
    //> Raw D- pad sample. Asynchronous.
    incoming dn  : Bit

    //> Decoded (NRZI-decoded) data bit, captured at every mid-bit
    //> sample (including the dropped stuff bit -- the destuffer
    //> suppresses `bit_valid`, not this).  See NrziDecoder.
    outgoing bit_o : Bit {
        it := nrzi_decoder.bit_sampled
    }
    //> 1-clock strobe: bit_o is good this cycle (suppressed for the
    //> dropped stuff bit).  See BitDestuffer.
    outgoing bit_valid : Bit {
        it := destuffer.bit_valid
    }
    //> 1-clock pulse: J->K seen from idle (start of packet).
    outgoing reg sop : Bit on clock {
        initial it <= false
        it <= when {
            case reset      => false
            case sop_edge => true
            else          => false
        }
    }
    //> 1-clock pulse: SE0 held ~1.75 bit times (end of packet).
    outgoing reg eop : Bit on clock {
        initial it <= false
        it <= when {
            case reset     => false
            case eop_now   => true
            else           => false
        }
    }
    //> Inside a packet (from sop until eop): armed at the sop edge,
    //> dropped with the eop pulse or on an SE1 (illegal bus state).
    outgoing reg active : Bit on clock {
        initial it <= false
        it <= when {
            case reset      => false
            case sop_edge   => true
            case abort      => false
            case eop_now    => false
            else            => it
        }
    }
    //> Sticky per-packet error: SE1 seen (illegal bus state), or 6
    //> ones then a 1 (stuffing violation); cleared at the next sop
    //> (or by reset).
    outgoing reg error : Bit on clock {
        initial it <= false
        it <= when {
            case reset                => false
            case sop_edge             => false
            case abort                => true
            case destuffer.violation  => true
            else                      => it
        }
    }
    //> 1-clock pulse: SE0 held >= 2.5 us (host-issued bus reset;
    //> see se0_count).
    outgoing reg bus_reset : Bit on clock {
        initial it <= false
        it <= when {
            case reset              => false
            case se0_count == 119w7 => true
            else                    => false
        }
    }

    //> `dp` but synchronized to `clock`
    mod sync_dp of Sync {
        it.inp   := dp
        it.clock := clock
    }
    //> `dn` but synchronized to `clock`
    mod sync_dn of Sync {
        it.inp   := dn
        it.clock := clock
    }

    //> Previous-cycle synchronized D+ sample
    reg dp_p : Bit on clock {
        initial it <= false
        it <= when {
            case reset => false
            else     => sync_dp.out
        }
    }
    //> Previous-cycle synchronized D- sample
    reg dn_p : Bit on clock {
        initial it <= false
        it <= when {
            case reset => false
            else     => sync_dn.out
        }
    }

    //> NRZI decode of the synchronized pads
    mod nrzi_decoder of NrziDecoder {
        it.clock   := clock
        it.reset   := reset
        it.sample  := sample
        it.dp_sync := sync_dp.out
        it.dn_sync := sync_dn.out
    }
    //> Bit destuffing of the decoded stream
    mod destuffer of BitDestuffer {
        it.clock    := clock
        it.reset    := reset
        it.active   := active
        it.sample   := sample
        it.bit_live := nrzi_decoder.bit_live
    }
    wire trans : Bit {
        it := (sync_dp.out != dp_p) || (sync_dn.out != dn_p)
    }
    // bus states: SE0 (both low), SE1 (illegal), K (the sync edge polarity)
    wire se0 : Bit {
        it := !sync_dp.out && !sync_dn.out
    }
    wire se1 : Bit {
        it := sync_dp.out && sync_dn.out
    }
    wire k : Bit {
        it := !sync_dp.out && sync_dn.out
    }
    // next-state helper cones (mutually exclusive where priority
    // matters; reset always wins as the first case of every reg)
    wire sop_edge : Bit {
        it := !active && k
    }
    wire abort : Bit {
        it := active && se1
    }
    wire eop_now : Bit {
        it := active && se0 && (se0_count == 6w7)
    }
    // inside a packet at a J/K level (not SE0/SE1)
    wire jk : Bit {
        it := active && !se1 && !se0
    }
    // the mid-bit sample point: phase 1 captures the synchronized D+ sample
    // (sync_dp.out) 2-3 clks after the line switch -- inside the bit's
    // visibility window for EVERY
    // achievable quantized window width (3, 4 or 5 clks).  The re-align
    // at every transition (phase reset, below) makes the counter read 0 one
    // clock after the transition, so one sample lands per bit window for
    // run windows of any length (4n-1/4n/4n+1 clks all yield n captures).
    wire sample : Bit {
        it := jk && (phase == 1w2)
    }

    //> Bit-phase counter (0..3 clks into the current bit).  Clock
    //> recovery: re-aligned to 0 on every line transition; phase 1 is
    //> the mid-bit sample (see the `sample` wire).
    reg phase : Word[2] on clock {
        initial it <= 0w2
        it <= when {
            case reset     => 0w2
            case sop_edge  => 0w2
            case jk        => mux(trans, 0w2, it + 1w2)
            else           => it
        }
    }

    //> Standalone SE0 timer: the EOP threshold is checked off
    //> `eop_now` (~1.75 bit times = 7 clks); bus_reset fires when the
    //> count reaches 119, i.e. after 120 SE0 clks = 2.5 us.  The
    //> 7-bit counter wraps, so sustained reset SE0 re-pulses every
    //> 128 clks (the ep0 FSM treats each pulse identically).
    reg se0_count : Word[7] on clock {
        initial it <= 0w7
        it <= when {
            case reset => 0w7
            case se0   => it + 1w7
            else       => 0w7
        }
    }

}

//> NRZI decoder: recovers the data bit from the synchronized D+/D-
//> levels.  NRZI encodes a 1 as "line level unchanged since the last
//> sample" and a 0 as "level changed", so the decoder keeps the
//> previous sample's levels (lev_d / lev_n) and compares.
//>
//> The parent (usb::RxPhy) owns the pad synchronizers and the clock
//> recovery that generates the `sample` strobe; this mod is pure
//> decode.
mod NrziDecoder {
    //> 48 MHz clock.
    incoming clock : Clock
    //> Synchronous reset (core reset from UsbController).  Parks the
    //> level history at the idle line state (J: D+ high, D- low).
    incoming reset : Bit
    //> 1-clock strobe at the mid-bit sample point.
    //> The decoder loads its level history
    //> and captures `bit_sampled` on this edge.
    incoming sample : Bit
    //> Synchronized D+ sample
    incoming dp_sync : Bit
    //> Synchronized D- sample
    incoming dn_sync : Bit

    //> The NRZI decode of the line levels as they are right now.
    //> Only meaningful at sample instants -- between samples the
    //> line may be mid-transition and this is noise.  Exists so
    //> same-edge logic (the destuffer, `error`) can decide before
    //> the sample edge lands, instead of one bit late.
    outgoing bit_live : Bit {
        it := decode
    }
    //> The decoded bit of the most recent sample: captured on the
    //> sample edge, then held stable for the whole bit time.  This
    //> is the deliverable -- downstream logic reads this (with
    //> `bit_valid`) and never sees the line wiggle.
    outgoing reg bit_sampled : Bit on clock {
        initial it <= false
    }

    //> Previous bit sample on D+ (NRZI decode reference).  Reset/idle
    //> value = J (D+ high).
    reg lev_d : Bit on clock {
        initial it <= true
    }
    //> Previous bit sample on D- (NRZI decode reference).  Reset/idle
    //> value = J (D- low).
    reg lev_n : Bit on clock {
        initial it <= false
    }

    // The NRZI decode of the line levels: current synchronized
    // levels against the registered previous-sample reference.
    wire decode : Bit {
        it := (dp_sync == lev_d) && (dn_sync == lev_n)
    }

    when {
        case reset {
            bit_sampled <= false
            lev_d <= true
            lev_n <= false
        }
        case sample {
            bit_sampled <= decode
            lev_d <= dp_sync
            lev_n <= dn_sync
        }
    }
}

//> Bit destuffer: undoes USB bit stuffing.  The 6th consecutive
//> decoded 1 arms `drop_state`; the next (stuffed 0) bit is dropped
//> -- `bit_valid` is suppressed for it -- and a 1 in that slot is a
//> stuffing violation (`violation`, latched into the parent's
//> `error`).
mod BitDestuffer {
    //> 48 MHz clock.
    incoming clock : Clock
    //> Synchronous reset (core reset from UsbController).
    incoming reset : Bit
    //> In-packet flag: the destuffer state (consecutive-ones count,
    //> drop arm) clears whenever the packet ends or on reset.
    incoming active : Bit
    //> 1-clock strobe at the mid-bit sample point, same edge the
    //> decoder loads on.
    incoming sample : Bit
    //> Decoded NRZI bit for the current cycle (combinational from
    //> the decoder -- pre-edge value at the sample edge).
    incoming bit_live : Bit

    //> 1-clock strobe: `bit_sampled` is good this cycle (suppressed
    //> for the dropped stuff bit).
    outgoing reg bit_valid : Bit on clock {
        initial it <= false
        it <= when {
            case reset                  => false
            case sample && !drop_state  => true
            else                        => false
        }
    }
    //> Stuffing violation at this sample: 6 consecutive ones armed
    //> the drop, and the sampled bit in that slot is a 1.  Sticky in
    //> the parent (`error` latches it until the next sop / reset).
    outgoing violation : Bit {
        it := sample && drop_state && bit_live
    }

    //> Consecutive-ones counter for bit destuffing: the 6th
    //> consecutive decoded 1 arms drop_state, so the next (stuffed 0)
    //> bit is dropped.  3 bits is enough headroom: the drop sample
    //> resets the count to 0, so it stops at 6 and never wraps.
    reg stuff_count : Word[3] on clock {
        initial it <= 0w3
    }
    //> Armed after 6 consecutive ones: the next decoded bit is the
    //> stuffed 0 and is dropped (bit_valid suppressed); a 1 in that
    //> slot is a stuffing violation (error).
    reg drop_state : Bit on clock {
        initial it <= false
    }

    // The destuffer registers clear on reset or leaving a packet,
    // and update together at the sample point (drop_state's two
    // sample sub-cases keep their priority: a held drop clears
    // before the arm-bits check can set it again).
    when {
        case reset {
            stuff_count  <= 0w3
            drop_state   <= false
        }
        case !active {
            stuff_count  <= 0w3
            drop_state   <= false
        }
        case sample {
            stuff_count <= mux(drop_state, 0w3, mux(bit_live, stuff_count + 1w3, 0w3))
            when {
                case drop_state {
                    drop_state <= false
                }
                case bit_live && (stuff_count == 5w3) {
                    drop_state <= true
                }
            }
        }
    }
}

//> The transmit packet record: the strobe+payload bundle that arms
//> the TX engine, carried as Valid[TxRec] -- the @Valid tag is the
//> 1-clock arm strobe, the payload is the packet to launch.  The
//> TX-side mirror of the RX-side records (usb::TokenRec /
//> usb::DataRec / usb::HsRec).
//>
//> `pid` -- the PID nibble (the upper complement is generated in
//>   BitSource).
//> `len` -- payload byte count, 0..64 (0 => zero-length packet; a
//>   data PID still appends its 16 CRC wire bits).
pub struct type TxRec {
    pid : Word[4]
    len : Word[7]
}

//> TxPhy is the physical transmitter ("PHY") for the USB: the mirror
//> image of RxPhy above.  It takes a packet record (pid / len / byte
//> stream) and drives a complete USB Full-Speed packet onto the
//> D+/D- pads -- sync pattern, NRZI-encoded bit-stuffed data, EOP --
//> plus the output enable that connects the driver to the pads only
//> while transmitting.
//>
//> The engine is a small FSM (TxPhyState, below) over 4-clock bit
//> times.  Every decision that shapes the NEXT bit time fires on
//> the final clock of the current one (bit_end_r), which fixes the
//> load-bearing timeline convention: the drive level DURING bit
//> time T encodes raw bit f(S_T - 1) -- S_T is bit_index's value
//> during bit time T -- so the transition for a 0 bit appears at
//> that bit time's start.  bit_index names the raw bit of the NEXT
//> bit time; stuffed bit times do not advance it.
//>
//> The framing lives in BitSource (the raw bit stream f(bit_index),
//> the packet geometry and the payload CRC16) and the stuffing in
//> BitStuffer, both below; this mod owns the FSM, the bit phase and
//> the NRZI level.
mod TxPhy {
    //> 48 MHz clock: 4 clock cycles per USB FS bit.
    incoming clock : Clock
    //> Synchronous reset (core reset from UsbController).
    incoming reset : Bit
    //> The arm record: @Valid for the 1-clock arm strobe; the payload
    //> (pid / len) is latched into the packet geometry at the arm.
    incoming tx_arm : Valid[TxRec]
    //> Producer payload byte: the core top's mux over registered
    //> snapshot-RAM / descriptor-ROM read stages (addressed through
    //> tx_addr_next, see below).  BitSource's fetch pipeline
    //> (tx_byte_r) re-times it into the engine, one load per payload
    //> byte.
    incoming tx_byte : Word[8]

    //> The payload bit index as a byte address: the byte the NEXT
    //> bit time's encoding draws from.  Passthrough of BitSource
    //> (informational; the core's fetch pipeline runs off
    //> tx_addr_next).
    outgoing tx_addr : Word[7] {
        it := bit_source.tx_addr
    }
    //> Fetch preload hint: the payload byte one ahead of the byte
    //> currently being consumed.  Passthrough of BitSource; the core
    //> registers it and addresses the producer mux one byte ahead.
    outgoing tx_addr_next : Word[7] {
        it := bit_source.tx_addr_next
    }
    //> A packet is in flight (any state but Idle).
    outgoing tx_busy : Bit {
        it := state != #Idle
    }
    //> 1-clock pulse when the bus is released (end of the EOP).
    outgoing reg tx_done : Bit on clock {
        initial it <= false
        it <= when {
            case reset => false
            case (state == #EopJ) && bit_end_r => true
            else => false
        }
    }
    //> D+ drive level (meaningful only while output_enable is high):
    //> J (D+ high) while level is 0, K (D+ low) while it is 1; the
    //> Eop0 state drives both lines low = SE0 regardless of level.
    outgoing dp : Bit {
        it := (state != #Eop0) && !level
    }
    //> D- drive level (ditto).
    outgoing dn : Bit {
        it := (state != #Eop0) && level
    }
    //> Output enable: drive the pads (SB_IO OUTPUT_ENABLE via
    //> UsbPads).  Raised entering Data, dropped at the EOP's last bit
    //> time (bus release).
    outgoing reg output_enable : Bit on clock {
        initial it <= false
        it <= when {
            case reset => false
            case guard_last => true
            case (state == #EopJ) && bit_end_r => false
            else => it
        }
    }

    //> The raw-bit framer: packet record in, raw bit out (pipelined
    //> one clock) plus the packet geometry and the fetch hints.
    mod bit_source of BitSource {
        it.clock     := clock
        it.reset     := reset
        it.arm       := arm
        it.byte_load := byte_load
        it.advance   := crc_advance
        it.consume   := consume
        it.tx_pid    := tx_pid
        it.tx_len    := tx_len
        it.tx_byte   := tx_byte
        it.bit_index := bit_index
    }
    //> The transmit-side bit stuffer: inserts the stuffed 0 after six
    //> consecutive raw 1s (see BitStuffer below).
    mod stuffer of BitStuffer {
        it.clock       := clock
        it.reset       := reset
        it.clear       := guard_last
        it.tick        := (state == #Data) && bit_end_r
        it.restart     := (state == #Data) && bit_end_r && bits_remain_r
            && (bit_index == 8w10)
        it.bits_remain := bits_remain_r
        it.raw_bit     := bit_source.bit_o
    }

    // ---- engine strobes: 1-clock decodes of the registered flags ------

    //> The arm record's @Valid tag (the arm strobe, before the FSM
    //> gate below).
    wire tx_arm_valid : Bit {
        it := match tx_arm {
            case @Valid(dontcare) => true
            case @Invalid()       => false
        }
    }
    //> The armed packet's PID (don't-care off the arm; BitSource
    //> consumes it only under arm).
    wire tx_pid : Word[4] {
        it := match tx_arm {
            case @Valid(rec) => rec->pid
            case @Invalid()  => 0w4
        }
    }
    //> The armed packet's payload byte count (ditto).
    wire tx_len : Word[7] {
        it := match tx_arm {
            case @Valid(rec) => rec->len
            case @Invalid()  => 0w7
        }
    }

    //> The arm strobe decoded against the FSM (a packet arms only
    //> while idle).  Used by every packet-geometry register in
    //> BitSource.
    wire arm : Bit {
        it := (state == #Idle) && tx_arm_valid
    }
    //> The guard-to-data transition edge: the start of the packet on
    //> the wire (bit time 0's J->K sync transition).
    wire guard_last : Bit {
        it := (state == #Guard) && guard_last_r
    }
    //> The engine is inside a bit-time state (Data, Eop0 or EopJ).
    wire in_bit_time : Bit {
        it := (state == #Data) || (state == #Eop0) || (state == #EopJ)
    }
    //> The final clock of a raw bit time: a bit-time end whose next
    //> bit time is NOT a stuffed 0 (a stuffed bit time consumes no
    //> raw bit).
    wire raw_bit_end : Bit {
        it := bit_end_r && !stuffer.stuff_next
    }
    //> The final clock of the packet's last raw bit time: the edge
    //> that ends Data (no raw bits remain after this one).
    wire packet_end : Bit {
        it := (state == #Data) && raw_bit_end && !bits_remain_r
    }
    //> Raw-bit consume edge: the engine consumes f(bit_index) here --
    //> the NRZI level decision, the raw-bit index advance, the CRC16
    //> wire-bit shift and (at the last payload raw bit) the crc_shift
    //> load all key on it.
    wire consume : Bit {
        it := (state == #Data) && raw_bit_end && bits_remain_r
    }
    //> The producer-byte window opened: the first clock of the bit
    //> time that begins a payload byte (the engine runs one bit time
    //> ahead, so the reload lands in the previous byte's last bit
    //> time).  BitSource registers tx_byte here.
    wire byte_load : Bit {
        it := (state == #Data) && (bit_phase == 0w2)
            && (bit_index[3..0] == 0w3) && (bit_index >= 16w10)
    }
    //> The CRC16 LFSR advance strobe: the 3rd clock of a non-stuffed
    //> bit time (BitSource gates it to payload raw bits).
    wire crc_advance : Bit {
        it := (state == #Data) && (bit_phase == 2w2) && !stuffer.stuffed
    }

    // ---- decision flags, registered one clock ahead --------------------

    //> Raw bits remain in the packet (bit_index < total_bits),
    //> REGISTERED one cycle ahead: the 10-bit compare is a carry
    //> chain, and it feeds the stuffer's stuff_next D-cone every bit
    //> time (the tx-engine critical path).  bit_index changes only
    //> at bit-time edges, so the flag captured the previous cycle is
    //> exact at the decision edge -- +0 clock latency, the compare
    //> cone ends at its own register.
    reg bits_remain_r : Bit on clock {
        initial it <= false
        it <= when {
            case reset => false
            else => bit_index < bit_source.total_bits
        }
    }
    //> Final Guard cycle (guard_count == 6), REGISTERED one clock
    //> ahead: the bit-time phase decisions read a 1-bit register
    //> instead of a compare cone (the raw compares would chain
    //> through 4 enable LUTs into bit_index's clock enable).
    reg guard_last_r : Bit on clock {
        initial it <= false
        it <= when {
            case reset => false
            else => (state == #Guard) && (guard_count == 6w3)
        }
    }
    //> Last clock of a bit time (Data/Eop0/EopJ), REGISTERED one
    //> clock ahead from bit_phase == 2 -- same de-coning as
    //> guard_last_r.
    reg bit_end_r : Bit on clock {
        initial it <= false
        it <= when {
            case reset => false
            else => in_bit_time && (bit_phase == 2w2)
        }
    }

    // ---- the engine ----------------------------------------------------

    //> FSM: Idle (bus released, waiting for the arm record) -> Guard (8 clks
    //> = 2 bit times inter-packet guard, bus still released) -> Data
    //> (the bit-time engine) -> Eop0 (SE0, 2 bit times) -> EopJ (J for
    //> the last bit time, then release) -> Idle.
    reg state : TxPhyState on clock {
        initial it <= #Idle
        it <= when {
            case reset      => #Idle
            case arm        => #Guard
            case guard_last => #Data
            case packet_end => #Eop0
            case (it == #Eop0) && bit_end_r && (eop_count == 1w3) => #EopJ
            case (it == #EopJ) && bit_end_r => #Idle
            else => it
        }
    }
    //> Clock phase within the current bit time (0..3).  Holds during
    //> Idle/Guard; zeroed at every bit-time boundary.
    reg bit_phase : Word[2] on clock {
        initial it <= 0w2
        it <= when {
            case reset => 0w2
            case guard_last => 0w2
            case in_bit_time && bit_end_r => 0w2
            case in_bit_time => it + 1w2
            else => it
        }
    }
    //> Guard clock counter (8 clks = 2 bit times of released bus
    //> between packets).
    reg guard_count : Word[3] on clock {
        initial it <= 0w3
        it <= when {
            case reset => 0w3
            case arm => 0w3
            case (state == #Guard) && !guard_last_r => it + 1w3
            else => it
        }
    }
    //> EOP bit-time counter: Eop0 lasts 2 bit times (eop_count 0 and
    //> 1).
    reg eop_count : Word[3] on clock {
        initial it <= 0w3
        it <= when {
            case reset => 0w3
            case packet_end => 0w3
            case (state == #Eop0) && bit_end_r && (it != 1w3) => it + 1w3
            else => it
        }
    }
    //> Raw bit index of the NEXT bit time.  Starts at 1 (bit time
    //> 0's encoding -- the J->K sync transition -- is computed at the
    //> guard->data edge); advances only on raw bit times (see
    //> consume).
    reg bit_index : Word[10] on clock {
        initial it <= 0w10
        it <= when {
            case reset => 0w10
            case guard_last => 1w10
            case consume => it + 1w10
            else => it
        }
    }
    //> Current drive level: 0 = J, 1 = K.  Toggled for a 0 raw bit at
    //> the edge that consumes it (NRZI: the transition appears at the
    //> next bit time's start); forced low entering EopJ.
    reg level : Bit on clock {
        initial it <= false
        it <= when {
            case reset => false
            case guard_last => !it
            case (state == #Data) && bit_end_r && stuffer.stuff_next => !it
            case consume => mux(bit_source.bit_o, it, !it)
            case (state == #Eop0) && bit_end_r && (eop_count == 1w3) => false
            else => it
        }
    }
}

//> BitSource -- the TxPhy framer: turns the armed packet record
//> (pid / len / byte stream) into the raw bit stream f(bit_index)
//> the engine encodes: sync pattern (00000001, bit 7 is the trailing
//> 1), PID byte ({~pid[3:0], pid[3:0]}, LSB first), payload bytes
//> (LSB first), then the 16 CRC16 wire bits (complemented, MSB
//> first) for data PIDs -- handshake and token PIDs carry neither
//> payload nor CRC.
//>
//> The parent (TxPhy) owns the FSM and the bit-time phase; it
//> presents the raw bit index plus four strobes.  Every port is
//> evaluated against the REGISTERED engine state and adds no
//> pipeline stage:
//>
//>   - `arm`       -- latch tx_pid / tx_len into the packet geometry
//>                    registers and re-seed the CRC16;
//>   - `byte_load` -- the producer-byte window opened: register
//>                    tx_byte into the one-byte fetch pipeline;
//>   - `advance`   -- the CRC16 LFSR consumes raw bit f(bit_index)
//>                    this cycle, gated here to payload raw bits;
//>   - `consume`   -- raw bit f(bit_index) is consumed at this
//>                    bit-time edge: the CRC wire-bit shift register
//>                    shifts, and the last payload raw bit's edge
//>                    loads it with the completed CRC.
//>
//> Timeline contract (see TxPhy's header): bit_o = f(bit_index) is
//> stable for the whole 4-clock bit time and the engine reads it at
//> the bit-time end's NRZI decision edge; tx_addr_next leads the
//> byte being consumed by one byte so the core's producer mux can
//> preload.
mod BitSource {
    //> 48 MHz clock.
    incoming clock : Clock
    //> Synchronous reset (core reset from UsbController).
    incoming reset : Bit
    //> 1-clock strobe: latch tx_pid/tx_len into the geometry
    //> registers and re-seed the CRC16.
    incoming arm : Bit
    //> 1-clock strobe: register tx_byte into the fetch pipeline.
    incoming byte_load : Bit
    //> 1-clock strobe: the CRC16 LFSR consumes raw bit f(bit_index)
    //> this cycle.
    incoming advance : Bit
    //> 1-clock strobe: raw bit f(bit_index) is consumed at this
    //> bit-time edge.
    incoming consume : Bit
    //> PID nibble (the upper complement is generated here).
    incoming tx_pid : Word[4]
    //> Payload byte count, 0..64 (0 => zero-length packet; a data PID
    //> still appends its 16 CRC wire bits).
    incoming tx_len : Word[7]
    //> Producer payload byte, re-timed by byte_load (see tx_byte_r).
    incoming tx_byte : Word[8]
    //> Raw bit index of the NEXT bit time (from the engine).
    incoming bit_index : Word[10]

    //> Raw bit f(bit_index), pipelined one clock: f() is evaluated
    //> against the registered bit_index (stable for the whole 4-clock
    //> bit time), and the engine reads bit_o one clock later at its
    //> bit-time-end decision edge -- the compare/select chain and the
    //> stuff/NRZI tail land in separate cycles.
    outgoing bit_o : Bit {
        it := raw_bit_r
    }
    //> Total raw-bit count of the packet.  Registered at arm; the
    //> engine's end-of-packet flag (bits_remain_r) compares against
    //> this.
    outgoing total_bits : Word[10] {
        it := total_bits_r
    }
    //> The payload bit index as a byte address (see tx_addr in TxPhy
    //> for the meaning).  Informational only -- the core's fetch
    //> pipeline runs off tx_addr_next.
    outgoing tx_addr : Word[7] {
        it := payload_bit[10..3]
    }
    //> Fetch preload hint: the payload byte one ahead of the byte
    //> currently being consumed, as a byte address.  Byte-stable
    //> across every bit time of a byte, so a registered copy can
    //> address the source one byte ahead without flipping mid-byte.
    //> Holds 0 through the PID bit times (preloading payload byte 0);
    //> for bit_index < 9 the subtraction wraps in Word[10] (landing
    //> on 126/127, never read).
    outgoing tx_addr_next : Word[7] {
        it := preload_bit[10..3]
    }

    //> bit_index - 16: the payload bit index (only meaningful for
    //> payload raw bits).  A named wire because the Verilog emitter
    //> cannot part-select a parenthesized expression.
    wire payload_bit : Word[10] {
        it := bit_index - 16w10
    }
    //> bit_index - 9: the preload-hint raw index (see tx_addr_next).
    //> A named wire for the same reason.
    wire preload_bit : Word[10] {
        it := bit_index - 9w10
    }
    //> The armed PID is a data packet (pid[1:0] == 11): it carries a
    //> payload + CRC16.  Handshake/token PIDs skip both.
    wire is_data : Bit {
        it := pid_r[2..0] == 0b11w2
    }
    //> Same test on the tx_pid INPUT (not pid_r): total_bits_r is
    //> computed at the arm edge, one cycle before pid_r is loaded.
    wire tx_pid_data : Bit {
        it := tx_pid[2..0] == 0b11w2
    }
    //> bit_index mod 8: the bit index within the current byte.  For
    //> the PID nibble selector (bit_index in 8..15) and the payload
    //> bit selector ((bit_index-16) mod 8 == bit_index mod 8, so one
    //> index serves both).
    wire bit_in_byte : Word[3] {
        it := bit_index[3..0]
    }
    //> The complemented-nibble selector: bit_in_byte - 4 (0..3 when
    //> bit_in_byte is 4..7).  A named wire because the Verilog
    //> emitter cannot part-select a parenthesized expression.
    wire pid_comp_index : Word[3] {
        it := bit_in_byte - 4w3
    }
    //> Raw bit f(bit_index): sync pattern (00000001, bit 7 is the
    //> trailing 1), PID byte ({~pid[3:0], pid[3:0]}, LSB first),
    //> payload (LSB first), CRC16 wire bits shifted MSB-first out of
    //> crc_shift.
    wire raw_bit : Bit {
        it := when {
            case bit_index < 8w10 => bit_index == 7w10
            case bit_index < 16w10 => mux(bit_in_byte < 4w3,
                pid_r[dyn bit_in_byte[2..0]],
                !pid_r[dyn pid_comp_index[2..0]])
            case is_data && (bit_index < payload_end_r) =>
                tx_byte_r[dyn bit_in_byte]
            case is_data => crc_shift[15]
            else => false
        }
    }
    //> The CRC16 wire bits, complemented (crc_wire[i] = ~crc[i]; the
    //> MSB-first wire order comes from shifting crc_shift right, bit
    //> 15 first).
    wire crc_wire : Word[16] {
        it := crc16.crc ^ 65535w16
    }

    // ---- packet geometry, registered at arm --------------------------

    //> Payload raw-bit end index: 16 + 8*tx_len (payload raw bits are
    //> f(16) .. f(payload_end_r - 1)).
    reg payload_end_r : Word[10] on clock {
        initial it <= 0w10
        it <= when {
            case reset => 0w10
            case arm => word(tx_len, 0w3) + 16w10
            else => it
        }
    }
    //> payload_end_r - 1, precomputed at arm (the -1 would otherwise
    //> sit in the per-cycle compare against the CRC shift load).
    reg payload_end_m1_r : Word[10] on clock {
        initial it <= 0w10
        it <= when {
            case reset => 0w10
            case arm => word(tx_len, 0w3) + 15w10
            else => it
        }
    }
    //> Total raw-bit count: payload_end_r + 16 CRC wire bits for data
    //> PIDs, + 0 for everything else.
    reg total_bits_r : Word[10] on clock {
        initial it <= 0w10
        it <= when {
            case reset => 0w10
            case arm => word(tx_len, 0w3) + mux(tx_pid_data, 32w10, 16w10)
            else => it
        }
    }
    //> Armed PID.
    reg pid_r : Word[4] on clock {
        initial it <= 0w4
        it <= when {
            case reset => 0w4
            case arm => tx_pid
            else => it
        }
    }

    // ---- producer byte pipeline + CRC16 ------------------------------

    //> Producer byte pipeline: the engine's bit_index leads the read
    //> by one bit time (bit_index advances at bit-time edges, the
    //> byte is stable for the whole 4-clock bit time), so this
    //> register stage splits the big producer mux (64:1 snapshot /
    //> descriptor ROM) out of the engine path.  Loaded once per
    //> payload byte when the parent's byte_load strobe opens the byte
    //> window, and held stable through all eight bit times of its
    //> byte.
    reg tx_byte_r : Word[8] on clock {
        initial it <= 0w8
        it <= when {
            case byte_load => tx_byte
            else => it
        }
    }
    //> raw_bit pipelined one clock (see bit_o).
    reg raw_bit_r : Bit on clock {
        initial it <= false
        it <= raw_bit
    }
    //> The CRC16 wire bits are SHIFTED out of this register instead
    //> of muxed live from the LFSR: the raw-bit CRC branch would
    //> otherwise compute 15 - (bit_index - payload_end_r) -- a
    //> per-cycle 10-bit subtract + compare cone off the crc16 flops.
    //> Loaded with the final wire-ordered CRC (crc_wire) at the
    //> consume edge of the last payload raw bit (the LFSR is final
    //> there: its advance fired at that bit time's 3rd clock), then
    //> shifted right (MSB first) once per consumed raw bit; raw_bit's
    //> CRC branch is a single register bit.  Because the load is
    //> keyed to consume (already stuffed-gated by the parent) rather
    //> than to a registered arm flag, a stuffed bit time after the
    //> payload cannot spuriously re-load it; shifting 0s during the
    //> payload (before the load) is harmless.
    reg crc_shift : Word[16] on clock {
        initial it <= 0w16
        it <= when {
            case reset => 0w16
            case consume && (bit_index == payload_end_m1_r) => crc_wire
            case consume => word(it[15..0], false)
            else => it
        }
    }

    //> Payload CRC16 (crc::Crc16).  Re-seeded by arm; advances one
    //> serial bit when the parent pulses advance (the 3rd clock of
    //> every non-stuffed bit time), gated here to data-PID payload
    //> raw-bit indices (16 <= bit_index < payload_end_r); din is
    //> raw_bit_r = f(bit_index), the raw bit whose NRZI level
    //> decision fires at this bit time's end -- one ahead of the bit
    //> the current level encodes.
    mod crc16 of crc::Crc16 {
        it.clock := clock
        it.reset := arm
        it.adv := advance && is_data && (bit_index >= 16w10)
            && (bit_index < payload_end_r)
        it.din := raw_bit_r
    }
}

//> BitStuffer -- transmit-side bit stuffing: inserts the stuffed 0
//> after six consecutive transmitted 1s (USB 2.0 §7.1.9).  The
//> mirror of BitDestuffer above, which undoes the same insert on
//> the receive side.
//>
//> The parent (TxPhy) owns the FSM and the bit-time phase; it
//> presents the raw bit stream (BitSource's bit_o) plus the
//> bit-time strobes.  Every input is evaluated against the
//> registered engine state and the outputs add no pipeline stage:
//>
//>   - `clear`   -- the packet-start edge (guard->data): the run
//>                  counter and both flags reset;
//>   - `tick`    -- a bit-time boundary inside Data: the flags
//>                  update;
//>   - `restart` -- the first PID bit's tick (bit_index == 8): the
//>                  run counter restarts, so stuffing counts begin
//>                  at the PID, not the sync pattern's trailing 1.
//>
//> Outputs: `stuff_next` -- the NEXT bit time is a stuffed 0 (the
//> engine toggles the level at its edge, advances neither the raw
//> bit index nor the CRC, and re-arms the run counter); `stuffed` --
//> the CURRENT bit time is a stuffed 0 (gates the CRC16 advance
//> off; a stuffed bit consumes no raw bit).
mod BitStuffer {
    //> 48 MHz clock.
    incoming clock : Clock
    //> Synchronous reset (core reset from UsbController).
    incoming reset : Bit
    //> 1-clock strobe: packet-start edge; clear the stuffing state.
    incoming clear : Bit
    //> 1-clock strobe: bit-time boundary inside Data.
    incoming tick : Bit
    //> 1-clock strobe: first-PID-bit tick; restart the run counter.
    incoming restart : Bit
    //> Raw bits remain in the packet (the engine's bits_remain_r).
    incoming bits_remain : Bit
    //> Raw bit f(bit_index) for the current bit time (BitSource's
    //> bit_o).
    incoming raw_bit : Bit

    //> The NEXT bit time is a stuffed 0 (armed when the 6th
    //> consecutive one is consumed).  Consumed at the next bit-time
    //> edge: that edge toggles the level (the stuffed 0's
    //> transition), advances neither the raw bit index nor the CRC,
    //> and re-arms the run counter.
    outgoing reg stuff_next : Bit on clock {
        initial it <= false
        it <= when {
            case reset => false
            case clear => false
            case tick && it => false
            case tick && bits_remain && raw_bit && (ones_count == 5w3) => true
            else => it
        }
    }
    //> The CURRENT bit time is a stuffed 0: gates the CRC16 advance
    //> off for this bit time (a stuffed bit consumes no raw bit).
    outgoing reg stuffed : Bit on clock {
        initial it <= false
        it <= when {
            case reset => false
            case clear => false
            case tick && stuff_next => true
            case tick => false
            else => it
        }
    }

    //> Consecutive raw-1s run counter (stuffing).  Restarted fresh
    //> at the PID (restart); the 6th one arms stuff_next and resets
    //> the count; a 0 clears it.  A stuffed-bit tick re-arms it (so
    //> the stuffed 0 does not count as a run bit).  3 bits is
    //> enough headroom: the count stops at 6 and never wraps.
    reg ones_count : Word[3] on clock {
        initial it <= 0w3
        it <= when {
            case reset => 0w3
            case clear => 0w3
            case tick && stuff_next => 0w3
            case restart => 0w3
            case tick && bits_remain && raw_bit && (it == 5w3) => 0w3
            case tick && bits_remain && raw_bit => it + 1w3
            case tick && bits_remain => 0w3
            else => it
        }
    }
}

enum type TxPhyState {
    Idle
    Guard
    Data
    Eop0
    EopJ
}
