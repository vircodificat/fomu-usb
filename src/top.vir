import ice40
import echo
import usb

export mod Top for ice40::Fomu {
    incoming clock : Clock
    outgoing usb_dp : Bit
    outgoing usb_dn : Bit
    // D+ pull-up enable: MUST be wired through — the platform default is
    // low (= disconnected), so a wrapper that leaves it unwired produces
    // an image no host can ever see.  Driven by the POR: attach only
    // after the ~175 ms power-on count (usb::UsbPor in src/usb.vir; its
    // count is inlined -- no parameter -- so the sim TB eats the full
    // delay).
    outgoing usb_dp_pu : Bit {
        it := por.done
    }
    // heartbeat LEDs (active low on PVT), driven by the core's
    // activity signals
    outgoing led_red   : Bit
    outgoing led_green : Bit
    outgoing led_blue  : Bit

    // Power-on reset
    mod por of usb::PowerOnReset {
        it.clock := clock
    }

    // The USB controller: everything between the byte stream and the
    // pads, in Virdant (src/usb.vir).  Its pad-facing side is
    // unidirectional wires (dp_rx/dn_rx in; dp_tx/dn_tx/output_enable
    // out) -- the only bidirectional nets in the design live inside
    // the UsbPads ext mod below.
    mod usb_controller of usb::UsbController {
        it.clock := clock
        it.por_done := true
    }

    // The pads: the one part that drops down into Verilog, because it
    // is the only part that needs `inout` (two iCE40 SB_IO tristate
    // cells; see ext/usb_pads.sv).  The core-facing side is the
    // UsbTxRx socket, bulk-connected to the controller's; from
    // Virdant's view the socket channels are ordinary unidirectional
    // wires the wrapper assigns to the Top ports.
    mod pads of usb::UsbPads {
        usb_dp := it.usb_dp
        usb_dn := it.usb_dn

        it.usb :=: usb_controller.usb
    }

    // The LEDs (active low on PVT) map the USB controller's activity
    // signals onto the pads: red lights while the USB is receiving
    // data (rxing), green while it is sending (txing); blue is unused
    // (tied off).  The core's rxing/txing are stretched ~175 ms past
    // the last byte, so sustained traffic reads as solid light.
    led_red   := !usb_controller.rxing
    led_green := !usb_controller.txing
    led_blue  := true

    // The echo server: the byte-level consumer of the USB core.  Bytes
    // from the host are rendered onto the raw UART tx line; bytes read
    // from the raw rx line go back to the host.  See src/echo.vir.
    // Both sides now speak Pipe[Word[8]] sockets, so the echo's
    // usb_rx (server) / usb_tx (client) bulk-connect straight onto
    // the controller's rx (client) / tx (server).
    mod echo of echo::EchoServer {
        it.clock := clock
        it.rxd   := uart_rx_reg

        it.usb_rx         :=: usb_controller.rx
        usb_controller.tx :=: it.usb_tx
    }

    // The loopback jumper is REGISTERED: without the register the raw
    // wire forms one long combinational path through the UART
    // (sender.data_buf -> bit_idx mux -> txd -> rxd -> receiver.state /
    // baud_counter), which dominates the vir-flow critical path.  One
    // clk of loop latency is 1/417 of a UART bit time -- invisible to
    // the 8N1 receiver (mid-bit sampling shifts by one cycle of 417).
    reg uart_rx_reg : Bit on clock {
        it <= echo.txd
    }
}
