import ice40
import echo

export mod Top for ice40::Fomu {
    incoming clock : Clock
    outgoing usb_dp : Bit
    outgoing usb_dn : Bit
    // D+ pull-up enable: MUST be wired through — the platform default is
    // low (= disconnected), so a wrapper that leaves it unwired produces
    // an image no host can ever see (the P0 found when the first upload
    // build tied it to 1'b0).
    outgoing usb_dp_pu : Bit
    // heartbeat LEDs (active low on PVT), driven by the ext core
    outgoing led_red   : Bit
    outgoing led_green : Bit
    outgoing led_blue  : Bit

    mod actual_top of FomuTop {
        it.clock := clock
        usb_dp := it.usb_dp
        usb_dn := it.usb_dn
        usb_dp_pu := it.usb_dp_pu
    }

    // The LEDs (active low on PVT) map the USB controller's activity
    // signals onto the pads: red lights while the USB is receiving
    // data (rxing), green while it is sending (txing); blue is unused
    // (tied off).  The ext core's rxing/txing are stretched ~175 ms
    // past the last byte, so sustained traffic reads as solid light.
    led_red   := !actual_top.rxing
    led_green := !actual_top.txing
    led_blue  := true

    // The echo server: the byte-level consumer of the USB core.  Bytes
    // from the host are rendered onto the raw UART tx line; bytes read
    // from the raw rx line go back to the host.  See src/echo.vir.
    mod echo of echo::EchoServer {
        it.clock        := clock
        it.usb_rx_data  := actual_top.rx_data
        it.usb_rx_valid := actual_top.rx_valid
        it.usb_tx_ready := actual_top.tx_ready
    }
    actual_top.tx_data   := echo.tx_data
    actual_top.tx_strobe := echo.tx_strobe
    actual_top.rx_ready  := echo.room

    // The raw UART lines, as internal wires.  This is the point to
    // consume them: uart_tx_line carries everything the host writes,
    // rendered at 115200 8N1; uart_rx_line feeds the echo.  The single
    // assignment below is the loopback jumper that makes the device an
    // echo server -- replace it (and bring the wires to real pins) to
    // talk to an external UART instead.
    wire uart_tx_line : Bit { it := echo.txd }
    // The loopback jumper is REGISTERED: the raw wire made
    // sender.data_buf -> bit_idx mux -> txd -> rxd -> receiver.state /
    // baud_counter decode one combinational path, which was the
    // vir-flow critical path (22.3 ns, 15 ns of it routing).  One clk
    // of loop latency is 1/417 of a UART bit time -- invisible to the
    // 8N1 receiver (mid-bit sampling shifts by one cycle of 417).
    reg uart_rx_reg : Bit on clock {
        it <= uart_tx_line
    }
    echo.rxd := uart_rx_reg
}

// Fomu UART-over-USB PoC — top declaration.
//
// The platform export above wires the ext core (\top::FomuTop) to the
// Fomu pins and instantiates the Virdant echo server (src/echo.vir),
// which renders the USB byte stream onto internal raw UART wires
// (115200 8N1) and echoes bytes read from them back to the host.
ext mod FomuTop {
    //> 48 MHz board clock (pin F4).
    incoming clock : Clock
    //> USB D+ pad (pin A1) — driven via SB_IO inside the ext module.
    outgoing usb_dp : Bit
    //> USB D− pad (pin A2) — driven via SB_IO inside the ext module.
    outgoing usb_dn : Bit
    //> USB D+ pull-up enable (pin A4); low = disconnected from host.
    outgoing usb_dp_pu : Bit
    //> USB activity from the controller (active high, stretched ~175
    //> ms past the last byte): rxing = the USB is receiving data,
    //> txing = it is sending data.  The platform wrapper maps these
    //> onto the active-low LED pads.
    outgoing rxing : Bit
    outgoing txing : Bit
    //> Byte-stream interface of the USB core (plan §2).  The Virdant
    //> echo server consumes this stream; rx_valid is a 1-clk strobe
    //> per byte, rx_ready is the consumer's flow control.
    outgoing rx_data : Word[8]
    outgoing rx_valid : Bit
    outgoing tx_ready : Bit
    incoming tx_data : Word[8]
    incoming tx_strobe : Bit
    incoming rx_ready : Bit
}
