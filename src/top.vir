import ice40

export mod Top for ice40::Fomu {
    incoming clock : Clock
    outgoing usb_dp : Bit
    outgoing usb_dn : Bit
    // D+ pull-up enable: MUST be wired through — the platform default is
    // low (= disconnected), so a wrapper that leaves it unwired produces
    // an image no host can ever see (the P0 found when the first upload
    // build tied it to 1'b0).
    outgoing usb_dp_pu : Bit
    // heartbeat LEDs (active low on PVT), driven by the ext core
    outgoing led_red   : Bit
    outgoing led_green : Bit
    outgoing led_blue  : Bit

    mod actual_top of FomuTop {
        it.clock := clock
        usb_dp := it.usb_dp
        usb_dn := it.usb_dn
        usb_dp_pu := it.usb_dp_pu
        led_red := it.led_red
        led_green := it.led_green
        led_blue := it.led_blue
    }
}

// Fomu UART-over-USB PoC — top declaration.
//
// The real Fomu top is pending platform support for bidirectional
// (tristate) pins — see FOMU_UART_OVER_USB_PLANv2.md §5/§9.  Until then the
// top is the Verilog ext mod `ext/fomu_top.sv` (`module Top`) and this
// declaration is the port *contract* for it.  Port names match the Fomu
// platform pin names so the future real Top keeps the same PCF lines.
//
// Contract drift note: Virdant cannot yet express a bidirectional pad, so
// `usb_dp`/`usb_dn` are declared `outgoing` here while the Verilog Top
// declares them `inout` (the SB_IO PACKAGE_PIN).  When platform tristate
// support lands, this declaration is replaced by the real
// `export mod Top for ice40::Fomu` and the Verilog Top dies (plan §9).
ext mod FomuTop {
    //> 48 MHz board clock (pin F4).
    incoming clock : Clock
    //> USB D+ pad (pin A1) — driven via SB_IO inside the ext module.
    outgoing usb_dp : Bit
    //> USB D− pad (pin A2) — driven via SB_IO inside the ext module.
    outgoing usb_dn : Bit
    //> USB D+ pull-up enable (pin A4); low = disconnected from host.
    outgoing usb_dp_pu : Bit
    //> Heartbeat (active-low on PVT).
    outgoing led_red : Bit
    outgoing led_green : Bit
    outgoing led_blue : Bit
}

// export mod Top for ice40::Fomu { ... }   // pending platform tristate
//                                          // support; see plan §5/§9
