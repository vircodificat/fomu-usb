import ice40
import echo
import usb

export mod Top for ice40::Fomu {
    incoming clock : Clock

    outgoing usb_dp : Bit
    outgoing usb_dn : Bit

    //> D+ pull-up enable
    //> low = device is disconnected
    //> Driven by the POR: attach only after the ~175 ms power-on count
    outgoing usb_dp_pu : Bit {
        it := por.done
    }

    outgoing led_red   : Bit
    outgoing led_green : Bit
    outgoing led_blue  : Bit

    // Power-on reset
    mod por of usb::PowerOnReset {
        it.clock := clock
    }

    //> Drop down into Verilog to split USB D+ and D-
    //> into two unidirectional pairs (via a UsbTxRx socket).
    //> This is needed until Virdant supports buses.
    mod pads of usb::UsbPads {
        usb_dp := it.usb_dp
        usb_dn := it.usb_dn

        it.usb :=: usb_controller.usb
    }

    // The USB controller: everything between the byte stream and the
    // pads, in Virdant (src/usb.vir).  Its pad-facing side is
    // unidirectional wires (dp_rx/dn_rx in; dp_tx/dn_tx/output_enable
    // out) -- the only bidirectional nets in the design live inside
    // the UsbPads ext mod below.
    mod usb_controller of usb::UsbController {
        it.clock := clock
        it.por_done := true

        // The LEDs to indicate the USB activity
        led_red   := !it.rxing
        led_green := !it.txing
        led_blue  := true
    }

    //> The echo server: the byte-level consumer of the USB core.
    //> Bytes from the host are rendered onto the raw UART tx line;
    //> bytes read from the raw rx line go back to the host.
    mod echo of echo::EchoServer {
        it.clock := clock
        it.rxd   := uart_rx_reg

        uart_rx_reg <= it.txd

        it.usb_rx         :=: usb_controller.rx
        usb_controller.tx :=: it.usb_tx
    }

    // used for latency relaxation
    reg uart_rx_reg : Bit on clock
}
