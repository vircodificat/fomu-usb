//> UART primitives: a 115200 8N1 transmitter and receiver for the 48 MHz
//> clock.  EchoServer (src/echo.vir) instantiates both; the raw `txd`
//> and `rxd` lines are wired together at the top level (src/top.vir),
//> so everything a receiver byte sees came from this same sender.
//>
//> Bit period: 48_000_000 / 115200 = 416.67, rounded up to 417 clock
//> cycles per bit -> 115107 baud, a -0.08% error, far inside the ~2%
//> tolerance UART allows.  Start, each data bit and stop are each timed
//> by their own 417-cycle phase, so the error does not accumulate
//> within a frame.
//>
//> Frame: idle high, start low, 8 data bits LSB first, stop high.
//> Both modules share the UartFsmState enum below (Idle/Start/Data/Stop).
//>
//> Receiver resynchronization: the falling start-bit edge is detected
//> on the first clock edge where the line reads low; the line is then
//> re-checked 209 cycles later (half of a 417-cycle bit, i.e. the
//> middle of the start bit), and each following bit is sampled 417
//> cycles after the previous sample -- every bit is sampled at its
//> center.  `uart_rx` is sampled directly with no synchronizer
//> flip-flops; that is exact on the same-clock loopback wire but means
//> an externally driven `rxd` would be unsynchronized.
//>
//> # UartSender
//>
//> - `clock`      : 48 MHz clock
//> - `data`       : byte to transmit; must be valid on the `data_valid`
//>                  cycle (echo.vir wires it to the FIFO head, which is
//>                  stable then)
//> - `data_valid` : 1-clk strobe.  Only sampled while `ready` is high:
//>                  at that clock edge `data` is latched into the shift
//>                  buffer and the frame begins (the start bit is driven
//>                  the next cycle).  Strobes while busy are ignored;
//>                  there is no input buffering.
//> - `ready`      : high exactly while the sender is idle, so a new
//>                  byte can be loaded on any such cycle.  It rises
//>                  again on the first cycle after the stop bit, so
//>                  frames can be sent back to back.
//> - `tx`         : the serial line (the raw tx wire)
//>
//> # UartReceiver
//>
//> - `clock`      : 48 MHz clock
//> - `uart_rx`    : the serial line (the raw rx wire)
//> - `data`       : the received byte; stable from the last data-bit
//>                  sample through the `data_valid` pulse (and until
//>                  the next frame's samples begin)
//> - `data_valid` : 1-clk pulse at the center of the stop bit, when the
//>                  byte is complete; the consumer (the hold register
//>                  in src/echo.vir) registers `data` on that same
//>                  edge.  The stop bit's level is not checked -- the
//>                  Stop phase is a plain 417-cycle wait.

//> FSM states shared by UartSender and UartReceiver.
enum type UartFsmState {
    Idle  = 0b00w2
    Start = 0b01
    Data  = 0b10
    Stop  = 0b11
}

mod UartSender {
    //> 48 MHz clock; one bit = 417 cycles (see the file comment).
    incoming clock      : Clock
    incoming data       : Word[8]
    incoming data_valid : Bit
    wire sender_idle : Bit {
        it := state == #Idle
    }
    outgoing ready      : Bit {
        it := sender_idle
    }
    outgoing tx         : Bit {
        it := match state {
            case #Idle  => true
            case #Start => false
            case #Data  => data_buf[dyn bit_idx]
            case #Stop  => true
        }
    }

    // Within a bit phase the counter counts 0..416 (417 cycles);
    // bit_time_done fires on the 417th cycle, and the counter reloads
    // to 0 on that same edge (and is held at 0 in Idle), so the start
    // bit, every data bit and the stop bit are each exactly 417 cycles.
    wire bit_time_done : Bit {
        it := baud_counter == 416w10
    }

    reg state : UartFsmState on clock {
        initial it <= #Idle
    }

    reg baud_counter : Word[10] on clock {
        initial it <= 0w10
        it <= when {
            case state == #Idle => 0w10
            case bit_time_done  => 0w10
            else                => it + 1w10
        }
    }

    reg bit_idx : Word[3] on clock {
        initial it <= 0w3
    }

    reg data_buf : Word[8] on clock {
        initial it <= 0w8
        it <= when {
            case data_valid && sender_idle => data
            else                     => it
        }
    }

    // Load + start: on a strobe while idle, latch `data` and move to
    // Start (tx drops to the start bit on the next cycle).
    when {
        case data_valid && sender_idle match state {
            case #Idle {
                state <= #Start
            }
        }
        case bit_time_done match state {
            case #Start {
                bit_idx <= 0w3
                state   <= #Data
            }
            case #Data {
                bit_idx <= bit_idx + 1w3
                when {
                    case bit_idx == 7w3 {
                        state <= #Stop
                    }
                }
            }
            case #Stop {
                state <= #Idle
            }
        }
    }
}

mod UartReceiver {
    incoming clock      : Clock
    incoming uart_rx    : Bit
    // At the end of each 417-cycle Data phase (each bit's center)
    // uart_rx is shifted in at the MSB side: word() places its first
    // argument in the MSBs, so the first bit on the wire (the LSB,
    // UART sends LSB first) keeps shifting right and after eight
    // captures the byte sits with its LSB in data[0].  The byte then
    // holds through the Stop phase, which is when data_valid pulses.
    outgoing reg data : Word[8] on clock {
        initial it <= 0w8
        it <= when {
            case state == #Data && bit_time_done => word(uart_rx, it[8..1])
            else                                 => it
        }
    }
    // 1-clk pulse during the final cycle of the Stop phase (roughly the
    // stop bit's center); `data` has been stable since the last
    // data-bit sample.
    outgoing data_valid : Bit {
        it := state == #Stop && bit_time_done
    }

    // The counter counts DOWN within each phase; the phase ends on the
    // cycle where it reaches 0.  In Idle the counter is held at 0, so
    // bit_time_done is constantly true there -- harmless, because it is
    // only consumed in the Start/Data/Stop arms below and in data_valid
    // (which also requires state == #Stop).
    wire bit_time_done : Bit {
        it := baud_counter == 0w10
    }

    reg state : UartFsmState on clock {
        initial it <= #Idle
        it <= when {
            else match it {
                case #Idle when {
                    case uart_rx == false => #Start
                    else                  => it
                }
                case #Start when {
                    case bit_time_done when {
                        // 209 cycles after the falling edge moved
                        // Idle->Start (half of a 417-cycle bit, the
                        // middle of the start bit), the line must still
                        // be low; a level that has bounced back high is
                        // a glitch and the frame is aborted to Idle.
                        case uart_rx == false => #Data
                        else                  => #Idle
                    }
                    else => it
                }
                case #Data when {
                    case bit_time_done && bit_idx == 7w3 => #Stop
                    else                                 => it
                }
                case #Stop when {
                    case bit_time_done => #Idle
                    else               => it
                }
            }
        }
    }

    // Countdown per phase.  Idle holds 0 and watches the line; on the
    // cycle where the line first reads low (the falling-edge detect)
    // the counter loads 208, so the Start phase runs 209 cycles (208
    // down to 0) -- half a bit.  When Start or Data ends the counter
    // reloads 416, making each Data phase 417 cycles (one full bit);
    // Stop also runs 417 cycles and then reloads 0 for Idle.  After a
    // glitch abort the counter briefly sits at 416 in Idle, but Idle
    // overwrites it (0, or 208 on a new falling edge) the next cycle.
    // All periods assume uart_rx is in the same clock domain as clock
    // -- true on the top-level loopback wire in src/top.vir; there is
    // no resynchronization for an external source.
    reg baud_counter : Word[10] on clock {
        initial it <= 0w10
        it <= when {
            else match state {
                case #Idle when {
                    case uart_rx == false => 208w10
                    else                  => 0w10
                }
                case #Start when {
                    case bit_time_done => 416w10
                    else               => it - 1w10
                }
                case #Data when {
                    case bit_time_done => 416w10
                    else               => it - 1w10
                }
                case #Stop when {
                    case bit_time_done => 0w10
                    else               => it - 1w10
                }
            }
        }
    }

    reg bit_idx : Word[3] on clock {
        initial it <= 0w3
        it <= when {
            case state == #Start && bit_time_done => 0w3
            case state == #Data && bit_time_done   => it + 1w3
            else                                   => it
        }
    }

}
