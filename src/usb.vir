//> The USB controller, in Virdant.
//>
//> This is the "rest of the USB controller" half of the Virdant/Verilog
//> split (see wiki/top-vir.md and HANDOFF.md): everything between the
//> byte stream and the pads except the two things Virdant cannot
//> express -- the bidirectional USB pads (UsbPads, ext) and the
//> parameterized power-on reset (UsbPor, ext; the TB overrides
//> POR_CYCLES, which only a hand-written Verilog body can offer).
//>
//> Topology (wired by export mod Top in src/top.vir):
//>
//>     UsbPor (ext, ~175 ms) --por_done--> UsbController --byte stream--> echo
//>     UsbController --dp_tx/dn_tx/output_enable--> UsbPads (ext, SB_IO)
//>     UsbPads --dp_rx/dn_rx--> UsbController
//>
//> The pad-facing side is deliberately UNIDIRECTIONAL: the only
//> bidirectional nets in the whole design live inside UsbPads.

//> The two USB D+/D- tristate pad cells (iCE40 SB_IO, PIN_TYPE
//> 6'b101001) -- the one ext mod that touches a bidirectional net.
//> Body in ext/usb_pads.sv.  From Virdant's point of view every wire
//> here is unidirectional: we drive the pad via dp_tx/dn_tx gated by
//> output_enable, and sample it back via dp_rx/dn_rx; the electrical
//> bidirectionality never crosses this boundary (the ext body's
//> `inout` port declarations are the Verilog-side plumbing that gets
//> the SB_IO PACKAGE_PIN nets out to the Top ports / PCF pins).
ext mod UsbPads {
    //> USB D+ pad side, out to the Top port (PCF pin A1); electrically
    //> bidirectional, driven by the SB_IO cell inside the ext body.
    outgoing usb_dp : Bit
    //> USB D- pad side, out to the Top port (PCF pin A2); ditto.
    outgoing usb_dn : Bit
    //> D+ drive level into the pads (SB_IO D_OUT_0).
    incoming dp_tx         : Bit
    //> D- drive level into the pads (SB_IO D_OUT_0).
    incoming dn_tx         : Bit
    //> Tristate control: drive the bus while high; low = listen (the
    //> pads float to the idle J state held by the host and the D+
    //> 1.5k pull-up).
    incoming output_enable : Bit
    //> D+ sample out of the pads (SB_IO D_IN_0).
    outgoing dp_rx : Bit
    //> D- sample out of the pads (SB_IO D_IN_0).
    outgoing dn_rx : Bit
}

//> Power-on reset: counts to POR_CYCLES at 48 MHz, then releases
//> `por_done`.  The default (~8.4M cycles = ~175 ms) is how long the
//> device waits before releasing the D+ pull-up and attaching to the
//> host; testbenches override it to a few hundred cycles.  The
//> parameter lives in the hand-written Verilog body
//> (ext/usb_por.sv) so the sim TB can override it at instantiation --
//> a plain Virdant `mod` would bake the count into generated code the
//> TB cannot reach.
//>
//> NB: Virdant's `@parameter` annotation mechanism (declared on an ext
//> mod def, overridden at the instantiation) was tried here and DOES
//> elaborate -- but its Verilog emission is currently broken: a
//> trailing comma after the last `#(.NAME(value))` entry whenever the
//> ext mod has ports, which iverilog rejects (yosys tolerates it).
//> Left unused until upstream fixes the emitter; the body's Verilog
//> `parameter` is the parameterization that matters for the TB.
ext mod UsbPor {
    //> 48 MHz board clock.
    incoming clock  : Clock
    //> High once the POR_CYCLES count completes: gates the D+ pull-up
    //> (attach) at the top and, registered once more in UsbController,
    //> the core reset.
    outgoing por_done : Bit
}

//> The USB Full-Speed CDC-ACM device core, vendored Verilog
//> (ext/usb_uart.sv, module inventory in its file header).  This is
//> the migration boundary: the core stays an ext mod today and its
//> internals (usb_crc5/16, usb_fifo16x8, usb_rx_phy, usb_rx_packet,
//> usb_tx_phy, usb_ep0, usb_serial) move into .vir one at a time, all
//> with unidirectional interfaces.
ext mod UsbUart {
    //> 48 MHz clock: 4 clk cycles per USB FS bit.
    incoming clk : Clock
    //> Synchronous reset, active high.  Fed by the registered por_done
    //> (one clk behind UsbPor's release) -- see the por_rst doccomment
    //> in UsbController below for why the extra register stage is
    //> load-bearing.
    incoming rst : Bit
    //> D+ pad sample in (from UsbPads).
    incoming dp_rx         : Bit
    //> D- pad sample in (from UsbPads).
    incoming dn_rx         : Bit
    //> D+ drive level out (to UsbPads).
    outgoing dp_tx         : Bit
    //> D- drive level out (to UsbPads).
    outgoing dn_tx         : Bit
    //> Pad drive enable: drive the bus while high (SB_IO
    //> OUTPUT_ENABLE via UsbPads).
    outgoing output_enable : Bit
    //> Byte from the host; valid for one cycle with rx_valid.
    outgoing rx_data   : Word[8]
    //> 1-clk strobe per received byte (= the rx FIFO pop).
    outgoing rx_valid  : Bit
    //> The tx FIFO has room for another byte.
    outgoing tx_ready  : Bit
    //> Byte toward the host.
    incoming tx_data   : Word[8]
    //> 1-clk push strobe for tx_data.
    incoming tx_strobe : Bit
    //> Flow control back: low = the rx consumer is full, stop popping
    //> (the core NAKs bulk-OUT packets instead).
    incoming rx_ready  : Bit
    //> The core is receiving data (host -> device); stretched ~175 ms
    //> past the last byte so it is LED-visible (drives led_red).
    outgoing rxing : Bit
    //> The core is sending data (device -> host); stretched ~175 ms
    //> past the last byte (drives led_green).
    outgoing txing : Bit
}

//> Serial CRC LFSRs (USB 2.0 §8.3.5), migrated out of ext/usb_uart.sv.
//> Both advance one serial WIRE bit per clk when `adv` is high (wire
//> order = LSB first); the checker convention feeds the received wire
//> CRC bits too and compares the residual (token CRC5: 5'h0C, data
//> CRC16: 16'h800D).  Known-answer vectors live in tb/tb_crc.v,
//> cross-checked against valentyusb.
//>
//> Wire-bit convention (ext/usb_uart.sv header): TX emits
//> crc_wire[i] = ~crc[W-1-i] (complement + bit reverse).

//> CRC5, poly x^5+x^2+1, seed 0x1F -- token CRC (addr+endp).
mod Crc5 {
    //> 48 MHz clock.
    incoming clk : Clock
    //> Synchronous reset: re-seed the LFSR to 0x1F.
    incoming rst : Bit
    //> Advance one serial wire bit on this clk edge.
    incoming adv : Bit
    //> Serial input bit, wire order (LSB first).
    incoming din : Bit
    //> Current LFSR state: the generator output, or the checker
    //> residual (0x0C after a good token stream incl. its CRC bits).
    outgoing crc : Word[5] {
        it := r
    }

    //> feedback: new bit = din ^ tap
    wire inv : Bit {
        it := din ^ r[4]
    }

    //> The 5-bit shift register.  Next state = {r[3:0], inv} with the
    //> x^2 tap XORed into bit 2; seeds to 0x1F.
    reg r : Word[5] on clk {
        initial it <= 31w5
        it <= when {
            case rst => 31w5
            case adv => word(it[4..0], inv) ^ word(0w2, inv, 0w2)
            else     => it
        }
    }
}

//> CRC16, poly x^16+x^15+x^2+1, seed 0xFFFF -- data-payload CRC.
mod Crc16 {
    //> 48 MHz clock.
    incoming clk : Clock
    //> Synchronous reset: re-seed the LFSR to 0xFFFF.
    incoming rst : Bit
    //> Advance one serial wire bit on this clk edge.
    incoming adv : Bit
    //> Serial input bit, wire order (LSB first).
    incoming din : Bit
    //> Current LFSR state: the generator output (wire bytes are the
    //> complement + bit-reverse, low byte first), or the checker
    //> residual (0x800D after a good payload incl. its CRC bits).
    outgoing crc : Word[16] {
        it := r
    }

    //> feedback: new bit = din ^ tap
    wire inv : Bit {
        it := din ^ r[15]
    }

    //> The 16-bit shift register.  Next state = {r[14:0], inv} with
    //> the x^15 tap XORed into bit 15 and the x^2 tap into bit 2;
    //> seeds to 0xFFFF.
    reg r : Word[16] on clk {
        initial it <= 65535w16
        it <= when {
            case rst => 65535w16
            case adv => word(it[15..0], inv) ^ word(inv, 0w12, inv, 0w2)
            else     => it
        }
    }
}

//> usb_rx_phy -- pads to decoded bits (USB 2.0 §7.1.x), migrated out
//> of ext/usb_uart.sv.  Single 48 MHz domain, 4 clks per FS bit, no
//> DLL/PLL/CDC.  Turn the raw D+/D- pad samples into an NRZI-decoded,
//> bit-unstuffed serial bit stream plus the packet-boundary signals
//> the rest of the core consumes (all one-clk strobes):
//>
//>   sop   J->K seen from idle (start of packet)
//>   eop   SE0 held ~1.75 bit times (end of packet)
//>   active  inside a packet (sop..eop)
//>   pkt_err sticky per-packet error (SE1 seen, or 6 ones then a 1;
//>           cleared at the next sop)
//>   bus_reset SE0 held >= 2.5 us (120 clks)
//>
//> Cycle-exact translation of the original always block: every reg's
//> next-state below is the same priority chain the Verilog if/else-if
//> tree encoded.  The bit-sampling details (phase-1 capture, re-align
//> on every transition, 7-clk EOP arming) are load-bearing -- see the
//> original comments preserved on each reg and wiki/usb-rx-phy.md.
mod RxPhy {
    //> 48 MHz clock: 4 clk cycles per USB FS bit.
    incoming clk : Clock
    //> Synchronous reset (core reset from UsbController).  Deliberately
    //> NOT asserted on bus reset: the bus-reset detector lives here.
    incoming rst : Bit
    //> Raw D+ pad sample (SB_IO D_IN_0 via UsbPads); asynchronous to
    //> clk -- see the synchronizer note below.
    incoming dp  : Bit
    //> Raw D- pad sample (SB_IO D_IN_0 via UsbPads); asynchronous to
    //> clk, ditto.
    incoming dn  : Bit

    //> Decoded (NRZI-decoded, bit-unstuffed) data bit.
    outgoing bit_o     : Bit {
        it := bit_r
    }
    //> 1-clk strobe: bit_o is good this cycle.
    outgoing bit_valid : Bit {
        it := bit_v_r
    }
    //> 1-clk pulse: J->K seen from idle (start of packet).
    outgoing sop       : Bit {
        it := sop_r
    }
    //> 1-clk pulse: SE0 held ~1.75 bit times (end of packet).
    outgoing eop       : Bit {
        it := eop_r
    }
    //> Inside a packet (from sop until eop).
    outgoing active    : Bit {
        it := act
    }
    //> Sticky per-packet error: SE1 seen, or 6 ones then a 1; cleared
    //> at the next sop.
    outgoing pkt_err   : Bit {
        it := perr
    }
    //> 1-clk pulse: SE0 held >= 2.5 us (host-issued bus reset).
    outgoing bus_reset : Bit {
        it := br_r
    }

    // ---- synchronizers, edge history, decode cones --------------------

    //> The pads are asynchronous to the 48 MHz clock (the host's rate
    //> is only specified to ±0.25%, which is why the bit recovery
    //> below re-aligns on every transition), so both lines go through
    //> a canonical two-flop synchronizer (builtin::Sync) before
    //> anything looks at them.
    //>
    //> NB, a deliberate behavior change vs the hand-rolled reset-held
    //> synchronizers this replaces: Sync has no reset, so the pads are
    //> tracked from cycle 0.  With no host attached (pull-up off) the
    //> pads can read SE0-ish, so se0_cnt free-runs during the ~175 ms
    //> POR and bus_reset may pulse pre-attach -- into a core that is
    //> still held in core_rst, so it is unobservable downstream.
    mod sync_dp of Sync {
        it.inp   := dp
        it.clock := clk
    }
    mod sync_dn of Sync {
        it.inp   := dn
        it.clock := clk
    }
    wire sdp : Bit {
        it := sync_dp.out
    }
    wire sdn : Bit {
        it := sync_dn.out
    }
    //> Previous-cycle synchronized D+ sample; with dn_p it forms the
    //> transition detect (`trans`).
    reg dp_p : Bit on clk {
        initial it <= false
        it <= when {
            case rst => false
            else     => sdp
        }
    }
    //> Previous-cycle synchronized D- sample; the other half of
    //> `trans`.
    reg dn_p : Bit on clk {
        initial it <= false
        it <= when {
            case rst => false
            else     => sdn
        }
    }

    wire trans : Bit {
        it := (sdp != dp_p) || (sdn != dn_p)
    }
    // bus states: SE0 (both low), SE1 (illegal), K (the sync edge polarity)
    wire se0 : Bit {
        it := !sdp && !sdn
    }
    wire se1 : Bit {
        it := sdp && sdn
    }
    wire k : Bit {
        it := !sdp && sdn
    }
    // NRZI decode of the mid-bit sample: a bit is a 1 when the line
    // level did not change since the previous sample.
    wire bit_val : Bit {
        it := (sdp == lev_d) && (sdn == lev_n)
    }

    // next-state helper cones (mutually exclusive where priority
    // matters; rst always wins as the first case of every reg)
    wire sop_edge : Bit {
        it := !act && k
    }
    wire abort : Bit {
        it := act && se1
    }
    wire eop_now : Bit {
        it := act && se0 && (se0_cnt == 6w7)
    }
    // inside a packet at a J/K level (not SE0/SE1)
    wire jk : Bit {
        it := act && !se1 && !se0
    }
    // the mid-bit sample point: phase 1 captures sdp 2-3 clks after the
    // switch reaches sdp -- inside the bit's visibility window for EVERY
    // achievable quantized window width (3, 4 or 5 clks).  The re-align
    // at every transition (ph reset, below) makes the counter read 0 one
    // clk after the transition, so one sample lands per bit window for
    // run windows of any length (4n-1/4n/4n+1 clks all yield n captures).
    wire sample : Bit {
        it := jk && (ph == 1w2)
    }

    //> Previous bit sample on D+ (NRZI decode reference).  Reset/idle
    //> value = J (D+ high).
    reg lev_d : Bit on clk {
        initial it <= true
        it <= when {
            case rst    => true
            case sample => sdp
            else        => it
        }
    }
    //> Previous bit sample on D- (NRZI decode reference).  Reset/idle
    //> value = J (D- low).
    reg lev_n : Bit on clk {
        initial it <= false
        it <= when {
            case rst    => false
            case sample => sdn
            else        => it
        }
    }

    //> Bit-phase counter (0..3 clks into the current bit).  Clock
    //> recovery: re-aligned to 0 on every line transition; phase 1 is
    //> the mid-bit sample (see the `sample` wire).
    reg ph : Word[2] on clk {
        initial it <= 0w2
        it <= when {
            case rst       => 0w2
            case sop_edge  => 0w2
            case jk        => mux(trans, 0w2, it + 1w2)
            else           => it
        }
    }

    //> In-packet flag: armed at the sop edge, dropped with the eop
    //> pulse or on an SE1 (illegal bus state).
    reg act : Bit on clk {
        initial it <= false
        it <= when {
            case rst      => false
            case sop_edge => true
            case abort    => false
            case eop_now  => false
            else          => it
        }
    }

    //> Sticky per-packet error: set on SE1 (illegal bus state) or a
    //> stuffing violation (6 ones then a 1); cleared at the next sop.
    reg perr : Bit on clk {
        initial it <= false
        it <= when {
            case rst                        => false
            case sop_edge                   => false
            case abort                      => true
            case sample && drop_state && bit_val => true
            else                            => it
        }
    }

    //> Consecutive-ones counter for bit destuffing: the 6th
    //> consecutive decoded 1 arms drop_state, so the next (stuffed 0)
    //> bit is dropped.  3 bits, wraps (harmless: the drop resets it).
    reg stuff_cnt : Word[3] on clk {
        initial it <= 0w3
        it <= when {
            case rst   => 0w3
            case !act  => 0w3
            case sample => mux(drop_state, 0w3, mux(bit_val, it + 1w3, 0w3))
            else       => it
        }
    }

    //> Armed after 6 consecutive ones: the next decoded bit is the
    //> stuffed 0 and is dropped (bit_valid suppressed); a 1 in that
    //> slot is a stuffing violation (perr).
    reg drop_state : Bit on clk {
        initial it <= false
        it <= when {
            case rst                                    => false
            case !act                                   => false
            case sample && it                           => false
            case sample && bit_val && (stuff_cnt == 5w3) => true
            else                                        => it
        }
    }

    //> Standalone SE0 timer: the EOP threshold is checked off
    //> `eop_now` (~1.75 bit times = 7 clks); 119 clks = 2.5 us = bus
    //> reset.  The 7-bit counter wraps, so sustained reset SE0
    //> re-pulses every 128 clks (the ep0 FSM treats each pulse
    //> identically).
    reg se0_cnt : Word[7] on clk {
        initial it <= 0w7
        it <= when {
            case rst => 0w7
            case se0 => it + 1w7
            else     => 0w7
        }
    }

    // Single-cycle output strobes: default low, pulsed by their event.
    //> 1-clk sop strobe (J->K seen while idle).
    reg sop_r : Bit on clk {
        initial it <= false
        it <= when {
            case rst      => false
            case sop_edge => true
            else          => false
        }
    }
    //> 1-clk eop strobe (SE0 held ~1.75 bit times while in-packet).
    reg eop_r : Bit on clk {
        initial it <= false
        it <= when {
            case rst     => false
            case eop_now => true
            else         => false
        }
    }
    //> 1-clk strobe: a decoded, unstuffed bit is on bit_r this cycle
    //> (suppressed for the dropped stuff bit).
    reg bit_v_r : Bit on clk {
        initial it <= false
        it <= when {
            case rst                    => false
            case sample && !drop_state  => true
            else                        => false
        }
    }
    //> Decoded NRZI bit value, captured at every mid-bit sample
    //> (including the dropped one -- its value is what the perr
    //> violation check reads).
    reg bit_r : Bit on clk {
        initial it <= false
        it <= when {
            case rst    => false
            case sample => bit_val
            else        => it
        }
    }
    //> 1-clk bus_reset strobe (SE0 held >= 2.5 us; see se0_cnt).
    reg br_r : Bit on clk {
        initial it <= false
        it <= when {
            case rst              => false
            case se0_cnt == 119w7 => true
            else                  => false
        }
    }
}

//> usb_tx_phy -- packet records back to pads (USB 2.0 §7.1.x), the
//> mirror of usb::RxPhy, migrated out of ext/usb_uart.sv.  Drives a
//> complete FS packet: sync pattern, NRZI-encoded bit-stuffed data,
//> and EOP, plus the output enable that connects the driver to the
//> pads only while transmitting.
//>
//> Cycle-exact translation of the original always block (same
//> discipline as usb::RxPhy): every reg's next-state below is the
//> same priority chain the Verilog case/if tree encoded, including
//> the registered one-clk-ahead decision flags (s_lt_end_r,
//> guard_last_r, bit_end_r, crc_load_r) that keep the big compare
//> cones off the single-cycle engine path.  Timeline conventions
//> (load-bearing -- see wiki/usb-tx-phy.md and the original comments
//> preserved on each reg):
//>
//>   - the level DURING bit time T encodes raw bit f(S_T - 1); the
//>     transition for a 0 bit appears at that bit time's start;
//>   - s is the raw bit index of the NEXT bit time (it advances at
//>     bit-time boundaries, i.e. it names the bit whose encoding
//>     follows); stuffed bit times do not advance it;
//>   - the CRC16 instance consumes each payload raw bit exactly once,
//>     at btc==2 of the bit time whose encoding drives that bit
//>     (stuffed bit times are gated off via cur_stuff).
enum type TxPhyState {
    Idle  = 0b000w3
    Guard = 0b001
    Data  = 0b010
    Eop0  = 0b011
    EopJ  = 0b100
}

mod TxPhy {
    //> 48 MHz clock: 4 clk cycles per USB FS bit.
    incoming clk : Clock
    //> Synchronous reset (core reset from UsbController).
    incoming rst : Bit
    //> 1-clk pulse: latch tx_pid/tx_len and begin the packet.
    incoming tx_start : Bit
    //> PID nibble (the upper complement is generated here).
    incoming tx_pid : Word[4]
    //> Payload byte count, 0..64 (0 => zero-length packet).
    incoming tx_len : Word[7]
    //> Producer payload byte, combinational at tx_addr.  The engine is
    //> a one-bit-time lookahead: tx_addr leads the consumed bit by one
    //> bit time, and tx_byte_r (below) re-times it into the engine.
    incoming tx_byte : Word[8]

    //> s - 16: the payload bit index (only meaningful for payload
    //> raw bits; a named wire because the Verilog emitter cannot
    //> part-select a parenthesized expression).
    wire s_m16 : Word[10] {
        it := s - 16w10
    }
    //> s - 9: the preload-hint raw index (see tx_addr_next).
    wire s_m9 : Word[10] {
        it := s - 9w10
    }
    //> Byte index currently being consumed (a pure bit-slice of s, no
    //> state term; only meaningful while payload bits are read).
    outgoing tx_addr : Word[7] {
        it := s_m16[10..3]
    }
    //> Byte index the NEXT bit time will consume (preload hint):
    //> (s-9)>>3 is byte-stable across every bit time of a byte, so a
    //> registered copy can address the source one byte ahead without
    //> flipping mid-byte.
    outgoing tx_addr_next : Word[7] {
        it := s_m9[10..3]
    }
    //> A packet is in flight (any state but Idle).
    outgoing tx_busy : Bit {
        it := state != #Idle
    }
    //> 1-clk pulse when the bus is released (end of EOP).
    outgoing tx_done : Bit {
        it := done_r
    }
    //> D+ drive level (meaningful only while output_enable is high;
    //> the Eop0 state drives both lines low = SE0 regardless of lvl).
    outgoing dp : Bit {
        it := mux(state == #Eop0, false, mux(lvl, false, true))
    }
    //> D- drive level (ditto).
    outgoing dn : Bit {
        it := mux(state == #Eop0, false, lvl)
    }
    //> Output enable: drive the pads (SB_IO OUTPUT_ENABLE via UsbPads).
    outgoing output_enable : Bit {
        it := oe_r
    }

    //> The tx_start pulse, decoded against the FSM (used by every
    //> packet-geometry register).
    wire arm : Bit {
        it := (state == #Idle) && tx_start
    }
    //> The guard-to-data transition edge (the registered guard_last_r
    //> flag decoded against the FSM).
    wire guard_last : Bit {
        it := (state == #Guard) && guard_last_r
    }

    //> The armed PID is a data packet (PID[1:0] == 11): it carries a
    //> payload + CRC16.  Handshake/token PIDs skip both.
    wire is_data : Bit {
        it := pid_r[2..0] == 0b11w2
    }
    //> Same test on the tx_start INPUT (not pid_r): total_bits_r is
    //> computed at the arm edge, one cycle before pid_r is loaded.
    wire tx_pid_data : Bit {
        it := tx_pid[2..0] == 0b11w2
    }
    //> s mod 8: the bit index within the current byte.  For the PID
    //> nibble selector (s in 8..15) and the payload bit selector
    //> ((s-16) & 7 == s mod 8, so one index serves both).
    wire byte_bit_idx : Word[3] {
        it := s[3..0]
    }
    //> The complemented-nibble selector: byte_bit_idx - 4 (0..3 when
    //> byte_bit_idx is 4..7).  A named wire because the Verilog
    //> emitter cannot part-select a parenthesized expression.
    wire pid_comp_idx : Word[3] {
        it := byte_bit_idx - 4w3
    }
    //> raw bit f(s): sync (00000001, bit 7 is the trailing 1), PID
    //> byte ({~pid[3:0], pid[3:0]}, LSB first), payload (LSB first),
    //> CRC16 wire bits shifted MSB-first out of crc_shift.  Evaluated
    //> against the REGISTERED s (stable for the whole 4-clk bit time)
    //> and pipelined into raw_bit_r, which splits the compare/select
    //> chain from the single-cycle engine path.
    wire raw_bit : Bit {
        it := mux(s < 8w10, s == 7w10,
            mux(s < 16w10,
                mux(byte_bit_idx < 4w3,
                    pid_r[dyn byte_bit_idx[2..0]],
                    !pid_r[dyn pid_comp_idx[2..0]]),
                mux(is_data && (s < payload_end_r),
                    tx_byte_r[dyn byte_bit_idx],
                    mux(is_data,
                        crc_shift[15],
                        false))))
    }
    //> The CRC16 wire bits, complemented (wire convention:
    //> crc_wire[i] = ~crc[W-1-i]; the bit-reverse is the MSB-first
    //> shift-out of crc_shift).
    wire crc_wire : Word[16] {
        it := crc16.crc ^ 65535w16
    }

    // ---- decision flags, registered one clk ahead --------------------

    //> (s < total_bits_r) REGISTERED one cycle ahead: the 10-bit
    //> compare is a carry chain, and it fed cur_stuff's D-cone every
    //> bit time (the tx-engine critical path).  s changes only at
    //> bit-time edges, so the flag captured the previous cycle is
    //> exact at the decision edge -- +0 clk latency, the compare cone
    //> ends at its own register.
    reg s_lt_end_r : Bit on clk {
        initial it <= false
        it <= when {
            case rst => false
            else     => s < total_bits_r
        }
    }
    //> Final S_GUARD cycle (gcnt == 6), REGISTERED one clk ahead: the
    //> bit-time phase decisions read a 1-bit register instead of a
    //> compare cone (the raw compares chained through 4 enable LUTs
    //> into s's clock enable -- the old vir-flow critical path).
    reg guard_last_r : Bit on clk {
        initial it <= false
        it <= when {
            case rst => false
            else     => (state == #Guard) && (gcnt == 6w3)
        }
    }
    //> Last clk of a bit time (Data/Eop0/EopJ), REGISTERED one clk
    //> ahead from btc == 2 -- same de-coning as guard_last_r.
    reg bit_end_r : Bit on clk {
        initial it <= false
        it <= when {
            case rst => false
            else => ((state == #Data) || (state == #Eop0)
                || (state == #EopJ)) && (btc == 2w2)
        }
    }
    //> 1 while s holds the last payload raw bit's index
    //> (payload_end_r - 1): arms the crc_shift load one cycle later,
    //> at the edge that consumes the last payload raw bit (the LFSR
    //> is final there: its advance fired at that bit time's btc==2).
    //> Stays 1 through a following stuffed bit time (s does not
    //> advance); the re-load is harmless -- the LFSR is static there,
    //> so the captured value is identical.
    reg crc_load_r : Bit on clk {
        initial it <= false
        it <= when {
            case rst => false
            else     => (state == #Data) && (s == payload_end_m1_r)
        }
    }

    // ---- packet geometry, registered at arm -------------------------

    //> Payload raw-bit end index: 16 + 8*tx_len, registered at tx_start
    //> (payload raw bits are f(16) .. f(payload_end_r - 1)).
    reg payload_end_r : Word[10] on clk {
        initial it <= 0w10
        it <= when {
            case rst => 0w10
            case arm => word(tx_len, 0w3) + 16w10
            else     => it
        }
    }
    //> payload_end_r - 1, precomputed at arm (the -1 would otherwise
    //> sit in crc_load_r's per-cycle compare).
    reg payload_end_m1_r : Word[10] on clk {
        initial it <= 0w10
        it <= when {
            case rst => 0w10
            case arm => word(tx_len, 0w3) + 15w10
            else     => it
        }
    }
    //> Total bit-time count: payload_end_r + 16 CRC wire bits for data
    //> PIDs, + 0 for everything else.  Registered at tx_start.
    reg total_bits_r : Word[10] on clk {
        initial it <= 0w10
        it <= when {
            case rst => 0w10
            case arm => word(tx_len, 0w3) + mux(tx_pid_data, 32w10, 16w10)
            else     => it
        }
    }

    // ---- the engine --------------------------------------------------

    //> FSM: Idle (bus released, waiting for tx_start) -> Guard (8 clks
    //> = 2 bit times inter-packet guard, bus still released) -> Data
    //> (the bit-time engine) -> Eop0 (SE0, 2 bit times) -> EopJ (J for
    //> the last bit time, then release) -> Idle.
    reg state : TxPhyState on clk {
        initial it <= #Idle
        it <= when {
            case rst                                => #Idle
            case (it == #Idle) && tx_start          => #Guard
            case (it == #Guard) && guard_last_r     => #Data
            case (it == #Data) && bit_end_r && !stuff_pending && !s_lt_end_r => #Eop0
            case (it == #Eop0) && bit_end_r && (ecnt == 1w3) => #EopJ
            case (it == #EopJ) && bit_end_r         => #Idle
            else                                    => it
        }
    }
    //> Clk phase within the current bit time (0..3).  Holds during
    //> Idle/Guard; zeroed at every bit-time boundary.
    reg btc : Word[2] on clk {
        initial it <= 0w2
        it <= when {
            case rst => 0w2
            case guard_last => 0w2
            case ((state == #Data) || (state == #Eop0) || (state == #EopJ)) && bit_end_r => 0w2
            case (state == #Data) || (state == #Eop0) || (state == #EopJ) => it + 1w2
            else => it
        }
    }
    //> Guard clk counter (8 clks = 2 bit times of bus release between
    //> packets).
    reg gcnt : Word[3] on clk {
        initial it <= 0w3
        it <= when {
            case rst => 0w3
            case arm => 0w3
            case (state == #Guard) && !guard_last_r => it + 1w3
            else => it
        }
    }
    //> EOP bit-time counter: Eop0 lasts 2 bit times (ecnt 0 and 1).
    reg ecnt : Word[3] on clk {
        initial it <= 0w3
        it <= when {
            case rst => 0w3
            case (state == #Data) && bit_end_r && !stuff_pending && !s_lt_end_r => 0w3
            case (state == #Eop0) && bit_end_r && (it != 1w3) => it + 1w3
            else => it
        }
    }
    //> Raw bit index of the NEXT bit time.  Starts at 1 (bit time 0's
    //> encoding -- the J->K sync transition -- is computed at the
    //> guard->data edge); advances only on raw bit times.
    reg s : Word[10] on clk {
        initial it <= 0w10
        it <= when {
            case rst => 0w10
            case guard_last => 1w10
            case (state == #Data) && bit_end_r && !stuff_pending && s_lt_end_r => it + 1w10
            else => it
        }
    }
    //> Armed PID.
    reg pid_r : Word[4] on clk {
        initial it <= 0w4
        it <= when {
            case rst => 0w4
            case arm => tx_pid
            else => it
        }
    }
    //> Armed payload byte count.
    reg len_r : Word[7] on clk {
        initial it <= 0w7
        it <= when {
            case rst => 0w7
            case arm => tx_len
            else => it
        }
    }
    //> Current drive level: 0 = J, 1 = K.  Toggled for a 0 raw bit at
    //> the edge that consumes it (NRZI: the transition appears at the
    //> next bit time's start); forced low entering EopJ.
    reg lvl : Bit on clk {
        initial it <= false
        it <= when {
            case rst => false
            case guard_last => !it
            case (state == #Data) && bit_end_r && stuff_pending => !it
            case (state == #Data) && bit_end_r && s_lt_end_r => mux(raw_bit_r, it, !it)
            case (state == #Eop0) && bit_end_r && (ecnt == 1w3) => false
            else => it
        }
    }
    //> Consecutive raw-1s run counter (stuffing).  Restarted fresh at
    //> the PID (s == 8); the 6th one arms stuff_pending and resets the
    //> count; a 0 clears it.
    reg ones : Word[3] on clk {
        initial it <= 0w3
        it <= when {
            case rst => 0w3
            case guard_last => 0w3
            case (state == #Data) && bit_end_r && stuff_pending => 0w3
            case (state == #Data) && bit_end_r && s_lt_end_r && (s == 8w10) => 0w3
            case (state == #Data) && bit_end_r && s_lt_end_r && raw_bit_r && (it == 5w3) => 0w3
            case (state == #Data) && bit_end_r && s_lt_end_r && raw_bit_r => it + 1w3
            case (state == #Data) && bit_end_r && s_lt_end_r => 0w3
            else => it
        }
    }
    //> The NEXT bit time is a stuffed 0 (armed when the 6th consecutive
    //> one is consumed).  Consumed at the next bit-time edge: that edge
    //> toggles lvl (the stuffed 0's transition), advances neither s nor
    //> crc_shift, and re-arms the run counter.
    reg stuff_pending : Bit on clk {
        initial it <= false
        it <= when {
            case rst => false
            case guard_last => false
            case (state == #Data) && bit_end_r && it => false
            case (state == #Data) && bit_end_r && s_lt_end_r && raw_bit_r && (ones == 5w3) => true
            else => it
        }
    }
    //> The CURRENT bit time is a stuffed 0: gates the CRC16 advance off
    //> for this bit time (a stuffed bit consumes no raw bit).
    reg cur_stuff : Bit on clk {
        initial it <= false
        it <= when {
            case rst => false
            case guard_last => false
            case (state == #Data) && bit_end_r && stuff_pending => true
            case (state == #Data) && bit_end_r => false
            else => it
        }
    }
    //> Pad output enable: raised entering Data, dropped at the EOP's
    //> last bit time (bus release).
    reg oe_r : Bit on clk {
        initial it <= false
        it <= when {
            case rst => false
            case guard_last => true
            case (state == #EopJ) && bit_end_r => false
            else => it
        }
    }
    //> 1-clk tx_done pulse at the EOP's last bit time.
    reg done_r : Bit on clk {
        initial it <= false
        it <= (state == #EopJ) && bit_end_r
    }

    // ---- CRC16 wire-bit shift register -------------------------------

    //> The CRC wire bits are SHIFTED out of this register instead of
    //> muxed live from the LFSR: the raw-bit CRC branch would otherwise
    //> compute 15 - (s - payload_end_r) -- a per-cycle 10-bit subtract
    //> + compare cone off the crc16 flops (the old vir-flow critical
    //> path).  Loaded with the final wire-ordered CRC (crc_wire) at the
    //> edge that consumes the last payload raw bit, then shifted right
    //> (MSB first) once per consumed raw bit; raw_bit's CRC branch is a
    //> single register bit.  Stuffed bit times don't shift; a re-load
    //> on a following stuffed edge is harmless (see crc_load_r).
    reg crc_shift : Word[16] on clk {
        initial it <= 0w16
        it <= when {
            case rst => 0w16
            case bit_end_r && crc_load_r => crc_wire
            case (state == #Data) && bit_end_r && !stuff_pending && s_lt_end_r => word(it[15..0], false)
            else => it
        }
    }

    // ---- producer byte pipeline + CRC instance -----------------------

    //> Producer byte pipeline: tx_addr leads the engine's read by one
    //> bit time (s advances at bit-time edges, the byte is stable for
    //> the whole 4-clk bit time), so this register stage splits the big
    //> producer mux (64:1 snapshot / descriptor ROM) out of the
    //> single-cycle engine path.  The engine reads tx_byte_r only.
    //> Loaded once per payload byte: during bit time k, s = k+1, and
    //> bit 0 of byte b (raw index 16+8b) is CONSUMED at the end of the
    //> previous byte's last bit time -- so the reload fires when
    //> s[2:0]==0 (s = 16+8b, during byte b-1's bit 7); the registered
    //> producer holds THIS byte's data from the previous byte's fetch
    //> window, and the single load per byte keeps it stable through all
    //> eight bit times.
    reg tx_byte_r : Word[8] on clk {
        initial it <= 0w8
        it <= when {
            case (state == #Data) && (btc == 0w2) && (s[3..0] == 0w3) && (s >= 16w10) => tx_byte
            else => it
        }
    }
    //> raw_bit pipelined one clk: f(s) is evaluated against the
    //> registered s, and the engine reads raw_bit_r one clk later,
    //> which splits the compare/select chain and the stuff/NRZI tail
    //> into separate cycles.
    reg raw_bit_r : Bit on clk {
        initial it <= false
        it <= raw_bit
    }

    //> Payload CRC16 (usb::Crc16).  Re-seeded by tx_start; advances one
    //> serial bit at btc==2 of every non-stuffed bit time whose raw bit
    //> is a payload bit (16 <= s < payload_end_r); consumes raw_bit_r,
    //> i.e. exactly the bit the current bit time's encoding drives.
    mod crc16 of Crc16 {
        it.clk := clk
        it.rst := tx_start
        it.adv := (state == #Data) && (btc == 2w2) && !cur_stuff
            && is_data && (s >= 16w10) && (s < payload_end_r)
        it.din := raw_bit_r
    }
}

mod UsbController {
    //> 48 MHz board clock.
    incoming clock : Clock
    //> From UsbPor (instantiated at the top so the sim TB can
    //> parameterize it): high once the ~175 ms power-on count is done.
    incoming por_done : Bit

    // Byte-stream interface (plan §2), identical contract to the old
    // ext mod UsbController this structure replaces.
    //> Byte from the host; valid for one cycle with rx_valid.
    outgoing rx_data   : Word[8]
    //> 1-clk strobe per received byte.
    outgoing rx_valid  : Bit
    //> The tx FIFO has room for another byte.
    outgoing tx_ready  : Bit
    //> Byte toward the host.
    incoming tx_data   : Word[8]
    //> 1-clk push strobe for tx_data.
    incoming tx_strobe : Bit
    //> Flow control back: low = the rx consumer is full, stop popping
    //> (the core NAKs bulk-OUT packets instead).
    incoming rx_ready  : Bit

    //> The core is receiving data (host -> device); stretched ~175 ms
    //> past the last byte (drives led_red, active low, at the top).
    outgoing rxing : Bit
    //> The core is sending data (device -> host); stretched ~175 ms
    //> past the last byte (drives led_green, active low).
    outgoing txing : Bit

    // Pad-facing side: unidirectional wires to/from the UsbPads ext
    // mod (wired by export mod Top in src/top.vir).
    //> D+ drive level out to UsbPads.
    outgoing dp_tx         : Bit
    //> D- drive level out to UsbPads.
    outgoing dn_tx         : Bit
    //> Pad drive enable out to UsbPads.
    outgoing output_enable : Bit
    //> D+ pad sample in from UsbPads.
    incoming dp_rx         : Bit
    //> D- pad sample in from UsbPads.
    incoming dn_rx         : Bit

    //> The core reset is REGISTERED one clk behind por_done: the
    //> por_done flop must sit next to the usb_dp_pu pad (its dominant
    //> load), and a pad-adjacent flop sourcing the core-wide reset
    //> forced the placer to route the reset OUT of the IO region and
    //> back into the fabric (the 4.9 ns first hop of the vir-flow
    //> critical path).  A dedicated flop with no IO load is placed in
    //> the core region instead.  +1 clk of reset assertion at a
    //> ~175 ms POR is free; the core still leaves reset before it can
    //> drive the bus (output_enable is gated by the in-reset core).
    reg por_rst : Bit on clock {
        initial it <= false
        it <= por_done
    }
    wire core_rst : Bit {
        it := !por_rst
    }

    mod core of UsbUart {
        it.clk  := clock
        it.rst  := core_rst
        it.dp_rx := dp_rx
        it.dn_rx := dn_rx
        it.tx_data   := tx_data
        it.tx_strobe := tx_strobe
        it.rx_ready  := rx_ready
    }

    dp_tx          := core.dp_tx
    dn_tx          := core.dn_tx
    output_enable  := core.output_enable
    rx_data        := core.rx_data
    rx_valid       := core.rx_valid
    tx_ready       := core.tx_ready
    rxing          := core.rxing
    txing          := core.txing
}
