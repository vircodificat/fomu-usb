import ice40

//> The USB core in Virdant: everything between the byte stream and the
//> USB pads.  This file holds the pad interface (UsbPads), the power-on
//> reset (UsbPor), the serial CRC LFSRs (Crc5/Crc16), the RX PHY and
//> packet/token decoder (RxPhy/RxPacket), EP0, the serial byte pipeline
//> (Serial), the TX PHY (TxPhy), and the core tops (UsbUart, wrapped by
//> UsbController).  Only what Virdant cannot express stays vendored in
//> ext/usb_uart.sv and ext/usb_pads.sv: the indexed memories
//> (\usb::TxFifo / \usb::RxFifo / \usb::DescRom) and the bidirectional
//> USB pads (UsbPads, the only `inout` in the design).
//>
//> Topology (wired by export mod Top in src/top.vir):
//>
//>     UsbPor (~175 ms) --por_done--> UsbController --byte stream--> echo
//>     UsbController --dp_tx/dn_tx/output_enable--> UsbPads (ext, SB_IO)
//>     UsbPads --dp_rx/dn_rx--> UsbController
//>
//> The pad-facing side is deliberately UNIDIRECTIONAL: the only
//> bidirectional nets in the whole design live inside UsbPads.


//> The two USB D+/D- tristate pad cells (iCE40 SB_IO, PIN_TYPE
//> 6'b101001) -- the one ext mod that touches a bidirectional net.
//> Body in ext/usb_pads.sv: two SB_IO instances, one per line, sharing
//> a single output_enable (the core drives both lines together or
//> neither).  From Virdant's point of view every wire here is
//> unidirectional: we drive the pads via dp_tx/dn_tx gated by
//> output_enable, and sample them back via dp_rx/dn_rx; the electrical
//> bidirectionality never crosses this boundary (the ext body's
//> `inout` port declarations are the Verilog-side plumbing that gets
//> the SB_IO PACKAGE_PIN nets out to the Top ports / PCF pins).
ext mod UsbPads {
    //> USB D+ pad side, out to the Top port (PCF pin A1 in fomu.pcf);
    //> electrically bidirectional, driven/sampled by the SB_IO cell
    //> inside the ext body.
    outgoing usb_dp : Bit
    //> USB D- pad side, out to the Top port (PCF pin A2 in fomu.pcf);
    //> ditto.
    outgoing usb_dn : Bit
    //> D+ drive level into the pads (SB_IO D_OUT_0): driven onto the
    //> wire only while output_enable is high; ignored otherwise.
    incoming dp_tx         : Bit
    //> D- drive level into the pads (SB_IO D_OUT_0): same gating as
    //> dp_tx.
    incoming dn_tx         : Bit
    //> Tristate control from the core: drive the bus while high; low =
    //> listen (the pads release the bus, which idles in the J state
    //> held by the host and the D+ 1.5k pull-up).
    incoming output_enable : Bit
    //> D+ sample out of the pads (SB_IO D_IN_0, registered inside the
    //> pad cell).
    outgoing dp_rx : Bit
    //> D- sample out of the pads (SB_IO D_IN_0, registered inside the
    //> pad cell).
    outgoing dn_rx : Bit
}

//> Power-on reset / USB attach delay: counts 8_400_000 cycles at
//> 48 MHz (~175 ms), then raises `por_done` and holds it high.  The
//> count is the USB attach delay: how long the device waits before
//> releasing the D+ pull-up and attaching to the host.
//>
//> NB: the count is inlined -- there is no parameter -- and the
//> literal 8_400_000 appears in BOTH regs below, so change them
//> together.  The sim TB (tb/tb_usb_serial.v) therefore eats the full
//> ~175 ms attach delay.
mod UsbPor {
    //> 48 MHz board clock.
    incoming clock  : Clock
    //> High (sticky) once the POR count completes.  Consumed at the
    //> top (src/top.vir): wired directly to the usb_dp_pu pad (the D+
    //> pull-up = attach), and into UsbController, where it is
    //> registered once more (por_rst) to form the core-wide reset.
    outgoing por_done : Bit

    // 24 bits suffice: 8_400_000 < 2^24 = 16_777_216.  Counts up
    // while por_done_r is still low; holds at the terminal count.
    reg por_cnt : Word[24] on clock {
        initial it <= 0
        it <= when {
            case !por_done_r && (it < 8_400_000) => it + 1
            else                                 => it
        }
    }

    // Sticky flag: set when the count completes, never cleared.
    reg por_done_r : Bit on clock {
        initial it <= false
        it <= when {
            case por_cnt >= 8_400_000 => true
            else                      => it
        }
    }

    por_done := por_done_r
}

//> The USB Full-Speed CDC-ACM device core is now a PLAIN Virdant
//> mod (mod UsbUart, declared after usb::TxPhy below): the whole
//> protocol stack -- RxPhy, RxPacket, Ep0, Serial, TxPhy, the token
//> router, response arbiter, snapshot loader and rx push -- lives in
//> .vir.  Only what Virdant cannot express stays vendored in
//> ext/usb_uart.sv as ext bodies: the two sync FIFOs (\usb::TxFifo /
//> \usb::RxFifo over usb_fifo16x8), the bulk-IN snapshot RAM
//> (\usb::SnapRam), the descriptor ROM (\usb::DescRom) and the
//> payload RAM (\usb::RxRam) -- all indexed memories (the same
//> limitation that keeps \echo::EchoFifo in ext/); \usb::UsbPads
//> stays ext for the other Virdant gap, the design's only `inout`.

//> Serial CRC LFSRs (USB 2.0 §8.3.5).  Both advance one serial WIRE
//> bit per clk while `adv` is high (wire order = LSB first).  The
//> checker convention feeds the received wire CRC bits through the
//> LFSR too and compares the final state against the residual (token
//> CRC5: 5'h0C, data CRC16: 16'h800D) -- see the residual compares in
//> RxPacket.  Known-answer vectors live in tb/tb_crc.v, cross-checked
//> against valentyusb.  In this design Crc5 is receive-side only (the
//> device never transmits tokens); Crc16 also generates the TX data
//> CRC in TxPhy.
//>
//> Wire-bit convention (see the header of ext/usb_uart.sv): the
//> transmitted CRC stream is the complement of the register shifted
//> out MSB-first, i.e. crc_wire[i] = ~crc[W-1-i] with i = 0 the first
//> bit on the wire (complement + bit reverse).

//> CRC5, poly x^5+x^2+1, seed 0x1F -- the token CRC over
//> addr[6:0] + endp[3:0].  Used receive-side only: RxPacket advances
//> it over the token bits and checks the residual.
mod Crc5 {
    //> 48 MHz clock.
    incoming clk : Clock
    //> Synchronous reset: re-seed the LFSR to 0x1F (RxPacket asserts
    //> it at sop / bus reset / core reset).
    incoming rst : Bit
    //> Advance one serial wire bit on this clk edge.
    incoming adv : Bit
    //> Serial input bit, wire order (LSB first).
    incoming din : Bit
    //> Current LFSR state.  In this checker-only role the caller
    //> compares it against the residual 5'h0C, which is what remains
    //> after a good token stream incl. its received CRC bits.
    outgoing crc : Word[5] {
        it := r
    }

    //> Feedback bit: din XOR the x^5 tap (r[4]).
    wire inv : Bit {
        it := din ^ r[4]
    }

    //> The 5-bit shift register.  Next state = {r[3:0], inv} with the
    //> x^2 tap XORed into bit 2; seeds to 0x1F.
    reg r : Word[5] on clk {
        initial it <= 31w5
        it <= when {
            case rst => 31w5
            case adv => word(it[4..0], inv) ^ word(0w2, inv, 0w2)
            else     => it
        }
    }
}

//> CRC16, poly x^16+x^15+x^2+1, seed 0xFFFF -- the data-payload CRC:
//> checker in RxPacket, generator for TX data packets in TxPhy.
mod Crc16 {
    //> 48 MHz clock.
    incoming clk : Clock
    //> Synchronous reset: re-seed the LFSR to 0xFFFF.
    incoming rst : Bit
    //> Advance one serial wire bit on this clk edge.
    incoming adv : Bit
    //> Serial input bit, wire order (LSB first).
    incoming din : Bit
    //> Current LFSR state.  As a generator (TxPhy): the transmitted
    //> wire stream is ~crc shifted out MSB-first, i.e. crc_wire[i] =
    //> ~crc[15-i] with i = 0 the first bit on the wire (the ext
    //> header's "complement + bit-reverse, low byte first"
    //> convention; TxPhy realizes it by loading crc_shift with
    //> crc ^ 0xFFFF and shifting MSB-first).  As a checker
    //> (RxPacket): after a good payload incl. its received CRC bits
    //> the state is the residual 16'h800D.
    outgoing crc : Word[16] {
        it := r
    }

    //> Feedback bit: din XOR the x^16 tap (r[15]).
    wire inv : Bit {
        it := din ^ r[15]
    }

    //> The 16-bit shift register.  Next state = {r[14:0], inv} with
    //> the x^15 tap XORed into bit 15 and the x^2 tap into bit 2;
    //> seeds to 0xFFFF.
    reg r : Word[16] on clk {
        initial it <= 65535w16
        it <= when {
            case rst => 65535w16
            case adv => word(it[15..0], inv) ^ word(inv, 0w12, inv, 0w2)
            else     => it
        }
    }
}

//> usb_rx_phy -- pads to decoded bits (USB 2.0 §7.1.x), migrated out
//> of ext/usb_uart.sv.  Single 48 MHz domain, 4 clks per FS bit, no
//> DLL/PLL/CDC.  Turn the raw D+/D- pad samples into an NRZI-decoded,
//> bit-unstuffed serial bit stream plus the packet-boundary signals
//> the rest of the core consumes (all one-clk strobes):
//>
//>   sop   J->K seen from idle (start of packet)
//>   eop   SE0 held ~1.75 bit times (end of packet)
//>   active  inside a packet (sop..eop)
//>   pkt_err sticky per-packet error (SE1 seen, or 6 ones then a 1;
//>           cleared at the next sop)
//>   bus_reset SE0 held >= 2.5 us (120 clks)
//>
//> Cycle-exact translation of the original always block: every reg's
//> next-state below is the same priority chain the Verilog if/else-if
//> tree encoded.  The bit-sampling details (phase-1 capture, re-align
//> on every transition, 7-clk EOP arming) are load-bearing -- see the
//> original comments preserved on each reg and wiki/usb-rx-phy.md.
mod RxPhy {
    //> 48 MHz clock: 4 clk cycles per USB FS bit.
    incoming clk : Clock
    //> Synchronous reset (core reset from UsbController).  Deliberately
    //> NOT asserted on bus reset: the bus-reset detector lives here.
    incoming rst : Bit
    //> Raw D+ pad sample (SB_IO D_IN_0 via UsbPads); asynchronous to
    //> clk -- see the synchronizer note below.
    incoming dp  : Bit
    //> Raw D- pad sample (SB_IO D_IN_0 via UsbPads); asynchronous to
    //> clk, ditto.
    incoming dn  : Bit

    //> Decoded (NRZI-decoded, bit-unstuffed) data bit.
    outgoing bit_o     : Bit {
        it := bit_r
    }
    //> 1-clk strobe: bit_o is good this cycle.
    outgoing bit_valid : Bit {
        it := bit_v_r
    }
    //> 1-clk pulse: J->K seen from idle (start of packet).
    outgoing sop       : Bit {
        it := sop_r
    }
    //> 1-clk pulse: SE0 held ~1.75 bit times (end of packet).
    outgoing eop       : Bit {
        it := eop_r
    }
    //> Inside a packet (from sop until eop).
    outgoing active    : Bit {
        it := act
    }
    //> Sticky per-packet error: SE1 seen, or 6 ones then a 1; cleared
    //> at the next sop.
    outgoing pkt_err   : Bit {
        it := perr
    }
    //> 1-clk pulse: SE0 held >= 2.5 us (host-issued bus reset).
    outgoing bus_reset : Bit {
        it := br_r
    }

    // ---- synchronizers, edge history, decode cones --------------------

    //> The pads are asynchronous to the 48 MHz clock (the host's rate
    //> is only specified to ±0.25%, which is why the bit recovery
    //> below re-aligns on every transition), so both lines go through
    //> a canonical two-flop synchronizer (builtin::Sync) before
    //> anything looks at them.
    //>
    //> NB, a deliberate behavior change vs the hand-rolled reset-held
    //> synchronizers this replaces: Sync has no reset, so the pads are
    //> tracked from cycle 0.  With no host attached (pull-up off) the
    //> pads can read SE0-ish, so se0_cnt free-runs during the ~175 ms
    //> POR and bus_reset may pulse pre-attach -- into a core that is
    //> still held in core_rst, so it is unobservable downstream.
    mod sync_dp of Sync {
        it.inp   := dp
        it.clock := clk
    }
    mod sync_dn of Sync {
        it.inp   := dn
        it.clock := clk
    }
    wire sdp : Bit {
        it := sync_dp.out
    }
    wire sdn : Bit {
        it := sync_dn.out
    }
    //> Previous-cycle synchronized D+ sample; with dn_p it forms the
    //> transition detect (`trans`).
    reg dp_p : Bit on clk {
        initial it <= false
        it <= when {
            case rst => false
            else     => sdp
        }
    }
    //> Previous-cycle synchronized D- sample; the other half of
    //> `trans`.
    reg dn_p : Bit on clk {
        initial it <= false
        it <= when {
            case rst => false
            else     => sdn
        }
    }

    wire trans : Bit {
        it := (sdp != dp_p) || (sdn != dn_p)
    }
    // bus states: SE0 (both low), SE1 (illegal), K (the sync edge polarity)
    wire se0 : Bit {
        it := !sdp && !sdn
    }
    wire se1 : Bit {
        it := sdp && sdn
    }
    wire k : Bit {
        it := !sdp && sdn
    }
    // NRZI decode of the mid-bit sample: a bit is a 1 when the line
    // level did not change since the previous sample.
    wire bit_val : Bit {
        it := (sdp == lev_d) && (sdn == lev_n)
    }

    // next-state helper cones (mutually exclusive where priority
    // matters; rst always wins as the first case of every reg)
    wire sop_edge : Bit {
        it := !act && k
    }
    wire abort : Bit {
        it := act && se1
    }
    wire eop_now : Bit {
        it := act && se0 && (se0_cnt == 6w7)
    }
    // inside a packet at a J/K level (not SE0/SE1)
    wire jk : Bit {
        it := act && !se1 && !se0
    }
    // the mid-bit sample point: phase 1 captures sdp 2-3 clks after the
    // switch reaches sdp -- inside the bit's visibility window for EVERY
    // achievable quantized window width (3, 4 or 5 clks).  The re-align
    // at every transition (ph reset, below) makes the counter read 0 one
    // clk after the transition, so one sample lands per bit window for
    // run windows of any length (4n-1/4n/4n+1 clks all yield n captures).
    wire sample : Bit {
        it := jk && (ph == 1w2)
    }

    //> Previous bit sample on D+ (NRZI decode reference).  Reset/idle
    //> value = J (D+ high).
    reg lev_d : Bit on clk {
        initial it <= true
        it <= when {
            case rst    => true
            case sample => sdp
            else        => it
        }
    }
    //> Previous bit sample on D- (NRZI decode reference).  Reset/idle
    //> value = J (D- low).
    reg lev_n : Bit on clk {
        initial it <= false
        it <= when {
            case rst    => false
            case sample => sdn
            else        => it
        }
    }

    //> Bit-phase counter (0..3 clks into the current bit).  Clock
    //> recovery: re-aligned to 0 on every line transition; phase 1 is
    //> the mid-bit sample (see the `sample` wire).
    reg ph : Word[2] on clk {
        initial it <= 0w2
        it <= when {
            case rst       => 0w2
            case sop_edge  => 0w2
            case jk        => mux(trans, 0w2, it + 1w2)
            else           => it
        }
    }

    //> In-packet flag: armed at the sop edge, dropped with the eop
    //> pulse or on an SE1 (illegal bus state).
    reg act : Bit on clk {
        initial it <= false
        it <= when {
            case rst      => false
            case sop_edge => true
            case abort    => false
            case eop_now  => false
            else          => it
        }
    }

    //> Sticky per-packet error: set on SE1 (illegal bus state) or a
    //> stuffing violation (6 ones then a 1); cleared at the next sop.
    reg perr : Bit on clk {
        initial it <= false
        it <= when {
            case rst                        => false
            case sop_edge                   => false
            case abort                      => true
            case sample && drop_state && bit_val => true
            else                            => it
        }
    }

    //> Consecutive-ones counter for bit destuffing: the 6th
    //> consecutive decoded 1 arms drop_state, so the next (stuffed 0)
    //> bit is dropped.  3 bits, wraps (harmless: the drop resets it).
    reg stuff_cnt : Word[3] on clk {
        initial it <= 0w3
        it <= when {
            case rst   => 0w3
            case !act  => 0w3
            case sample => mux(drop_state, 0w3, mux(bit_val, it + 1w3, 0w3))
            else       => it
        }
    }

    //> Armed after 6 consecutive ones: the next decoded bit is the
    //> stuffed 0 and is dropped (bit_valid suppressed); a 1 in that
    //> slot is a stuffing violation (perr).
    reg drop_state : Bit on clk {
        initial it <= false
        it <= when {
            case rst                                    => false
            case !act                                   => false
            case sample && it                           => false
            case sample && bit_val && (stuff_cnt == 5w3) => true
            else                                        => it
        }
    }

    //> Standalone SE0 timer: the EOP threshold is checked off
    //> `eop_now` (~1.75 bit times = 7 clks); 119 clks = 2.5 us = bus
    //> reset.  The 7-bit counter wraps, so sustained reset SE0
    //> re-pulses every 128 clks (the ep0 FSM treats each pulse
    //> identically).
    reg se0_cnt : Word[7] on clk {
        initial it <= 0w7
        it <= when {
            case rst => 0w7
            case se0 => it + 1w7
            else     => 0w7
        }
    }

    // Single-cycle output strobes: default low, pulsed by their event.
    //> 1-clk sop strobe (J->K seen while idle).
    reg sop_r : Bit on clk {
        initial it <= false
        it <= when {
            case rst      => false
            case sop_edge => true
            else          => false
        }
    }
    //> 1-clk eop strobe (SE0 held ~1.75 bit times while in-packet).
    reg eop_r : Bit on clk {
        initial it <= false
        it <= when {
            case rst     => false
            case eop_now => true
            else         => false
        }
    }
    //> 1-clk strobe: a decoded, unstuffed bit is on bit_r this cycle
    //> (suppressed for the dropped stuff bit).
    reg bit_v_r : Bit on clk {
        initial it <= false
        it <= when {
            case rst                    => false
            case sample && !drop_state  => true
            else                        => false
        }
    }
    //> Decoded NRZI bit value, captured at every mid-bit sample
    //> (including the dropped one -- its value is what the perr
    //> violation check reads).
    reg bit_r : Bit on clk {
        initial it <= false
        it <= when {
            case rst    => false
            case sample => bit_val
            else        => it
        }
    }
    //> 1-clk bus_reset strobe (SE0 held >= 2.5 us; see se0_cnt).
    reg br_r : Bit on clk {
        initial it <= false
        it <= when {
            case rst              => false
            case se0_cnt == 119w7 => true
            else                  => false
        }
    }
}

//> usb_rx_packet -- bit stream -> packet records, migrated out of
//> ext/usb_uart.sv.  Cycle-exact translation of the original always
//> blocks (same discipline as usb::RxPhy): every reg's next-state
//> below is the same priority chain the Verilog if/else-if tree
//> encoded, and the registered-helper structure (the cap precompute
//> + qualify dance) is load-bearing for the 48 MHz timing -- see
//> wiki/usb-rx-packet.md and the original comments carried below.
//>
//> Bit counting: nb counts PID-section bits (sync 0..7 ignored, PID
//> byte 0..7, token data 8..18, crc5 wire bits 19..23, parked at 24
//> in the data section); n3 is the data-section bit-in-byte index
//> (0..7, wrapping), with bc counting complete bytes (payload + the
//> 2 trailing crc16 wire bytes, subtracted at EOP).  Emits 1-clk
//> registered pulses tk_*/dt_*/hs_*; bad packets are silent.
//> Payload capture: dt_head = flopped packet bytes 0..7, and the
//> payload RAM (usb::RxRam above) holds bytes 0..63 in block RAM
//> (sync read: dt_rd_addr -> dt_rd_data the next clk).
enum type RxPktState {
    Idle = 0b00w2
    Sync = 0b01
    Body = 0b10
}

//> The 64x8 payload block RAM (dt_ram in the old usb_rx_packet), a
//> plain Virdant mod over one iCE40 SB_RAM40_4K cell
//> (ice40::SbRam40_4k, WRITE_MODE/READ_MODE 0 = NORMAL).  The 8-bit
//> payload rides the cell's low byte (WDATA zero-extended, MASK
//> 0xFF00 freezes the upper byte) and the 6-bit byte index rides the
//> low 6 address bits (zext to the cell's Word[11]).  One write port
//> (registered address, one enable -- no decode tree, no per-byte
//> enable fanout) and one registered sync read port (present ra,
//> the byte is on rd the NEXT clk: SB_RAM40_4K NORMAL read mode is
//> registered, RCLKE/RE tied high = free-running read).  yosys maps
//> the cell directly -- no inference, no ram_style hint needed.
mod RxRam {
    //> 48 MHz clock.
    incoming clk : Clock
    //> Write enable: byte-complete strobe, pre-gated with !(bc >= 64)
    //> by the caller (writes beyond byte 63 are dropped -- over-length
    //> packets go bad and dt_valid never fires, so no consumer ever
    //> sees a dropped byte).
    incoming we : Bit
    //> Write address: the byte-count index, 0..63.
    incoming wa : Word[6]
    //> Write data byte.
    incoming wd : Word[8]
    //> Read address (present this clk; the byte is on rd next clk).
    incoming ra : Word[6]
    //> Registered read data: mem[ra] as of the previous posedge.
    outgoing rd : Word[8]

    mod ram of ice40::SbRam40_4k {
        it.RCLK  := clk
        it.WCLK  := clk
        it.RCLKE := true
        it.WCLKE := true
        it.RE    := true
        it.WE    := we
        it.WADDR := zext(wa)
        it.RADDR := zext(ra)
        it.WDATA := word(0w8, wd)
        it.MASK  := 0xFF00
        rd := it.RDATA[8..0]
    }
}

//> Bit stream -> packet records: consumes usb::RxPhy's decoded bit
//> stream (bit_i/bit_valid/sop/eop/pkt_err) and emits 1-clk record
//> pulses -- tk_* (token: OUT/IN/SOF), dt_* (data: payload +
//> read port), hs_* (handshake) -- for the router in the core top.
//> A packet record is emitted only if the packet was good; CRC
//> failures deliver the record with *_crc_ok low instead (the
//> protocol layer retries), while stuff errors, bad PIDs and
//> over-length payloads make the packet silent (bad).
mod RxPacket {
    //> 48 MHz clock: 4 clk cycles per USB FS bit.
    incoming clk : Clock
    //> Synchronous reset, active high (core reset from UsbController).
    incoming rst : Bit
    //> Bus reset strobe from usb::RxPhy (SE0 held >= 2.5 us): flushes
    //> everything, including partial packet state.
    incoming bus_reset : Bit
    //> Decoded (NRZI-decoded, bit-unstuffed) data bit.
    incoming bit_i : Bit
    //> 1-clk strobe: bit_i is a real packet bit this cycle.
    incoming bit_valid : Bit
    //> 1-clk pulse: start of packet (J->K from idle).
    incoming sop : Bit
    //> 1-clk pulse: end of packet (SE0 held ~1.75 bit times).
    incoming eop : Bit
    //> Sticky per-packet error from usb::RxPhy (stuff violation or
    //> illegal line state); kills the packet.
    incoming pkt_err : Bit

    // ---- token record ------------------------------------------------
    //> 1-clk pulse: a token record is in tk_* (latched this edge).
    outgoing tk_valid : Bit {
        it := tk_valid_r
    }
    //> Token PID (OUT 1 / IN 9 / SOF 5 / SETUP D).
    outgoing tk_pid : Word[4] {
        it := tk_pid_r
    }
    //> Device address (tk_sh[6:0]; SOF packets leave it stale).
    outgoing tk_addr : Word[7] {
        it := tk_addr_r
    }
    //> Endpoint (tk_sh[10:7]; SOF packets leave it stale).
    outgoing tk_endp : Word[4] {
        it := tk_endp_r
    }
    //> SOF frame number (tk_sh[10:0]; non-SOF tokens leave it stale).
    outgoing tk_frame : Word[11] {
        it := tk_frame_r
    }
    //> CRC5 residual check (5'h0C after a good token stream).
    outgoing tk_crc_ok : Bit {
        it := tk_crc_ok_r
    }

    // ---- data record -------------------------------------------------
    //> 1-clk pulse: a data record is in dt_* (latched this edge).
    outgoing dt_valid : Bit {
        it := dt_valid_r
    }
    //> Data PID (DATA0 3 / DATA1 B).
    outgoing dt_pid : Word[4] {
        it := dt_pid_r
    }
    //> Payload byte count (bc - 2: the 2 crc16 wire bytes are excluded).
    outgoing dt_len : Word[7] {
        it := dt_len_r
    }
    //> Flopped payload head window, packet bytes 0..7 (consumers that
    //> need several bytes AT ONCE -- the EP0 request latch,
    //> SET_LINE_CODING -- cannot use the one-at-a-time RAM port).
    outgoing dt_head : Word[64] {
        it := word(head7, head6, head5, head4, head3, head2, head1, head0)
    }
    //> Payload RAM registered read (usb::RxRam.rd): present dt_rd_addr,
    //> the byte is here the NEXT clk.
    outgoing dt_rd_data : Word[8] {
        it := ram.rd
    }
    //> Payload RAM read address (the rx-push byte index in the core).
    incoming dt_rd_addr : Word[6]
    //> CRC16 residual check (16'h800D after a good payload stream).
    outgoing dt_crc_ok : Bit {
        it := dt_crc_ok_r
    }

    // ---- handshake record --------------------------------------------
    //> 1-clk pulse: a handshake record is in hs_pid (latched this edge).
    outgoing hs_valid : Bit {
        it := hs_valid_r
    }
    //> Handshake PID (ACK 2 / NAK A / STALL E).
    outgoing hs_pid : Word[4] {
        it := hs_pid_r
    }

    // ---- capture helpers, wires ----------------------------------------

    //> PID capture value on this cycle (shift bit_i in at the bottom;
    //> wire order = LSB first).
    wire pid_new : Word[8] {
        it := word(bit_i, pid_r[8..1])
    }
    //> Byte completing on this bit clk (bit_i = the byte MSB,
    //> bshift[7:1] = the earlier 7 bits, LSB first).
    wire dt_byte_new : Word[8] {
        it := word(bit_i, bshift[8..1])
    }
    //> Byte-complete write strobe (registered inputs only: n3/st/sec
    //> are regs; bit_valid/pkt_err are registered upstream in
    //> usb::RxPhy).
    wire dt_wr : Bit {
        it := bit_valid && !pkt_err && (st == #Body) && sec && (n3 == 7w3)
    }

    // ---- CRC LFSRs ----------------------------------------------------
    //> CRC5 advances on token bits nb = 8..23 (data + received crc5
    //> wire bits; residual 5'h0C).  NOT gated by pkt_err, exactly as
    //> the vendored body: a bad packet's residual is never sampled.
    mod crc5 of Crc5 {
        it.clk := clk
        it.rst := sop || rst || bus_reset
        it.adv := bit_valid && (st == #Body) && !sec
            && (nb >= 8w5) && (nb < 24w5)
        it.din := bit_i
    }
    //> c5: the CRC5 state / residual compare source.
    wire c5 : Word[5] {
        it := crc5.crc
    }
    //> CRC16 advances on every data-section bit (payload + received
    //> crc16 wire bits; residual 16'h800D).
    mod crc16 of Crc16 {
        it.clk := clk
        it.rst := sop || rst || bus_reset
        it.adv := bit_valid && (st == #Body) && sec
        it.din := bit_i
    }
    //> c16: the CRC16 state / residual compare source.
    wire c16 : Word[16] {
        it := crc16.crc
    }

    // ---- registered helpers --------------------------------------------
    //> Each ends at its OWN register so the wide compares stay out of
    //> the capture strobes' cones (48 MHz timing; the caps are
    //> consumed only at EOP, >= 8 clks after the last bit, so the +1
    //> clk on each is free).  Computed every cycle from registered
    //> inputs; mid-packet values are harmless (only read at EOP).

    //> bc == 66 registered (the over-length hit), split so no 7-bit
    //> compare rides bc's D-cone: bits 6..3 == 0100 and bits 2..0 ==
    //> 010 (66 = 0b1000010).
    reg bc_is_66_r : Bit on clk {
        initial it <= false
        it <= when {
            case rst || bus_reset => false
            else => (bc[7..3] == 4w4) && (bc[3..0] == 2w3)
        }
    }
    //> PID check failure ({~pid, pid}: low nibble != ~high nibble,
    //> i.e. the nibbles XOR != 1111), registered one clk before it
    //> sets `bad`.
    reg pid_bad_r : Bit on clk {
        initial it <= false
        it <= when {
            case rst || bus_reset => false
            else => bit_valid && (st == #Body) && !sec && (nb == 7w5)
                    && ((pid_new[4..0] ^ pid_new[8..4]) != 15w4)
        }
    }
    //> Over-length data hit registered (67th byte = bc == 66 with a
    //> byte completing): feeds `bad`, +1 clk.
    reg bc66_hit_r : Bit on clk {
        initial it <= false
        it <= when {
            case rst || bus_reset => false
            else => bit_valid && (st == #Body) && sec
                    && (n3 == 7w3) && (bc == 66w7)
        }
    }
    //> CRC5 residual compare (5'h0C), registered: the 5-bit equality
    //> tree ends at its own flop instead of riding tk_crc_ok's cone.
    reg crc5_res_r : Bit on clk {
        initial it <= false
        it <= when {
            case rst || bus_reset => false
            else => c5 == 12w5
        }
    }
    //> CRC16 residual compare (16'h800D), registered likewise.
    reg crc16_res_r : Bit on clk {
        initial it <= false
        it <= when {
            case rst || bus_reset => false
            else => c16 == 0x800dw16
        }
    }

    //> Flat sticky per-packet error, plain D (no clock enable): set on
    //> a stuff error (inline), a bad PID or an over-length byte (the
    //> registered hits above, +1 clk); cleared at sop and by reset.
    //> A bad packet is silent: every cap is qualified by !bad, so no
    //> strobe ever fires.
    reg bad : Bit on clk {
        initial it <= false
        it <= when {
            case rst || bus_reset => false
            case sop              => false
            else => it || (bit_valid && pkt_err) || pid_bad_r || bc66_hit_r
        }
    }

    // ---- FSM ------------------------------------------------------------
    //> IDLE -> (sop) -> SYNC (skip the 8 sync bits) -> BODY (PID
    //> section, then token or data section) -> (eop) -> IDLE.
    reg st : RxPktState on clk {
        initial it <= #Idle
        it <= when {
            case rst || bus_reset => #Idle
            case sop             => #Sync
            case eop             => #Idle
            case bit_valid && !pkt_err => mux(it == #Sync && nb == 7w5, #Body, it)
            else => it
        }
    }

    //> PID/token-section bit index: sync 0..7 (ignored), PID byte
    //> 0..7, token data 8..18, crc5 wire bits 19..23; parked at 24 in
    //> the data section (and reached at EOP for a well-formed token).
    reg nb : Word[5] on clk {
        initial it <= 0w5
        it <= when {
            case rst || bus_reset => 0w5
            case sop             => 0w5
            case bit_valid && !pkt_err => match st {
                case #Sync => mux(it == 7w5, 0w5, it + 1w5)
                case #Body => when {
                    // data section: parked at 24
                    case sec     => it
                    // last PID bit: classify the packet from the low 2
                    // PID bits (11 = data -> park at 24; else token/
                    // handshake bits start at 8)
                    case it == 7w5 => mux(pid_new[2..0] == 3w2, 24w5, 8w5)
                    else           => it + 1w5
                }
                else => it
            }
            else => it
        }
    }

    //> Data-section bit-in-byte index (0..7, wraps mod 8).
    reg n3 : Word[3] on clk {
        initial it <= 0w3
        it <= when {
            case rst || bus_reset => 0w3
            case sop             => 0w3
            case bit_valid && !pkt_err => match st {
                case #Sync => mux(nb == 7w5, 0w3, it)
                case #Body => mux(sec,
                    it + 1w3,
                    mux(nb == 7w5 && pid_new[2..0] == 3w2, 0w3, it))
                else => it
            }
            else => it
        }
    }

    //> The PID byte, FROZEN after the PID section (it classifies the
    //> packet at EOP; the token/crc bits never touch it).
    reg pid_r : Word[8] on clk {
        initial it <= 0w8
        it <= when {
            case rst || bus_reset => 0w8
            case sop             => 0w8
            case bit_valid && !pkt_err
                && (st == #Body) && !sec && (nb < 8w5) => pid_new
            else => it
        }
    }

    //> The 11 token bits, shift-up capture (LSB first): at EOP,
    //> addr = tk_sh[6:0], endp = tk_sh[10:7], frame = tk_sh[10:0].
    reg tk_sh : Word[11] on clk {
        initial it <= 0w11
        it <= when {
            case rst || bus_reset => 0w11
            case sop             => 0w11
            case bit_valid && !pkt_err
                && (st == #Body) && !sec
                && (nb >= 8w5) && (nb < 19w5) => word(bit_i, it[11..1])
            else => it
        }
    }

    //> Data-section byte assembly shifter (feeds dt_byte_new).
    reg bshift : Word[8] on clk {
        initial it <= 0w8
        it <= when {
            case rst || bus_reset => 0w8
            case sop             => 0w8
            case bit_valid && !pkt_err
                && (st == #Body) && sec => word(bit_i, it[8..1])
            else => it
        }
    }

    //> Byte count in the data section: payload bytes + the 2
    //> trailing crc16 wire bytes (subtracted at EOP).
    reg bc : Word[7] on clk {
        initial it <= 0w7
        it <= when {
            case rst || bus_reset => 0w7
            case sop             => 0w7
            case bit_valid && !pkt_err
                && (st == #Body) && sec && (n3 == 7w3) => it + 1w7
            else => it
        }
    }

    //> Section flag: 0 = PID section, 1 = data section (set when the
    //> PID low bits say 11).
    reg sec : Bit on clk {
        initial it <= false
        it <= when {
            case rst || bus_reset => false
            case sop             => false
            case bit_valid && !pkt_err
                && (st == #Body) && !it && (nb == 7w5)
                => mux(pid_new[2..0] == 3w2, true, it)
            else => it
        }
    }

    // ---- capture candidates --------------------------------------------
    //> The (wide) end-of-packet capture conditions, precomputed at the
    //> last relevant BIT clk and held until EOP (no bit_valid clks
    //> fire during SE0/EOP, so a hold is safe; any further decoded bit
    //> clears them, so over-long packets stay silent).  The EOP-edge
    //> strobes then close over 2-3 shallow inputs instead of the whole
    //> bit-counting tree.

    //> Registered shared qualify for the PID-section caps (+1 clk: the
    //> caps are consumed only at EOP >= 8 clks later, so it is free).
    //> A same-cycle pkt_err is re-checked inline in every cap.
    reg q_pid_r : Bit on clk {
        initial it <= false
        it <= when {
            case rst || bus_reset => false
            case sop             => false
            case bit_valid => !bad && !pkt_err && (st == #Body) && !sec
            else => it
        }
    }
    //> Registered shared qualify for the data-section cap, ditto.
    reg q_dat_r : Bit on clk {
        initial it <= false
        it <= when {
            case rst || bus_reset => false
            case sop             => false
            case bit_valid => !bad && !pkt_err && (st == #Body) && sec
            else => it
        }
    }

    //> Token cap: last token bit (nb == 23) with token-class PID low
    //> bits (01).
    reg tok_cap : Bit on clk {
        initial it <= false
        it <= when {
            case rst || bus_reset => false
            case sop             => false
            case eop             => false
            case bit_valid => q_pid_r && !pkt_err
                && (pid_r[2..0] == 1w2) && (nb == 23w5)
            else => it
        }
    }
    //> SOF cap: token cap plus PID value 5 (the frame number case).
    reg sof_cap : Bit on clk {
        initial it <= false
        it <= when {
            case rst || bus_reset => false
            case sop             => false
            case eop             => false
            case bit_valid => q_pid_r && !pkt_err
                && (pid_r[2..0] == 1w2) && (nb == 23w5)
                && (pid_r[4..0] == 5w4)
            else => it
        }
    }
    //> Handshake cap: last PID bit (nb == 7) with handshake-class low
    //> bits (00 or 10) and the {~pid, pid} check inline (bad is not
    //> visible yet at this edge -- it comes via the +1-clk pid_bad_r).
    reg hs_cap : Bit on clk {
        initial it <= false
        it <= when {
            case rst || bus_reset => false
            case sop             => false
            case eop             => false
            case bit_valid => q_pid_r && !pkt_err
                && ((pid_r[2..0] == 0w2) || (pid_r[2..0] == 2w2))
                && (nb == 7w5)
                && ((pid_new[4..0] ^ pid_new[8..4]) == 15w4)
            else => it
        }
    }
    //> Data cap: byte-aligned last bit (n3 == 7) with dat_bc_ok_r
    //> (bc in 1..65: at least 2 bytes total at EOP, and one more byte
    //> would still fit the 64-byte payload RAM -- the bc == 66
    //> overflow is gated via the registered bc_is_66_r).
    reg dat_cap : Bit on clk {
        initial it <= false
        it <= when {
            case rst || bus_reset => false
            case sop             => false
            case eop             => false
            case bit_valid => q_dat_r && !pkt_err && (n3 == 7w3) && dat_bc_ok_r
            else => it
        }
    }
    //> Registered byte-count admission for dat_cap (bc in 1..65 as of
    //> the last bit); NOT cleared at sop (holds through, exactly as
    //> the vendored body -- a sop-edge recompute would drag bc's
    //> D-cone into the strobe path).
    reg dat_bc_ok_r : Bit on clk {
        initial it <= false
        it <= when {
            case rst || bus_reset => false
            case sop             => it
            case bit_valid => (bc != 0w7) && !bc_is_66_r
            else => it
        }
    }

    // ---- payload storage -----------------------------------------------
    //> The payload RAM instance (block RAM, off the fabric: one write
    //> port + one registered read -- see usb::RxRam above).  Writes
    //> beyond byte 63 are dropped (bc[6]: over-length packets set bad
    //> via bc66_hit_r, so dt_valid never fires and no consumer ever
    //> sees a truncated payload).
    mod ram of RxRam {
        it.clk := clk
        it.we  := dt_wr && !bc[6]
        it.wa  := bc[6..0]
        it.wd  := dt_byte_new
        it.ra  := dt_rd_addr
    }

    //> Flopped payload head shadow, packet bytes 0..7 (bc < 8) -- eight
    //> SEPARATE byte-regs, exactly the vendored body's per-byte flops:
    //> each byte's enable is its own shallow decode (dt_wr && bc == k
    //> -- k < 8, so the equality subsumes the head-window test) and
    //> its D is dt_byte_new directly; the bc compare runs in PARALLEL
    //> with the dt_wr cone instead of serially behind it.  A single Word[64]
    //> reg with an 8-way splice mux was tried instead and was a
    //> MEASURED REGRESSION (abc9 shared the whole dt_wr cone into every
    //> bit's enable: the 21.6 ns vir-flow critical path, synth FAIL at
    //> 46.24 MHz); the per-byte structure re-closed.  A bad packet's
    //> payload is still written (same as the vendored body); dt_valid
    //> just never fires for it.
    reg head0 : Word[8] on clk {
        initial it <= 0w8
        it <= when {
            case rst || bus_reset => 0w8
            case dt_wr && (bc == 0w7) => dt_byte_new
            else => it
        }
    }
    reg head1 : Word[8] on clk {
        initial it <= 0w8
        it <= when {
            case rst || bus_reset => 0w8
            case dt_wr && (bc == 1w7) => dt_byte_new
            else => it
        }
    }
    reg head2 : Word[8] on clk {
        initial it <= 0w8
        it <= when {
            case rst || bus_reset => 0w8
            case dt_wr && (bc == 2w7) => dt_byte_new
            else => it
        }
    }
    reg head3 : Word[8] on clk {
        initial it <= 0w8
        it <= when {
            case rst || bus_reset => 0w8
            case dt_wr && (bc == 3w7) => dt_byte_new
            else => it
        }
    }
    reg head4 : Word[8] on clk {
        initial it <= 0w8
        it <= when {
            case rst || bus_reset => 0w8
            case dt_wr && (bc == 4w7) => dt_byte_new
            else => it
        }
    }
    reg head5 : Word[8] on clk {
        initial it <= 0w8
        it <= when {
            case rst || bus_reset => 0w8
            case dt_wr && (bc == 5w7) => dt_byte_new
            else => it
        }
    }
    reg head6 : Word[8] on clk {
        initial it <= 0w8
        it <= when {
            case rst || bus_reset => 0w8
            case dt_wr && (bc == 6w7) => dt_byte_new
            else => it
        }
    }
    reg head7 : Word[8] on clk {
        initial it <= 0w8
        it <= when {
            case rst || bus_reset => 0w8
            case dt_wr && (bc == 7w7) => dt_byte_new
            else => it
        }
    }

    // ---- output strobes + captured fields --------------------------------
    //> FLAT equations, one always block in the vendored body: the caps
    //> are MUTUALLY EXCLUSIVE by construction (tok: nb==23 in the PID
    //> section; hs: nb==7 in the PID section; dat: data section), so
    //> the caps close each strobe as one 2-input AND of registers, and
    //> reading them AT the eop edge is safe (same edge clears them;
    //> nonblocking semantics see the pre-edge values).

    //> Token strobe.
    reg tk_valid_r : Bit on clk {
        initial it <= false
        it <= when {
            case rst || bus_reset => false
            else => eop && tok_cap
        }
    }
    //> Token PID field: pid_r[3:0] at EOP.
    reg tk_pid_r : Word[4] on clk {
        initial it <= 0w4
        it <= when {
            case rst || bus_reset => 0w4
            case eop && tok_cap => pid_r[4..0]
            else => it
        }
    }
    //> Token address field: tk_sh[6:0] (non-SOF tokens only).
    reg tk_addr_r : Word[7] on clk {
        initial it <= 0w7
        it <= when {
            case rst || bus_reset => 0w7
            case eop && tok_cap && !sof_cap => tk_sh[7..0]
            else => it
        }
    }
    //> Token endpoint field: tk_sh[10:7] (non-SOF tokens only).
    reg tk_endp_r : Word[4] on clk {
        initial it <= 0w4
        it <= when {
            case rst || bus_reset => 0w4
            case eop && tok_cap && !sof_cap => tk_sh[11..7]
            else => it
        }
    }
    //> SOF frame field: the whole tk_sh (SOF tokens only).
    reg tk_frame_r : Word[11] on clk {
        initial it <= 0w11
        it <= when {
            case rst || bus_reset => 0w11
            case eop && tok_cap && sof_cap => tk_sh
            else => it
        }
    }
    //> Token CRC5 verdict: the registered residual compare.
    reg tk_crc_ok_r : Bit on clk {
        initial it <= false
        it <= when {
            case rst || bus_reset => false
            case eop && tok_cap => crc5_res_r
            else => it
        }
    }

    //> Data strobe.
    reg dt_valid_r : Bit on clk {
        initial it <= false
        it <= when {
            case rst || bus_reset => false
            else => eop && dat_cap
        }
    }
    //> Data PID field.
    reg dt_pid_r : Word[4] on clk {
        initial it <= 0w4
        it <= when {
            case rst || bus_reset => 0w4
            case eop && dat_cap => pid_r[4..0]
            else => it
        }
    }
    //> Data length field: bc - 2 (the crc16 wire bytes drop out).
    reg dt_len_r : Word[7] on clk {
        initial it <= 0w7
        it <= when {
            case rst || bus_reset => 0w7
            case eop && dat_cap => mux(bc >= 2w7, bc - 2w7, 0w7)
            else => it
        }
    }
    //> Data CRC16 verdict: the registered residual compare.
    reg dt_crc_ok_r : Bit on clk {
        initial it <= false
        it <= when {
            case rst || bus_reset => false
            case eop && dat_cap => crc16_res_r
            else => it
        }
    }

    //> Handshake strobe.
    reg hs_valid_r : Bit on clk {
        initial it <= false
        it <= when {
            case rst || bus_reset => false
            else => eop && hs_cap
        }
    }
    //> Handshake PID field (nothing follows the PID byte).
    reg hs_pid_r : Word[4] on clk {
        initial it <= 0w4
        it <= when {
            case rst || bus_reset => 0w4
            case eop && hs_cap => pid_r[4..0]
            else => it
        }
    }
}

//> usb_ep0 -- control transfer state machine (USB 2.0 §8.5.5) + CDC
//> requests, migrated out of ext/usb_uart.sv.  Cycle-exact
//> translation of the original always blocks (same discipline as
//> usb::RxPacket): every reg's next-state below is the same priority
//> chain the Verilog if/else-if tree encoded, including the
//> registered-accept pipeline (req_acc_r / sto_acc_r, +1 clk after
//> the router strobes) and the EP_PARSE -> EP_SETUP -> EP_ARM
//> request-decode pipeline -- all load-bearing for the 48 MHz timing
//> (see wiki/usb-ep0.md and the original comments carried below).
//>
//> Supported: GET_DESCRIPTOR (device/config/string), SET_ADDRESS
//> (latched at status-stage completion), SET_CONFIGURATION,
//> GET_STATUS (device), SET_CONTROL_LINE_STATE.  Everything else ->
//> STALL until the next SETUP.  Data toggles: SETUP is always DATA0
//> and re-initializes the toggle; the device data stage starts at
//> DATA1; the status-stage data packet is a zero-length DATA1 packet:
//> the device sends it in response to an IN token (control write /
//> no data stage) and ACKs the host's DATA1 ZLP after an OUT token
//> (control read).  Descriptor bytes are pulled by usb::TxPhy from
//> the core ROM via (resp_sel, resp_base + tx_addr).
enum type Ep0State {
    Idle    = 0w4
    RcvReq  = 1w4
    Send    = 2w4
    WaitAck = 3w4
    StatusI = 5w4
    StatusO = 6w4
    Stall   = 7w4
    Parse   = 8w4
    Setup   = 9w4
    Arm     = 10w4
}

//> EP0: the control endpoint.  Consumes the router-gated token /
//> data / handshake strobes and answers with 1-clk tx response
//> requests (resp_req + held params) for the core's response
//> arbiter, plus the device status (dev_addr, configured) and the
//> router hints (ep0_busy / ep0_stalling / ep0_wait_ack).
mod Ep0 {
    //> 48 MHz clock: 4 clk cycles per USB FS bit.
    incoming clk : Clock
    //> Synchronous reset, active high (core reset from UsbController).
    incoming rst : Bit
    //> Bus reset strobe (via the core, from usb::RxPhy): flushes any
    //> transfer in progress.
    incoming bus_reset : Bit
    //> Router-gated token strobes (address + endpoint matched): SETUP
    //> starts a control transfer and aborts any transfer in progress
    //> (USB 2.0 §8.5.2.2).
    incoming tk_setup : Bit
    //> IN token to EP0: the host wants the data stage / status ZLP.
    incoming tk_in : Bit
    //> OUT token to EP0.  EP0 never reacts to the token directly (the
    //> status-stage data packet arrives via dt_valid); the port exists
    //> for interface completeness with the router.
    incoming tk_out : Bit
    //> Router-gated data packet strobe: EP0 expects this packet (the
    //> SETUP request packet, or the status-stage ZLP).
    incoming dt_valid : Bit
    //> Data packet PID (DATA0 3 / DATA1 B).
    incoming dt_pid : Word[4]
    //> Data packet payload byte count.
    incoming dt_len : Word[7]
    //> Payload head window, packet bytes 0..7 (usb::RxPacket's flopped
    //> shadow -- EP0 only ever needs the request / line-coding window,
    //> never the RAM bytes 8..63).
    incoming dt_head : Word[64]
    //> Data packet CRC16 verdict.
    incoming dt_crc_ok : Bit
    //> Router-gated handshake strobe: EP0's response was ACKed.
    incoming hs_ack : Bit

    // ---- tx response request (1-clk pulse; params held) ------------
    //> 1-clk response request for the core's arbiter.
    outgoing resp_req : Bit {
        it := resp_req_r
    }
    //> Response PID: ACK 2, DATA0 3, DATA1 B, STALL E.
    outgoing resp_pid : Word[4] {
        it := resp_pid_r
    }
    //> Response payload byte count (0 for ACK / STALL / ZLP).
    outgoing resp_len : Word[7] {
        it := resp_len_r
    }
    //> Descriptor select (the core ROM's bank: 0 device, 1 config,
    //> 2/3/4 strings, 6 status).
    outgoing resp_sel : Word[3] {
        it := resp_sel_r
    }
    //> Descriptor byte offset the response starts at.
    outgoing resp_base : Word[10] {
        it := resp_base_r
    }

    // ---- device status ------------------------------------------------
    //> USB device address (applied at the owning SET_ADDRESS's status
    //> completion; 0 until enumerated).
    outgoing dev_addr : Word[7] {
        it := dev_addr_r
    }
    //> Configuration state (SET_CONFIGURATION(1) status completion).
    outgoing configured : Bit {
        it := configured_r
    }

    // ---- router hints -------------------------------------------------
    //> EP0 expects a data packet (SETUP request or status-stage ZLP):
    //> route dt_valid here.
    outgoing ep0_busy : Bit {
        it := (st == #RcvReq) || (st == #StatusO)
    }
    //> EP0 is STALLing (its data packets still route here until the
    //> next SETUP).
    outgoing ep0_stalling : Bit {
        it := st == #Stall
    }
    //> EP0's response is in flight: route the ACK here.
    outgoing ep0_wait_ack : Bit {
        it := st == #WaitAck
    }

    unused tk_out

    // ---- combinational decode helpers ---------------------------------
    //> wLength from the REGISTERED request bytes (the parse runs one
    //> clk after the SETUP data, so the registered view is current).
    wire w_length : Word[16] {
        it := word(rq7, rq6)
    }
    //> GET_DESCRIPTOR select from the registered request bytes: 0
    //> device, 1 config, 2/3/4 string 0/1/2 (rq2 = index), 7 invalid
    //> (-> STALL).  A named wire because the FSM must not read the
    //> previous request's `sel` when sizing `remain` -- the parse runs
    //> off the REGISTERED request bytes.
    wire new_sel : Word[3] {
        it := match rq3 {
            case 0x01w8 => 0w3
            case 0x02w8 => 1w3
            case 0x03w8 => match rq2 {
                case 0x00w8 => 2w3
                case 0x01w8 => 3w3
                case 0x02w8 => 4w3
                else        => 7w3
            }
            else => 7w3
        }
    }
    //> Descriptor lengths by select -- must match the core's desc ROM:
    //> sel 0=device 1=config 2=str0 3=str1 4=str2 6=status.
    wire dlen : Word[7] {
        it := match p_sel {
            case 0w3 => 18w7
            case 1w3 => 75w7
            case 2w3 => 4w7
            case 3w3 => 10w7
            case 4w3 => 32w7
            else     => 2w7
        }
    }

    // ---- registered data-stage accepts --------------------------------
    //> Registered data-stage accepts (independent shallow cones, one
    //> register each): the FSM reacts to the router strobes one clk
    //> after arrival -- every field it reads (dt_head / dt_pid /
    //> dt_len / dt_crc_ok) holds between packets, so the delayed
    //> reaction is bit-identical, and the +1 clk is free against the
    //> ~30-50 clk turnaround budget.

    //> SETUP request packet accepted (DATA0, 8 bytes, good CRC).
    reg req_acc_r : Bit on clk {
        initial it <= false
        it <= when {
            case rst || bus_reset => false
            else => (st == #RcvReq) && dt_valid
                && (dt_pid == 3w4) && dt_crc_ok && (dt_len == 8w7)
        }
    }
    //> Status-stage ZLP accepted (lenient on the data pid: hosts
    //> sending DATA0 here are taken).
    reg sto_acc_r : Bit on clk {
        initial it <= false
        it <= when {
            case rst || bus_reset => false
            else => (st == #StatusO) && dt_valid
                && (dt_len == 0w7) && dt_crc_ok
        }
    }

    // ---- request bytes (latched at the registered accept) -------------
    //> bmRequestType.
    reg rq0 : Word[8] on clk {
        initial it <= 0w8
        it <= when {
            case (st == #RcvReq) && req_acc_r => dt_head[8..0]
            else => it
        }
    }
    //> bRequest.
    reg rq1 : Word[8] on clk {
        initial it <= 0w8
        it <= when {
            case (st == #RcvReq) && req_acc_r => dt_head[16..8]
            else => it
        }
    }
    //> wValue low (descriptor type / SET_ADDRESS value / SET_CONFIGURATION value).
    reg rq2 : Word[8] on clk {
        initial it <= 0w8
        it <= when {
            case (st == #RcvReq) && req_acc_r => dt_head[24..16]
            else => it
        }
    }
    //> wValue high (descriptor sub-type: 1 device, 2 config, 3 string).
    reg rq3 : Word[8] on clk {
        initial it <= 0w8
        it <= when {
            case (st == #RcvReq) && req_acc_r => dt_head[32..24]
            else => it
        }
    }
    //> wLength high.  (rq4/rq5 = wIndex are never needed and not kept.)
    reg rq6 : Word[8] on clk {
        initial it <= 0w8
        it <= when {
            case (st == #RcvReq) && req_acc_r => dt_head[56..48]
            else => it
        }
    }
    //> wLength low.
    reg rq7 : Word[8] on clk {
        initial it <= 0w8
        it <= when {
            case (st == #RcvReq) && req_acc_r => dt_head[64..56]
            else => it
        }
    }

    // ---- decode-stage registers (EP_PARSE: one-hot flags + raw wLength)
    //> The request case tree is too deep for one 48 MHz cycle, so the
    //> decode is split across two: PARSE computes these flags, SETUP
    //> routes them, ARM applies.  No reset here, exactly as the
    //> vendored body -- every flag is written in PARSE before any
    //> reader looks at it.

    //> Decoded descriptor select.
    reg p_sel : Word[3] on clk {
        initial it <= 0w3
        it <= when {
            case st == #Parse => new_sel
            else => it
        }
    }
    //> Raw wLength as parsed.
    reg p_wlen : Word[16] on clk {
        initial it <= 0w16
        it <= when {
            case st == #Parse => word(rq7, rq6)
            else => it
        }
    }
    //> GET_DESCRIPTOR with a valid select.
    reg p_is_desc : Bit on clk {
        initial it <= false
        it <= when {
            case st == #Parse => (rq1 == 0x06w8) && (new_sel != 7w3)
            else => it
        }
    }
    //> GET_STATUS (device).
    reg p_is_get_status : Bit on clk {
        initial it <= false
        it <= when {
            case st == #Parse => (rq1 == 0w8) && (rq0 == 0x80w8)
            else => it
        }
    }
    //> SET_ADDRESS.
    reg p_is_set_addr : Bit on clk {
        initial it <= false
        it <= when {
            case st == #Parse => rq1 == 0x05w8
            else => it
        }
    }
    //> SET_CONFIGURATION (value 0 or 1).
    reg p_is_set_cfg : Bit on clk {
        initial it <= false
        it <= when {
            case st == #Parse => (rq1 == 0x09w8)
                && ((rq2 == 0x01w8) || (rq2 == 0w8))
            else => it
        }
    }
    //> SET_CONTROL_LINE_STATE.
    reg p_is_cls : Bit on clk {
        initial it <= false
        it <= when {
            case st == #Parse => (rq1 == 0x22w8) && (rq0 == 0x21w8)
            else => it
        }
    }
    //> Decoded request is supported at all.
    reg p_valid : Bit on clk {
        initial it <= false
        it <= when {
            case st == #Parse => ((rq1 == 0x06w8) && (new_sel != 7w3))
                || ((rq1 == 0w8) && (rq0 == 0x80w8))
                || (rq1 == 0x05w8)
                || ((rq1 == 0x09w8) && ((rq2 == 0x01w8) || (rq2 == 0w8)))
                || ((rq1 == 0x22w8) && (rq0 == 0x21w8))
            else => it
        }
    }

    //> Side effects latched in PARSE, tagged per request so only the
    //> OWNING transfer's status stage applies them (without the tags,
    //> any control read's status stage would latch addr_pending = 0
    //> and wipe dev_addr at completion).

    //> SET_ADDRESS value, applied at this transfer's status completion.
    reg addr_pending : Word[7] on clk {
        initial it <= 0w7
        it <= when {
            case rst || bus_reset => 0w7
            case st == #Parse => rq2[7..0]
            else => it
        }
    }
    //> SET_CONFIGURATION value.
    reg cfg_pending : Bit on clk {
        initial it <= false
        it <= when {
            case rst || bus_reset => false
            case st == #Parse => rq2 == 0x01w8
            else => it
        }
    }
    //> This transfer IS a SET_ADDRESS.
    reg pend_addr : Bit on clk {
        initial it <= false
        it <= when {
            case rst || bus_reset => false
            case st == #Parse => rq1 == 0x05w8
            else => it
        }
    }
    //> This transfer IS a SET_CONFIGURATION.
    reg pend_cfg : Bit on clk {
        initial it <= false
        it <= when {
            case rst || bus_reset => false
            case st == #Parse => (rq1 == 0x09w8)
                && ((rq2 == 0x01w8) || (rq2 == 0w8))
            else => it
        }
    }

    // ---- compute-stage registers (EP_SETUP: route flags -> one-hot) --
    //> The routed one-hot action EP_ARM applies: 0 STALL, 1 STATUS_I
    //> (no-data control write), 2 GET_STATUS, 3 RCV_DATA
    //> (GET_DESCRIPTOR data stage).  The only place the request
    //> routing tree runs, landing on ONE register -- not on datapath
    //> clock enables.
    reg p_action : Word[3] on clk {
        initial it <= 0w3
        it <= when {
            case rst || bus_reset => 0w3
            case st == #Setup => when {
                case !p_valid => 0w3
                case p_is_set_addr || p_is_set_cfg || p_is_cls => 1w3
                case p_is_get_status => 2w3
                else => 3w3
            }
            else => it
        }
    }
    //> Request wLength == 0.
    reg p_wlen0 : Bit on clk {
        initial it <= false
        it <= when {
            case rst || bus_reset => false
            case st == #Setup => w_length == 0w16
            else => it
        }
    }
    //> GET_DESCRIPTOR direction (IN -> status stage is OUT, and vice
    //> versa) -- rq0[7].
    reg p_desc_in : Bit on clk {
        initial it <= false
        it <= when {
            case rst || bus_reset => false
            case st == #Setup => rq0[7]
            else => it
        }
    }
    //> Descriptor data-stage length, min(wLength, desc_len(p_sel))
    //> PRECOMPUTED in EP_SETUP: the 15-bit compare against dlen was a
    //> full carry chain ending at remain's clock enable.  dlen <= 75 <
    //> 128, so the compare only needs the low bits: wLength >= 128
    //> means the descriptor length wins outright.
    reg p_dremain_r : Word[7] on clk {
        initial it <= 0w7
        it <= when {
            case st == #Setup => when {
                case any(p_wlen[15..7]) => dlen
                case p_wlen[7..0] < dlen => p_wlen[7..0]
                else => dlen
            }
            else => it
        }
    }

    // ---- the FSM and datapath -----------------------------------------
    //> Transfer state.  Every reg below is the priority chain the
    //> Verilog if/else-if tree encoded: reset, then tk_setup (SETUP
    //> aborts any transfer in progress, re-initializing the toggle),
    //> then the state cases.
    reg st : Ep0State on clk {
        initial it <= #Idle
        it <= when {
            case rst || bus_reset => #Idle
            case tk_setup => #RcvReq
            case it == #RcvReq => mux(req_acc_r, #Parse, it)
            case it == #Parse  => #Setup
            case it == #Setup  => #Arm
            case it == #Arm => when {
                // no-data control write: straight to the status IN
                case p_action == 1w3 => #StatusI
                // GET_STATUS: wLength 0 is a read whose status stage
                // is OUT; else a (<= 2 byte) data stage
                case p_action == 2w3 => mux(p_wlen0, #StatusO, #Send)
                // GET_DESCRIPTOR: ditto, direction-dependent
                case p_action == 3w3 => mux(p_wlen0,
                    mux(p_desc_in, #StatusO, #StatusI), #Send)
                else => #Stall
            }
            case it == #Send => mux(tk_in, #WaitAck, it)
            case it == #WaitAck => when {
                case hs_ack => mux(send_zlp_r, #Idle,
                    mux(last_r, #StatusO, #Send))
                // host retried the IN token (no ACK seen): re-arm the
                // same packet (base/remain/tog unchanged)
                case tk_in => mux(send_zlp_r, #StatusI, #Send)
                else => it
            }
            case it == #StatusI => mux(tk_in, #WaitAck, it)
            case it == #StatusO => mux(sto_acc_r, #Idle, it)
            else => it
        }
    }

    //> 1 => the next device data PID is DATA1.  Re-initialized to 0
    //> by SETUP (the SETUP data stage is DATA0), set for the data
    //> stage of a control read, toggled per accepted data packet.
    reg tog : Bit on clk {
        initial it <= false
        it <= when {
            case rst || bus_reset => false
            case tk_setup => false
            // data stage armed (GET_STATUS / GET_DESCRIPTOR): the
            // first device data packet is DATA1
            case (st == #Arm) && ((p_action == 2w3) || (p_action == 3w3)) => true
            // data packet accepted: advance the toggle
            case (st == #WaitAck) && hs_ack && !send_zlp_r => !it
            else => it
        }
    }

    //> Data stage bytes left to send.
    reg remain : Word[7] on clk {
        initial it <= 0w7
        it <= when {
            case rst || bus_reset => 0w7
            // GET_STATUS: at most 2 bytes
            case (st == #Arm) && (p_action == 2w3) && !p_wlen0
                => mux(p_wlen[7..0] > 2w7, 2w7, p_wlen[7..0])
            // GET_DESCRIPTOR: the precomputed min(wLength, dlen)
            case (st == #Arm) && (p_action == 3w3) && !p_wlen0
                => p_dremain_r
            // data packet accepted: consume its bytes
            case (st == #WaitAck) && hs_ack && !send_zlp_r => it - send_len
            else => it
        }
    }

    //> Bytes in the in-flight packet.
    reg send_len : Word[7] on clk {
        initial it <= 0w7
        it <= when {
            case rst || bus_reset => 0w7
            case (st == #Send) && tk_in => mux(remain > 64w7, 64w7, remain)
            case (st == #StatusI) && tk_in => 0w7
            else => it
        }
    }

    //> Current send offset into the descriptor (base + tx_addr is the
    //> ROM byte usb::TxPhy pulls).
    reg base : Word[10] on clk {
        initial it <= 0w10
        it <= when {
            case rst || bus_reset => 0w10
            case tk_setup => 0w10
            case (st == #Arm) && ((p_action == 2w3) || (p_action == 3w3))
                && !p_wlen0 => 0w10
            // data packet accepted: advance by the accepted length
            case (st == #WaitAck) && hs_ack && !send_zlp_r
                => it + word(0w3, send_len)
            else => it
        }
    }

    //> Current descriptor select.
    reg sel : Word[3] on clk {
        initial it <= 0w3
        it <= when {
            case rst || bus_reset => 0w3
            case (st == #Arm) && (p_action == 2w3) => 6w3
            case (st == #Arm) && (p_action == 3w3) => p_sel
            else => it
        }
    }

    //> Arm-time precomputed packet flags: the EP_WAIT_ACK decisions
    //> read these 1-bit registers instead of comparing
    //> send_len/remain.  send_zlp_r: armed packet is the status ZLP
    //> (len 0).  last_r: armed packet completes the data stage.
    reg send_zlp_r : Bit on clk {
        initial it <= false
        it <= when {
            case rst || bus_reset => false
            case (st == #Send) && tk_in => remain == 0w7
            case (st == #StatusI) && tk_in => true
            else => it
        }
    }
    reg last_r : Bit on clk {
        initial it <= false
        it <= when {
            case rst || bus_reset => false
            case (st == #Send) && tk_in => remain < 65w7
            case (st == #StatusI) && tk_in => false
            else => it
        }
    }

    //> Device address / configuration, applied at the OWNING
    //> transfer's status completion (pend_addr / pend_cfg tags).
    reg dev_addr_r : Word[7] on clk {
        initial it <= 0w7
        it <= when {
            case rst || bus_reset => 0w7
            case (st == #WaitAck) && hs_ack && send_zlp_r && pend_addr
                => addr_pending
            case (st == #StatusO) && sto_acc_r && pend_addr => addr_pending
            else => it
        }
    }
    reg configured_r : Bit on clk {
        initial it <= false
        it <= when {
            case rst || bus_reset => false
            case (st == #WaitAck) && hs_ack && send_zlp_r && pend_cfg
                => cfg_pending
            case (st == #StatusO) && sto_acc_r && pend_cfg => cfg_pending
            else => it
        }
    }

    // ---- tx response registers ----------------------------------------
    //> resp_req is default low, pulsed by each arm; the params are
    //> held per-branch (unchanged between pulses, exactly as the
    //> vendored body -- the arbiter latches them on the pulse).
    reg resp_req_r : Bit on clk {
        initial it <= false
        it <= when {
            case rst || bus_reset => false
            case tk_setup => false
            case (st == #RcvReq) && req_acc_r => true
            case (st == #Send) && tk_in => true
            case (st == #StatusI) && tk_in => true
            case (st == #StatusO) && sto_acc_r => true
            case (st == #Stall) && (dt_valid || tk_in) => true
            else => false
        }
    }
    reg resp_pid_r : Word[4] on clk {
        initial it <= 0w4
        it <= when {
            case (st == #RcvReq) && req_acc_r => 2w4
            case (st == #Send) && tk_in => mux(tog, 11w4, 3w4)
            case (st == #StatusI) && tk_in => 11w4
            case (st == #StatusO) && sto_acc_r => 2w4
            case (st == #Stall) && (dt_valid || tk_in) => 14w4
            else => it
        }
    }
    reg resp_len_r : Word[7] on clk {
        initial it <= 0w7
        it <= when {
            case (st == #RcvReq) && req_acc_r => 0w7
            case (st == #Send) && tk_in => mux(remain > 64w7, 64w7, remain)
            case (st == #StatusI) && tk_in => 0w7
            case (st == #StatusO) && sto_acc_r => 0w7
            case (st == #Stall) && (dt_valid || tk_in) => 0w7
            else => it
        }
    }
    reg resp_sel_r : Word[3] on clk {
        initial it <= 0w3
        it <= when {
            case (st == #RcvReq) && req_acc_r => 0w3
            case (st == #Send) && tk_in => sel
            case (st == #StatusI) && tk_in => 0w3
            else => it
        }
    }
    reg resp_base_r : Word[10] on clk {
        initial it <= 0w10
        it <= when {
            case (st == #RcvReq) && req_acc_r => 0w10
            case (st == #Send) && tk_in => base
            case (st == #StatusI) && tk_in => 0w10
            else => it
        }
    }
}

//> usb_serial -- EP1 bulk endpoint protocol, migrated out of
//> ext/usb_uart.sv.  Cycle-exact translation: data toggles + ACK/NAK/
//> ARM decisions only -- data movement lives in the core top (FIFOs,
//> snapshot RAM, tx PHY mux).  IN packets are snapshotted from the
//> tx FIFO into the snapshot RAM at arm time, so an unacknowledged
//> packet is retransmitted byte-identically (same data pid) until
//> the host ACKs.  Data toggles reset on bus reset and
//> SET_CONFIGURATION (USB 2.0 §9.1.1.5).
//>
//> The OUT data accept/reject is REGISTERED one clk after arrival
//> (dt_acc/dt_rej): the room check (an add+compare crossing the rx
//> FIFO count) and the response/toggle registers then land in
//> separate cycles (+1 clk response latency is well inside the
//> device turnaround budget).  The core top streams the payload on
//> the serial ACK pulse.
mod Serial {
    //> 48 MHz clock: 4 clk cycles per USB FS bit.
    incoming clk : Clock
    //> Synchronous reset, active high (core reset from UsbController).
    incoming rst : Bit
    //> Bus reset strobe (via the core): flushes the protocol state.
    incoming bus_reset : Bit
    //> Pulse: SET_CONFIGURATION completed (reset the bulk toggles).
    incoming set_cfg : Bit
    //> Router-gated token strobes (address + endpoint 1 matched):
    //> IN (host wants a bulk-IN packet).
    incoming tk_in : Bit
    //> OUT (a data packet for EP1 follows).
    incoming tk_out : Bit
    //> Router-gated data packet strobe: an armed OUT to EP1 (NOT
    //> delayed a clk, unlike EP0's -- the accept decision below is
    //> itself registered).
    incoming dt_valid : Bit
    //> Data packet PID.
    incoming dt_pid : Word[4]
    //> Data packet payload byte count.
    incoming dt_len : Word[7]
    //> Data packet CRC16 verdict.
    incoming dt_crc_ok : Bit
    //> Router-gated handshake strobe: our in-flight packet was ACKed.
    incoming hs_ack : Bit
    //> Tx FIFO status: nothing queued for the host.
    incoming txfifo_empty : Bit
    //> Tx FIFO fill (for arm sizing: min(count, 64) bytes).
    incoming txfifo_count : Word[7]
    //> 1: the whole OUT packet fits the rx FIFO (core-side add+compare;
    //> the decision here is registered one clk after arrival).
    incoming rx_room : Bit
    //> Free slots in the tx FIFO (unused -- kept for interface
    //> completeness with the old vendored port).
    incoming tx_room : Word[7]

    //> Response request (1-clk pulse).
    outgoing resp_req : Bit {
        it := resp_req_r
    }
    //> Response PID: DATA0 3 / DATA1 B / ACK 2 / NAK A.
    outgoing resp_pid : Word[4] {
        it := resp_pid_r
    }
    //> Response byte count.
    outgoing resp_len : Word[7] {
        it := resp_len_r
    }
    //> 1: a NEW packet was armed -- the core must snapshot len bytes
    //> from the tx FIFO (the response is the snapshot's first read).
    outgoing resp_fresh : Bit {
        it := resp_fresh_r
    }
    //> Router hint: an OUT data packet is expected (route dt_valid here).
    outgoing ser_busy : Bit {
        it := armed_out
    }
    //> Router hint: our data packet is in flight (route the ACK here).
    outgoing ser_ack_wait : Bit {
        it := pkt_pending
    }

    unused tx_room
    // The packet payload byte count (unused here: the whole packet is
    // accepted or rejected on rx_room; the length lives in the core's
    // rx push).
    unused dt_len

    // ---- combinational helpers -------------------------------------------
    //> The data pid the armed OUT expects (toggle-dependent).
    wire exp_pid : Word[4] {
        it := mux(tog_rx, 11w4, 3w4)
    }
    //> Arm-a-new-packet condition: IN token, no unacknowledged packet,
    //> and something to send.
    wire arm_new : Bit {
        it := tk_in && !pkt_pending && !txfifo_empty
    }
    //> min(count, 64): the fresh-arm payload length.
    wire load_len : Word[7] {
        it := mux(txfifo_count > 64w7, 64w7, txfifo_count)
    }

    // ---- protocol registers ----------------------------------------------
    //> TX data toggle: 0 => the next device data pid is DATA0.
    //> Toggled by the ACK of our in-flight packet.
    reg tog_tx : Bit on clk {
        initial it <= false
        it <= when {
            case rst || bus_reset || set_cfg => false
            case hs_ack && pkt_pending => !it
            else => it
        }
    }
    //> RX data toggle: 0 => the next host data pid is DATA0.
    //> Toggled per accepted OUT packet.
    reg tog_rx : Bit on clk {
        initial it <= false
        it <= when {
            case rst || bus_reset || set_cfg => false
            case dt_acc => !it
            else => it
        }
    }
    //> The snapshot holds an unacknowledged IN packet (retransmit on
    //> retry, same pid; forgotten at the ACK).
    reg pkt_pending : Bit on clk {
        initial it <= false
        it <= when {
            case rst || bus_reset || set_cfg => false
            case hs_ack && it => false
            case arm_new => true
            else => it
        }
    }
    //> The snapshotted packet's byte count.
    reg pkt_len : Word[7] on clk {
        initial it <= 0w7
        it <= when {
            case rst || bus_reset || set_cfg => 0w7
            case arm_new => load_len
            else => it
        }
    }
    //> An OUT token armed this endpoint: its data packet is expected
    //> next (cleared at the packet's arrival, registered one clk
    //> later via dt_acc/dt_rej -- the arrival-cycle clear below is
    //> exact: the token precedes its data packet).
    reg armed_out : Bit on clk {
        initial it <= false
        it <= when {
            case rst || bus_reset || set_cfg => false
            case it && dt_valid => false
            case tk_out => true
            else => it
        }
    }
    //> Registered accept: good CRC, expected pid, room in the rx
    //> FIFO (one clk after the data packet strobe).
    reg dt_acc : Bit on clk {
        initial it <= false
        it <= when {
            case rst || bus_reset || set_cfg => false
            else => armed_out && dt_valid && dt_crc_ok
                && (dt_pid == exp_pid) && rx_room
        }
    }
    //> Registered reject: anything else that arrives armed.
    reg dt_rej : Bit on clk {
        initial it <= false
        it <= when {
            case rst || bus_reset || set_cfg => false
            else => armed_out && dt_valid
                && !(dt_crc_ok && (dt_pid == exp_pid) && rx_room)
        }
    }

    // ---- response registers -----------------------------------------------
    //> resp_req is default low, pulsed by each arm/accept/reject; the
    //> params are held per-branch (the core's arbiter latches them on
    //> the pulse).  The accept/reject overrides take priority over
    //> the token arm exactly as the vendored body's assignment order.
    reg resp_req_r : Bit on clk {
        initial it <= false
        it <= when {
            case rst || bus_reset || set_cfg => false
            case dt_acc => true
            case dt_rej => true
            case tk_in  => true
            else => false
        }
    }
    reg resp_pid_r : Word[4] on clk {
        initial it <= 0w4
        it <= when {
            case dt_acc => 2w4
            case dt_rej => 10w4
            case tk_in => when {
                // retransmit the unacknowledged packet, same pid
                case pkt_pending   => mux(tog_tx, 11w4, 3w4)
                // arm a new packet from the tx FIFO
                case !txfifo_empty => mux(tog_tx, 11w4, 3w4)
                // nothing to send
                else => 10w4
            }
            else => it
        }
    }
    reg resp_len_r : Word[7] on clk {
        initial it <= 0w7
        it <= when {
            case dt_acc => 0w7
            case dt_rej => 0w7
            case tk_in => when {
                case pkt_pending   => pkt_len
                case !txfifo_empty => load_len
                else => 0w7
            }
            else => it
        }
    }
    //> The fresh-arm strobe: deliberately NOT reset (the vendored body
    //> left it out of the reset branch, so it holds through reset;
    //> the core only ever consumes it alongside a resp_req pulse).
    reg resp_fresh_r : Bit on clk {
        initial it <= false
        it <= when {
            case rst || bus_reset || set_cfg => it
            case arm_new => true
            else => false
        }
    }
}

//> usb_tx_phy -- packet records back to pads (USB 2.0 §7.1.x), the
//> mirror of usb::RxPhy, migrated out of ext/usb_uart.sv.  Drives a
//> complete FS packet: sync pattern, NRZI-encoded bit-stuffed data,
//> and EOP, plus the output enable that connects the driver to the
//> pads only while transmitting.
//>
//> Cycle-exact translation of the original always block (same
//> discipline as usb::RxPhy): every reg's next-state below is the
//> same priority chain the Verilog case/if tree encoded, including
//> the registered one-clk-ahead decision flags (s_lt_end_r,
//> guard_last_r, bit_end_r, crc_load_r) that keep the big compare
//> cones off the single-cycle engine path.  Timeline conventions
//> (load-bearing -- see wiki/usb-tx-phy.md and the original comments
//> preserved on each reg):
//>
//>   - the level DURING bit time T encodes raw bit f(S_T - 1); the
//>     transition for a 0 bit appears at that bit time's start;
//>   - s is the raw bit index of the NEXT bit time (it advances at
//>     bit-time boundaries, i.e. it names the bit whose encoding
//>     follows); stuffed bit times do not advance it;
//>   - the CRC16 instance consumes each payload raw bit exactly once,
//>     at btc==2 of the bit time whose encoding drives that bit
//>     (stuffed bit times are gated off via cur_stuff).
enum type TxPhyState {
    Idle  = 0b000w3
    Guard = 0b001
    Data  = 0b010
    Eop0  = 0b011
    EopJ  = 0b100
}

mod TxPhy {
    //> 48 MHz clock: 4 clk cycles per USB FS bit.
    incoming clk : Clock
    //> Synchronous reset (core reset from UsbController).
    incoming rst : Bit
    //> 1-clk pulse: latch tx_pid/tx_len and begin the packet.
    incoming tx_start : Bit
    //> PID nibble (the upper complement is generated here).
    incoming tx_pid : Word[4]
    //> Payload byte count, 0..64 (0 => zero-length packet).
    incoming tx_len : Word[7]
    //> Producer payload byte, combinational at tx_addr.  The engine is
    //> a one-bit-time lookahead: tx_addr leads the consumed bit by one
    //> bit time, and tx_byte_r (below) re-times it into the engine.
    incoming tx_byte : Word[8]

    //> s - 16: the payload bit index (only meaningful for payload
    //> raw bits; a named wire because the Verilog emitter cannot
    //> part-select a parenthesized expression).
    wire s_m16 : Word[10] {
        it := s - 16w10
    }
    //> s - 9: the preload-hint raw index (see tx_addr_next).
    wire s_m9 : Word[10] {
        it := s - 9w10
    }
    //> Byte index currently being consumed (a pure bit-slice of s, no
    //> state term; only meaningful while payload bits are read).
    outgoing tx_addr : Word[7] {
        it := s_m16[10..3]
    }
    //> Byte index the NEXT bit time will consume (preload hint):
    //> (s-9)>>3 is byte-stable across every bit time of a byte, so a
    //> registered copy can address the source one byte ahead without
    //> flipping mid-byte.
    outgoing tx_addr_next : Word[7] {
        it := s_m9[10..3]
    }
    //> A packet is in flight (any state but Idle).
    outgoing tx_busy : Bit {
        it := state != #Idle
    }
    //> 1-clk pulse when the bus is released (end of EOP).
    outgoing tx_done : Bit {
        it := done_r
    }
    //> D+ drive level (meaningful only while output_enable is high;
    //> the Eop0 state drives both lines low = SE0 regardless of lvl).
    outgoing dp : Bit {
        it := mux(state == #Eop0, false, mux(lvl, false, true))
    }
    //> D- drive level (ditto).
    outgoing dn : Bit {
        it := mux(state == #Eop0, false, lvl)
    }
    //> Output enable: drive the pads (SB_IO OUTPUT_ENABLE via UsbPads).
    outgoing output_enable : Bit {
        it := oe_r
    }

    //> The tx_start pulse, decoded against the FSM (used by every
    //> packet-geometry register).
    wire arm : Bit {
        it := (state == #Idle) && tx_start
    }
    //> The guard-to-data transition edge (the registered guard_last_r
    //> flag decoded against the FSM).
    wire guard_last : Bit {
        it := (state == #Guard) && guard_last_r
    }

    //> The armed PID is a data packet (PID[1:0] == 11): it carries a
    //> payload + CRC16.  Handshake/token PIDs skip both.
    wire is_data : Bit {
        it := pid_r[2..0] == 0b11w2
    }
    //> Same test on the tx_start INPUT (not pid_r): total_bits_r is
    //> computed at the arm edge, one cycle before pid_r is loaded.
    wire tx_pid_data : Bit {
        it := tx_pid[2..0] == 0b11w2
    }
    //> s mod 8: the bit index within the current byte.  For the PID
    //> nibble selector (s in 8..15) and the payload bit selector
    //> ((s-16) & 7 == s mod 8, so one index serves both).
    wire byte_bit_idx : Word[3] {
        it := s[3..0]
    }
    //> The complemented-nibble selector: byte_bit_idx - 4 (0..3 when
    //> byte_bit_idx is 4..7).  A named wire because the Verilog
    //> emitter cannot part-select a parenthesized expression.
    wire pid_comp_idx : Word[3] {
        it := byte_bit_idx - 4w3
    }
    //> raw bit f(s): sync (00000001, bit 7 is the trailing 1), PID
    //> byte ({~pid[3:0], pid[3:0]}, LSB first), payload (LSB first),
    //> CRC16 wire bits shifted MSB-first out of crc_shift.  Evaluated
    //> against the REGISTERED s (stable for the whole 4-clk bit time)
    //> and pipelined into raw_bit_r, which splits the compare/select
    //> chain from the single-cycle engine path.
    wire raw_bit : Bit {
        it := mux(s < 8w10, s == 7w10,
            mux(s < 16w10,
                mux(byte_bit_idx < 4w3,
                    pid_r[dyn byte_bit_idx[2..0]],
                    !pid_r[dyn pid_comp_idx[2..0]]),
                mux(is_data && (s < payload_end_r),
                    tx_byte_r[dyn byte_bit_idx],
                    mux(is_data,
                        crc_shift[15],
                        false))))
    }
    //> The CRC16 wire bits, complemented (wire convention:
    //> crc_wire[i] = ~crc[W-1-i]; the bit-reverse is the MSB-first
    //> shift-out of crc_shift).
    wire crc_wire : Word[16] {
        it := crc16.crc ^ 65535w16
    }

    // ---- decision flags, registered one clk ahead --------------------

    //> (s < total_bits_r) REGISTERED one cycle ahead: the 10-bit
    //> compare is a carry chain, and it fed cur_stuff's D-cone every
    //> bit time (the tx-engine critical path).  s changes only at
    //> bit-time edges, so the flag captured the previous cycle is
    //> exact at the decision edge -- +0 clk latency, the compare cone
    //> ends at its own register.
    reg s_lt_end_r : Bit on clk {
        initial it <= false
        it <= when {
            case rst => false
            else     => s < total_bits_r
        }
    }
    //> Final S_GUARD cycle (gcnt == 6), REGISTERED one clk ahead: the
    //> bit-time phase decisions read a 1-bit register instead of a
    //> compare cone (the raw compares chained through 4 enable LUTs
    //> into s's clock enable -- the old vir-flow critical path).
    reg guard_last_r : Bit on clk {
        initial it <= false
        it <= when {
            case rst => false
            else     => (state == #Guard) && (gcnt == 6w3)
        }
    }
    //> Last clk of a bit time (Data/Eop0/EopJ), REGISTERED one clk
    //> ahead from btc == 2 -- same de-coning as guard_last_r.
    reg bit_end_r : Bit on clk {
        initial it <= false
        it <= when {
            case rst => false
            else => ((state == #Data) || (state == #Eop0)
                || (state == #EopJ)) && (btc == 2w2)
        }
    }
    //> 1 while s holds the last payload raw bit's index
    //> (payload_end_r - 1): arms the crc_shift load one cycle later,
    //> at the edge that consumes the last payload raw bit (the LFSR
    //> is final there: its advance fired at that bit time's btc==2).
    //> Stays 1 through a following stuffed bit time (s does not
    //> advance); the re-load is harmless -- the LFSR is static there,
    //> so the captured value is identical.
    reg crc_load_r : Bit on clk {
        initial it <= false
        it <= when {
            case rst => false
            else     => (state == #Data) && (s == payload_end_m1_r)
        }
    }

    // ---- packet geometry, registered at arm -------------------------

    //> Payload raw-bit end index: 16 + 8*tx_len, registered at tx_start
    //> (payload raw bits are f(16) .. f(payload_end_r - 1)).
    reg payload_end_r : Word[10] on clk {
        initial it <= 0w10
        it <= when {
            case rst => 0w10
            case arm => word(tx_len, 0w3) + 16w10
            else     => it
        }
    }
    //> payload_end_r - 1, precomputed at arm (the -1 would otherwise
    //> sit in crc_load_r's per-cycle compare).
    reg payload_end_m1_r : Word[10] on clk {
        initial it <= 0w10
        it <= when {
            case rst => 0w10
            case arm => word(tx_len, 0w3) + 15w10
            else     => it
        }
    }
    //> Total bit-time count: payload_end_r + 16 CRC wire bits for data
    //> PIDs, + 0 for everything else.  Registered at tx_start.
    reg total_bits_r : Word[10] on clk {
        initial it <= 0w10
        it <= when {
            case rst => 0w10
            case arm => word(tx_len, 0w3) + mux(tx_pid_data, 32w10, 16w10)
            else     => it
        }
    }

    // ---- the engine --------------------------------------------------

    //> FSM: Idle (bus released, waiting for tx_start) -> Guard (8 clks
    //> = 2 bit times inter-packet guard, bus still released) -> Data
    //> (the bit-time engine) -> Eop0 (SE0, 2 bit times) -> EopJ (J for
    //> the last bit time, then release) -> Idle.
    reg state : TxPhyState on clk {
        initial it <= #Idle
        it <= when {
            case rst                                => #Idle
            case (it == #Idle) && tx_start          => #Guard
            case (it == #Guard) && guard_last_r     => #Data
            case (it == #Data) && bit_end_r && !stuff_pending && !s_lt_end_r => #Eop0
            case (it == #Eop0) && bit_end_r && (ecnt == 1w3) => #EopJ
            case (it == #EopJ) && bit_end_r         => #Idle
            else                                    => it
        }
    }
    //> Clk phase within the current bit time (0..3).  Holds during
    //> Idle/Guard; zeroed at every bit-time boundary.
    reg btc : Word[2] on clk {
        initial it <= 0w2
        it <= when {
            case rst => 0w2
            case guard_last => 0w2
            case ((state == #Data) || (state == #Eop0) || (state == #EopJ)) && bit_end_r => 0w2
            case (state == #Data) || (state == #Eop0) || (state == #EopJ) => it + 1w2
            else => it
        }
    }
    //> Guard clk counter (8 clks = 2 bit times of bus release between
    //> packets).
    reg gcnt : Word[3] on clk {
        initial it <= 0w3
        it <= when {
            case rst => 0w3
            case arm => 0w3
            case (state == #Guard) && !guard_last_r => it + 1w3
            else => it
        }
    }
    //> EOP bit-time counter: Eop0 lasts 2 bit times (ecnt 0 and 1).
    reg ecnt : Word[3] on clk {
        initial it <= 0w3
        it <= when {
            case rst => 0w3
            case (state == #Data) && bit_end_r && !stuff_pending && !s_lt_end_r => 0w3
            case (state == #Eop0) && bit_end_r && (it != 1w3) => it + 1w3
            else => it
        }
    }
    //> Raw bit index of the NEXT bit time.  Starts at 1 (bit time 0's
    //> encoding -- the J->K sync transition -- is computed at the
    //> guard->data edge); advances only on raw bit times.
    reg s : Word[10] on clk {
        initial it <= 0w10
        it <= when {
            case rst => 0w10
            case guard_last => 1w10
            case (state == #Data) && bit_end_r && !stuff_pending && s_lt_end_r => it + 1w10
            else => it
        }
    }
    //> Armed PID.
    reg pid_r : Word[4] on clk {
        initial it <= 0w4
        it <= when {
            case rst => 0w4
            case arm => tx_pid
            else => it
        }
    }
    //> Armed payload byte count.
    reg len_r : Word[7] on clk {
        initial it <= 0w7
        it <= when {
            case rst => 0w7
            case arm => tx_len
            else => it
        }
    }
    //> Current drive level: 0 = J, 1 = K.  Toggled for a 0 raw bit at
    //> the edge that consumes it (NRZI: the transition appears at the
    //> next bit time's start); forced low entering EopJ.
    reg lvl : Bit on clk {
        initial it <= false
        it <= when {
            case rst => false
            case guard_last => !it
            case (state == #Data) && bit_end_r && stuff_pending => !it
            case (state == #Data) && bit_end_r && s_lt_end_r => mux(raw_bit_r, it, !it)
            case (state == #Eop0) && bit_end_r && (ecnt == 1w3) => false
            else => it
        }
    }
    //> Consecutive raw-1s run counter (stuffing).  Restarted fresh at
    //> the PID (s == 8); the 6th one arms stuff_pending and resets the
    //> count; a 0 clears it.
    reg ones : Word[3] on clk {
        initial it <= 0w3
        it <= when {
            case rst => 0w3
            case guard_last => 0w3
            case (state == #Data) && bit_end_r && stuff_pending => 0w3
            case (state == #Data) && bit_end_r && s_lt_end_r && (s == 8w10) => 0w3
            case (state == #Data) && bit_end_r && s_lt_end_r && raw_bit_r && (it == 5w3) => 0w3
            case (state == #Data) && bit_end_r && s_lt_end_r && raw_bit_r => it + 1w3
            case (state == #Data) && bit_end_r && s_lt_end_r => 0w3
            else => it
        }
    }
    //> The NEXT bit time is a stuffed 0 (armed when the 6th consecutive
    //> one is consumed).  Consumed at the next bit-time edge: that edge
    //> toggles lvl (the stuffed 0's transition), advances neither s nor
    //> crc_shift, and re-arms the run counter.
    reg stuff_pending : Bit on clk {
        initial it <= false
        it <= when {
            case rst => false
            case guard_last => false
            case (state == #Data) && bit_end_r && it => false
            case (state == #Data) && bit_end_r && s_lt_end_r && raw_bit_r && (ones == 5w3) => true
            else => it
        }
    }
    //> The CURRENT bit time is a stuffed 0: gates the CRC16 advance off
    //> for this bit time (a stuffed bit consumes no raw bit).
    reg cur_stuff : Bit on clk {
        initial it <= false
        it <= when {
            case rst => false
            case guard_last => false
            case (state == #Data) && bit_end_r && stuff_pending => true
            case (state == #Data) && bit_end_r => false
            else => it
        }
    }
    //> Pad output enable: raised entering Data, dropped at the EOP's
    //> last bit time (bus release).
    reg oe_r : Bit on clk {
        initial it <= false
        it <= when {
            case rst => false
            case guard_last => true
            case (state == #EopJ) && bit_end_r => false
            else => it
        }
    }
    //> 1-clk tx_done pulse at the EOP's last bit time.
    reg done_r : Bit on clk {
        initial it <= false
        it <= (state == #EopJ) && bit_end_r
    }

    // ---- CRC16 wire-bit shift register -------------------------------

    //> The CRC wire bits are SHIFTED out of this register instead of
    //> muxed live from the LFSR: the raw-bit CRC branch would otherwise
    //> compute 15 - (s - payload_end_r) -- a per-cycle 10-bit subtract
    //> + compare cone off the crc16 flops (the old vir-flow critical
    //> path).  Loaded with the final wire-ordered CRC (crc_wire) at the
    //> edge that consumes the last payload raw bit, then shifted right
    //> (MSB first) once per consumed raw bit; raw_bit's CRC branch is a
    //> single register bit.  Stuffed bit times don't shift; a re-load
    //> on a following stuffed edge is harmless (see crc_load_r).
    reg crc_shift : Word[16] on clk {
        initial it <= 0w16
        it <= when {
            case rst => 0w16
            case bit_end_r && crc_load_r => crc_wire
            case (state == #Data) && bit_end_r && !stuff_pending && s_lt_end_r => word(it[15..0], false)
            else => it
        }
    }

    // ---- producer byte pipeline + CRC instance -----------------------

    //> Producer byte pipeline: tx_addr leads the engine's read by one
    //> bit time (s advances at bit-time edges, the byte is stable for
    //> the whole 4-clk bit time), so this register stage splits the big
    //> producer mux (64:1 snapshot / descriptor ROM) out of the
    //> single-cycle engine path.  The engine reads tx_byte_r only.
    //> Loaded once per payload byte: during bit time k, s = k+1, and
    //> bit 0 of byte b (raw index 16+8b) is CONSUMED at the end of the
    //> previous byte's last bit time -- so the reload fires when
    //> s[2:0]==0 (s = 16+8b, during byte b-1's bit 7); the registered
    //> producer holds THIS byte's data from the previous byte's fetch
    //> window, and the single load per byte keeps it stable through all
    //> eight bit times.
    reg tx_byte_r : Word[8] on clk {
        initial it <= 0w8
        it <= when {
            case (state == #Data) && (btc == 0w2) && (s[3..0] == 0w3) && (s >= 16w10) => tx_byte
            else => it
        }
    }
    //> raw_bit pipelined one clk: f(s) is evaluated against the
    //> registered s, and the engine reads raw_bit_r one clk later,
    //> which splits the compare/select chain and the stuff/NRZI tail
    //> into separate cycles.
    reg raw_bit_r : Bit on clk {
        initial it <= false
        it <= raw_bit
    }

    //> Payload CRC16 (usb::Crc16).  Re-seeded by tx_start; advances one
    //> serial bit at btc==2 of every non-stuffed bit time whose raw bit
    //> is a payload bit (16 <= s < payload_end_r); consumes raw_bit_r,
    //> i.e. exactly the bit the current bit time's encoding drives.
    mod crc16 of Crc16 {
        it.clk := clk
        it.rst := tx_start
        it.adv := (state == #Data) && (btc == 2w2) && !cur_stuff
            && is_data && (s >= 16w10) && (s < payload_end_r)
        it.din := raw_bit_r
    }
}

//> The two sync FIFOs over usb_fifo16x8 (ext/usb_uart.sv): thin
//> fixed-parameter wrappers so the Virdant side can instantiate them
//> as ext mods (Virdant ext mods cannot carry parameters).
//> Port/behavior contract (the usb_fifo16x8 header): wr_en and rd_en
//> are CALLER-gated (!full / !empty) -- the count terms never enter
//> the FIFO's own pointer/count enables (both call sites gate in the
//> register that produces the strobe).

//> The 16-deep x 8-bit tx FIFO (defaults: flop storage, RAM=0), with
//> the COMBINATIONAL head on rd_data.
ext mod TxFifo {
    //> 48 MHz clock.
    incoming clk : Clock
    //> Synchronous reset (both call sites pass rst || bus_reset).
    incoming rst : Bit
    //> Write enable (caller pre-gates with !full).
    incoming wr_en : Bit
    //> Write byte.
    incoming wr_data : Word[8]
    //> Pop enable (caller pre-gates with !empty).
    incoming rd_en : Bit
    //> The head byte, combinational.
    outgoing rd_data : Word[8]
    //> Bytes stored (0..16).
    outgoing count : Word[7]
    //> Full (count == 16).
    outgoing full : Bit
    //> Empty.
    outgoing empty : Bit
}

//> The 64-deep x 8-bit bulk-OUT rx FIFO (DEPTH=64, AW=6, RAM=1):
//> block-RAM storage with the head delayed one clk on rd_data (the
//> registered free-running read takes 512 flops and their per-byte
//> write-decode cones off the fabric).  DEPTH=64 is a documented
//> plan deviation: a max-size bulk-OUT packet must be absorbed
//> atomically under the "whole packet must fit" rule.
ext mod RxFifo {
    //> 48 MHz clock.
    incoming clk : Clock
    //> Synchronous reset.
    incoming rst : Bit
    //> Write enable (caller pre-gates with !full).
    incoming wr_en : Bit
    //> Write byte.
    incoming wr_data : Word[8]
    //> Pop enable (caller pre-gates with !empty).
    incoming rd_en : Bit
    //> The head byte, one clk after rd_en (registered read).
    outgoing rd_data : Word[8]
    //> Bytes stored (0..64).
    outgoing count : Word[7]
    //> Full (count == 64).
    outgoing full : Bit
    //> Empty.
    outgoing empty : Bit
}

//> The bulk-IN snapshot RAM (64x8 block RAM): at arm time the
//> snapshot loader pops min(count,64) bytes from the tx FIFO in
//> here, so an unacknowledged IN packet is retransmitted
//> byte-identically until the host ACKs.  A plain Virdant mod over
//> one iCE40 SB_RAM40_4K cell.  The 7-bit ports index a 64-entry
//> window of the cell's 256-deep space with the old out-of-range
//> semantics preserved: writes are gated to !wa[6] (>= 64 is a
//> no-op), and a read index >= 64 lands on entries 64..127, which
//> are NEVER written -- X in simulation, zero in the bitstream --
//> not an aliased byte from 0..63.  (The tx fetch index can lead
//> the consumed bytes during the packet tail; the fetched byte is
//> never sent because tx_len caps the PHY, so either value is
//> harmless, but fresh-X matches the vendored body's simulation
//> semantics exactly.)
mod SnapRam {
    //> 48 MHz clock.
    incoming clk : Clock
    //> Write enable (the loader's step strobe).
    incoming we : Bit
    //> Write address (the loader's index, 0..63; >= 64 is a no-op).
    incoming wa : Word[7]
    //> Write byte (the popped tx-FIFO head).
    incoming wd : Word[8]
    //> Read address (the tx byte fetch index; out of range reads X,
    //> exactly the vendored body).
    incoming ra : Word[7]
    //> Registered read data: mem[ra] as of the previous posedge.
    outgoing rd : Word[8]

    mod ram of ice40::SbRam40_4k {
        it.RCLK  := clk
        it.WCLK  := clk
        it.RCLKE := true
        it.WCLKE := true
        it.RE    := true
        it.WE    := we && !wa[6]
        it.WADDR := zext(wa)
        it.RADDR := zext(ra)
        it.WDATA := word(0w8, wd)
        it.MASK  := 0xFF00
        rd := it.RDATA[8..0]
    }
}

//> The descriptor ROM (256x8 initialized block RAM, registered
//> read): contiguous pages -- sel0 device@0 (18 B), sel1 config@18
//> (75 B), sel2 str0@93, sel3 str1@97 (10 B), sel4 str2@107 (28 B).
//> sel5 (line coding) and sel6 (status) are dynamic/trivial and
//> bypass the ROM.  The 256-byte initial block lives in the ext
//> body (ext/usb_uart.sv); a BRAM read replaces the desc_byte()
//> case cascade (a 128-deep case is ~20 ns of LUT chain; a BRAM
//> read is a register).
ext mod DescRom {
    //> 48 MHz clock.
    incoming clk : Clock
    //> ROM address (page start + transfer offset).
    incoming ra : Word[8]
    //> Registered read data: desc_rom[ra] as of the previous posedge.
    outgoing rd : Word[8]
}

//> usb_uart -- the core top, migrated out of ext/usb_uart.sv:
//> descriptor ROM plumbing, token router, response arbiter, bulk
//> snapshot loader, rx push, FIFOs + byte-stream loopback interface
//> (the EP0 / Serial / TxPhy / RxPhy / RxPacket instantiations live
//> here too).  Cycle-exact translation (same discipline as
//> usb::RxPacket / usb::Ep0): every reg's next-state is the priority
//> chain the Verilog if/else-if tree encoded, and every
//> registered-helper structure (the +1/+2-clk token strobes, the
//> registered EP0 data strobe, the countdown terminations) is
//> preserved -- see the original comments carried below and
//> wiki/usb-uart.md.
mod UsbUart {
    //> 48 MHz clock: 4 clk cycles per USB FS bit.
    incoming clk : Clock
    //> Synchronous reset, active high.  Fed by the registered
    //> por_done (one clk behind UsbPor's release) -- see the por_rst
    //> doccomment in UsbController for why the extra register stage
    //> is load-bearing.
    incoming rst : Bit
    //> D+ pad sample in (from UsbPads).
    incoming dp_rx : Bit
    //> D- pad sample in (from UsbPads).
    incoming dn_rx : Bit
    //> D+ drive level out (to UsbPads).
    outgoing dp_tx : Bit {
        it := txphy.dp
    }
    //> D- drive level out (to UsbPads).
    outgoing dn_tx : Bit {
        it := txphy.dn
    }
    //> Pad drive enable: drive the bus while high (SB_IO
    //> OUTPUT_ENABLE via UsbPads).
    outgoing output_enable : Bit {
        it := txphy.output_enable
    }
    //> Byte from the host; valid for one cycle with rx_valid.
    outgoing rx_data : Word[8] {
        it := rx_data_d
    }
    //> 1-clk strobe per received byte (= the rx FIFO pop).
    outgoing rx_valid : Bit {
        it := rx_valid_rr
    }
    //> The tx FIFO has room for another byte.
    outgoing tx_ready : Bit {
        it := tx_ready_r
    }
    //> Byte toward the host.
    incoming tx_data : Word[8]
    //> 1-clk push strobe for tx_data.
    incoming tx_strobe : Bit
    //> Flow control back: low = the rx consumer is full, stop popping
    //> (the core NAKs bulk-OUT packets instead).
    incoming rx_ready : Bit
    //> The core is receiving data (host -> device); stretched ~175 ms
    //> past the last byte so it is LED-visible (drives led_red).  EP0
    //> control traffic is not covered (not in rx_valid/tx_strobe).
    outgoing rxing : Bit {
        it := rx_led_cnt != 0w23
    }
    //> The core is sending data (device -> host); stretched ~175 ms
    //> past the last byte (drives led_green).
    outgoing txing : Bit {
        it := tx_led_cnt != 0w23
    }

    // ---- RX chain -----------------------------------------------------
    //> The RX PHY (pads -> decoded bits).  `active` is not needed by
    //> the core: the packet engines key off sop/eop/pkt_err.
    mod rxphy of RxPhy {
        it.clk := clk
        it.rst := rst
        it.dp  := dp_rx
        it.dn  := dn_rx
        unused it.active
    }
    //> Bus reset strobe from the PHY (long SE0): flushes everything.
    wire bus_reset : Bit {
        it := rxphy.bus_reset
    }

    //> The packet assembler (bits -> tk_*/dt_*/hs_* records).  The
    //> RAM read address is the rx-push byte index push_i (the rx
    //> push streams the payload out through the registered read
    //> port).
    mod rxpkt of RxPacket {
        it.clk       := clk
        it.rst       := rst
        it.bus_reset := bus_reset
        it.bit_i     := rxphy.bit_o
        it.bit_valid := rxphy.bit_valid
        it.sop       := rxphy.sop
        it.eop       := rxphy.eop
        it.pkt_err   := rxphy.pkt_err
        it.dt_rd_addr := push_i[6..0]
        // SOF frames decode but are ignored (the device does no SOF
        // bookkeeping).
        unused it.tk_frame
    }

    // ---- EP0 + serial protocol modules ---------------------------------
    //> EP0 (control transfers + CDC requests) and Serial (EP1 bulk
    //> protocol): see their own banners.  The dt_* fields are shared
    //> straight off the packet assembler's records (they hold between
    //> packets); only the per-module data strobes are router-gated.
    mod ep0 of Ep0 {
        it.clk       := clk
        it.rst       := rst
        it.bus_reset := bus_reset
        it.tk_setup  := ep0_tk_setup_r
        it.tk_in     := ep0_tk_in_r
        it.tk_out    := ep0_tk_out_r
        it.dt_valid  := ep0_dt_valid_r
        it.dt_pid    := rxpkt.dt_pid
        it.dt_len    := rxpkt.dt_len
        it.dt_head   := rxpkt.dt_head
        it.dt_crc_ok := rxpkt.dt_crc_ok
        it.hs_ack    := ep0_hs_ack
    }

    mod serial of Serial {
        it.clk       := clk
        it.rst       := rst
        it.bus_reset := bus_reset
        it.set_cfg   := cfg_strobe
        it.tk_in     := ser_tk_in_r
        it.tk_out    := ser_tk_out_r
        it.dt_valid  := ser_dt_valid
        it.dt_pid    := rxpkt.dt_pid
        it.dt_len    := rxpkt.dt_len
        it.dt_crc_ok := rxpkt.dt_crc_ok
        it.hs_ack    := ser_hs_ack
        it.txfifo_empty := txfifo.empty
        it.txfifo_count := txfifo.count
        it.rx_room      := rx_room_ok
        it.tx_room      := tx_room
    }

    // ---- token router -------------------------------------------------
    //> The device answers only its own address (starts 0; SET_ADDRESS
    //> latches at status completion); SOF tokens decode but are
    //> ignored.  The address compare + pid/endp decode is REGISTERED
    //> (+1 clk on token strobes -- well inside the device turnaround
    //> budget): the dev_addr compare then sits in ONE register's
    //> D-cone instead of fanning into every consumer's clock-enable
    //> logic.  tk_pid/tk_endp hold their values between packets, so
    //> decoding them one clk late is exact.
    reg tok_v_r : Bit on clk {
        initial it <= false
        it <= when {
            case rst || bus_reset => false
            else => rxpkt.tk_valid && rxpkt.tk_crc_ok
                && (rxpkt.tk_addr == ep0.dev_addr)
        }
    }

    //> The FULL token strobes, REGISTERED one clk further (the
    //> pid/endp decode otherwise stays combinational off tok_v_r and
    //> every consumer's register-enable cone ingests it; no token can
    //> land in the delay -- the inter-packet gap is >= 2 bit times =
    //> 8 clks).
    reg ep0_tk_setup_r : Bit on clk {
        initial it <= false
        it <= when {
            case rst || bus_reset => false
            else => tok_v_r && (rxpkt.tk_pid == 13w4)
                && (rxpkt.tk_endp == 0w4)
        }
    }
    reg ep0_tk_in_r : Bit on clk {
        initial it <= false
        it <= when {
            case rst || bus_reset => false
            else => tok_v_r && (rxpkt.tk_pid == 9w4)
                && (rxpkt.tk_endp == 0w4)
        }
    }
    reg ep0_tk_out_r : Bit on clk {
        initial it <= false
        it <= when {
            case rst || bus_reset => false
            else => tok_v_r && (rxpkt.tk_pid == 1w4)
                && (rxpkt.tk_endp == 0w4)
        }
    }
    reg ser_tk_in_r : Bit on clk {
        initial it <= false
        it <= when {
            case rst || bus_reset => false
            else => tok_v_r && (rxpkt.tk_pid == 9w4)
                && (rxpkt.tk_endp == 1w4)
        }
    }
    reg ser_tk_out_r : Bit on clk {
        initial it <= false
        it <= when {
            case rst || bus_reset => false
            else => tok_v_r && (rxpkt.tk_pid == 1w4)
                && (rxpkt.tk_endp == 1w4)
        }
    }
    reg ep2_tk_in_r : Bit on clk {
        initial it <= false
        it <= when {
            case rst || bus_reset => false
            else => tok_v_r && (rxpkt.tk_pid == 9w4)
                && (rxpkt.tk_endp == 2w4)
        }
    }
    reg ep2_tk_out_r : Bit on clk {
        initial it <= false
        it <= when {
            case rst || bus_reset => false
            else => tok_v_r && (rxpkt.tk_pid == 1w4)
                && (rxpkt.tk_endp == 2w4)
        }
    }

    //> "last valid token was OUT-to-EP0": qualifies EP0's data-stage
    //> STALL.  During EP_STALL the only data packet EP0 may answer is
    //> the stalled control transfer's OWN data stage (its token was
    //> OUT-to-EP0).  Without this qualifier the router handed EVERY
    //> data packet to a stalled EP0, STALLing the host's bulk-OUT
    //> writes and killing the echo until the next SETUP (found on
    //> hardware: the port enumerated but no byte ever flowed after
    //> the connect script's SET_LINE_CODING stalled).  The token
    //> precedes its data packet back-to-back, so this register is
    //> stable across the data packet; the next token re-evaluates it.
    reg last_out_ep0 : Bit on clk {
        initial it <= false
        it <= when {
            case rst || bus_reset => false
            case tok_v_r => (rxpkt.tk_pid == 1w4) && (rxpkt.tk_endp == 0w4)
            else => it
        }
    }

    //> Data packet router: the module expecting a data packet owns
    //> it.  EP0's strobe is REGISTERED one clk after arrival: the
    //> rxpkt EOP outputs (dt_len = bc-2, dt_crc_ok = the 16-bit
    //> residual compare) carry wide cones, and fanning them into
    //> EP0's accept enables in the ARRIVAL cycle was the critical
    //> path.  Every field EP0 reads holds until the next packet's
    //> EOP, so the delayed read is bit-identical; the +1 clk is free
    //> (no token can land in the delay).  usb::Serial keeps the
    //> arrival-cycle strobe: its accept decision is already
    //> registered one clk later (dt_acc/dt_rej), so its cone was
    //> never critical.
    wire ep0_data_take : Bit {
        it := ep0.ep0_busy || (ep0.ep0_stalling && last_out_ep0)
    }
    wire ep0_dt_gate : Bit {
        it := rxpkt.dt_valid && ep0_data_take
    }
    reg ep0_dt_valid_r : Bit on clk {
        initial it <= false
        it <= when {
            case rst || bus_reset => false
            else => ep0_dt_gate
        }
    }
    wire ser_dt_valid : Bit {
        it := rxpkt.dt_valid && serial.ser_busy && !ep0_data_take
    }

    //> Handshake router: the module with a response in flight owns
    //> it.
    wire ep0_hs_ack : Bit {
        it := rxpkt.hs_valid && (rxpkt.hs_pid == 2w4) && ep0.ep0_wait_ack
    }
    wire ser_hs_ack : Bit {
        it := rxpkt.hs_valid && (rxpkt.hs_pid == 2w4)
            && !ep0.ep0_wait_ack && serial.ser_ack_wait
    }

    // ---- response arbiter -----------------------------------------------
    //> Requests never overlap in protocol order (one response per
    //> token/data packet), so a simple priority mux with an in-flight
    //> owner register suffices.

    //> Notif EP (EP2): the host polls it, the core never arms it --
    //> every token gets a NAK.  REGISTERED (a combinational NAK off
    //> the token router would drag the whole token-decode cone into
    //> the tx engine's state logic; the response comes 1 clk later,
    //> still far inside the turnaround budget).  NB: rst ONLY, no
    //> bus_reset -- exactly as the vendored body.
    reg ep2_nak_req : Bit on clk {
        initial it <= false
        it <= when {
            case rst => false
            else => ep2_tk_in_r || ep2_tk_out_r
        }
    }

    wire ep0_resp_req : Bit {
        it := ep0.resp_req
    }
    wire ser_resp_req : Bit {
        it := serial.resp_req
    }
    //> The tx engine start strobe: any pending response request.
    wire tx_start : Bit {
        it := ep0_resp_req || ser_resp_req || ep2_nak_req
    }

    //> In-flight response owner: 0 none, 1 ep0, 2 serial, 3 ep2.
    //> NB: rst ONLY, no bus_reset -- exactly as the vendored body.
    reg tx_owner : Word[2] on clk {
        initial it <= 0w2
        it <= when {
            case rst => 0w2
            case tx_start => when {
                case ep0_resp_req => 1w2
                case ser_resp_req => 2w2
                else => 3w2
            }
            case txphy.tx_done => 0w2
            else => it
        }
    }

    //> The response the tx engine launches (EP2 always NAKs).
    wire tx_pid_w : Word[4] {
        it := when {
            case ep0_resp_req => ep0.resp_pid
            case ser_resp_req => serial.resp_pid
            else => 10w4
        }
    }
    wire tx_len_w : Word[7] {
        it := when {
            case ep0_resp_req => ep0.resp_len
            case ser_resp_req => serial.resp_len
            else => 0w7
        }
    }

    // ---- snapshot loader ------------------------------------------------
    //> A fresh bulk-IN arm pops min(count,64) bytes from the tx FIFO
    //> into the snapshot RAM one byte per clk (byte 0 is first
    //> needed ~72+ clks after the arm, so the load always wins the
    //> race).  Termination is a COUNTDOWN, not an address compare:
    //> rem loads the packet length at arm and decrements once per
    //> popped byte; the last byte is being written when rem == 1,
    //> i.e. any(rem[7..1]) -- a 6-input OR into load_run's D; li's
    //> increment feeds only its own D (the old li-vs-len compare was
    //> the vir-flow critical path).  Byte schedule identical: one
    //> pop per clk, snap[0..len-1] in order.
    wire arm_fresh : Bit {
        it := tx_start && ser_resp_req && serial.resp_fresh
    }
    reg load_run : Bit on clk {
        initial it <= false
        it <= when {
            case rst || bus_reset => false
            case arm_fresh => tx_len_w != 0w7
            case it        => any(rem[7..1])
            else => it
        }
    }
    reg li : Word[7] on clk {
        initial it <= 0w7
        it <= when {
            case rst || bus_reset => 0w7
            case arm_fresh => 0w7
            case load_run => it + 1w7
            else => it
        }
    }
    reg rem : Word[7] on clk {
        initial it <= 0w7
        it <= when {
            case rst || bus_reset => 0w7
            case arm_fresh => tx_len_w
            case load_run => it - 1w7
            else => it
        }
    }
    //> The snapshot RAM instance.  we fires exactly where the
    //> vendored body wrote: a load step -- not the arm cycle, not
    //> reset (all three terms are current-cycle, so the write edge
    //> is bit-identical).
    mod snapram of SnapRam {
        it.clk := clk
        it.we  := load_run && !arm_fresh && !(rst || bus_reset)
        it.wa  := li
        it.wd  := txfifo.rd_data
        it.ra  := byte_rd_addr
    }

    // ---- byte fetch pipeline ---------------------------------------------
    //> Per byte of the in-flight packet: tx_addr_next (comb from the
    //> tx PHY's bit index) -> byte_rd_addr (reg) -> snap_q / desc_q
    //> (the BRAM sync-read output registers live inside the ext
    //> bodies).  The producer mux below feeds the PHY from
    //> registered sources only; the PHY's tx_byte register is a
    //> further stage.
    reg byte_rd_addr : Word[7] on clk {
        initial it <= 0w7
        it <= txphy.tx_addr_next
    }
    //> EP0 ROM page start by descriptor select.
    wire rom_page : Word[8] {
        it := match ep0.resp_sel {
            case 0w3 => 0w8
            case 1w3 => 18w8
            case 2w3 => 93w8
            case 3w3 => 97w8
            case 4w3 => 107w8
            else => 0w8
        }
    }
    //> The latched EP0 response base: page start + transfer offset,
    //> latched at arm.  NB: rst ONLY -- exactly as the vendored body.
    reg rom_base_r : Word[8] on clk {
        initial it <= 0w8
        it <= when {
            case rst => 0w8
            case ep0_resp_req => rom_page + ep0.resp_base[8..0]
            else => it
        }
    }
    //> The ROM read address, one stage behind the base (free-running
    //> adder; only the latched-at-arm base matters).
    reg rom_addr_r : Word[8] on clk {
        initial it <= 0w8
        it <= rom_base_r + word(0w1, byte_rd_addr)
    }
    mod descrom of DescRom {
        it.clk := clk
        it.ra := rom_addr_r
    }
    wire desc_q : Word[8] {
        it := descrom.rd
    }
    //> tx PHY producer mux (registered sources only): serial data
    //> comes from the snapshot RAM; GET_STATUS (sel 6) reads as zero
    //> bytes; everything else reads the descriptor ROM.
    wire tx_byte : Word[8] {
        it := when {
            case tx_owner == 2w2 => snapram.rd
            case ep0.resp_sel == 6w3 => 0w8
            else => desc_q
        }
    }

    // ---- tx PHY -----------------------------------------------------------
    mod txphy of TxPhy {
        it.clk := clk
        it.rst := rst
        it.tx_start := tx_start
        it.tx_pid := tx_pid_w
        it.tx_len := tx_len_w
        it.tx_byte := tx_byte
        unused it.tx_addr
        unused it.tx_busy
    }

    // ---- FIFOs -------------------------------------------------------------
    //> The 64-deep bulk-OUT rx FIFO.  wr_en is the REGISTERED push
    //> strobe (rx_push_run_d -- pre-gated with !full in its own D);
    //> rd_en is the REGISTERED pop decision (rx_pop_d, pre-gated
    //> with !empty).
    mod rxfifo of RxFifo {
        it.clk     := clk
        it.rst     := rst || bus_reset
        it.wr_en   := rx_push_run_d
        it.wr_data := rxpkt.dt_rd_data
        it.rd_en   := rx_pop_d
    }

    //> The 16-deep tx FIFO.  The write gate is REGISTERED
    //> (txfifo_wr_d): the old comb gate at the write edge put the cnt
    //> full-compare into every byte's write-enable cone (via the
    //> echo's do_push chain) -- the vir-flow critical path, 21.8 ns.
    //> A registered gate is safe here: the overflow scenario the
    //> comb gate feared needs TWO pushes within 1 clk, and the echo
    //> pushes at most one byte per ~417 clks (single hold slot) and
    //> is the only writer of this FIFO.  tx_data (the echo's
    //> hold_data) is stable across the +1 clk: it only changes on
    //> the next receiver byte, >= 417 clks later.  rd_en is the
    //> snapshot loader's pop (the only popper, popping exactly
    //> min(count,64) counted at arm).
    mod txfifo of TxFifo {
        it.clk     := clk
        it.rst     := rst || bus_reset
        it.wr_en   := txfifo_wr_d
        it.wr_data := tx_data
        it.rd_en   := load_run
    }

    // ---- rx pop / byte-stream loopback pipe ---------------------------------
    //> The registered loopback strobe pipeline (three stages on the
    //> rx side: the BRAM read is registered): the pop decision, then
    //> the (rx_valid pulse, rx_data byte) pair the consumer latches
    //> one clk after the BRAM read port has produced the popped
    //> byte.  (the PoC Top wires the loopback: tx_data = rx_data,
    //> tx_strobe = rx_valid; the pipelined pair keeps the plan §2
    //> contract and takes the empty/full decode off the single-cycle
    //> paths)
    reg rx_pop_d : Bit on clk {
        initial it <= false
        it <= when {
            case rst || bus_reset => false
            // Pop while the rx FIFO has a byte, the tx FIFO keeps the
            // 3-stage pipe's headroom (cnt <= 12: 16 - 3 in flight -
            // 1 margin, so a landing push never meets a full txfifo
            // and the comb write gate never drops a popped byte), AND
            // the byte-stream consumer signals room (rx_ready -- the
            // echo server throttles the pop rate to the UART's
            // 115200 drain; when low the rx FIFO fills, the serial
            // endpoint NAKs bulk-OUT, the host retries: end-to-end
            // flow control with no byte loss).  Off-by-one fix (stress
            // S4c, cnt wrap 0->127): block a pop when the in-flight
            // pop is consuming the last byte -- the scheduled next
            // pop would find an empty FIFO and the 7-bit cnt
            // subtract wraps to 127, draining stale BRAM bytes
            // forever.
            else => !rxfifo.empty && !(rxfifo.count == 1w7 && it)
                && (txfifo.count < 13w7) && rx_ready
        }
    }
    reg rx_valid_r : Bit on clk {
        initial it <= false
        it <= when {
            case rst || bus_reset => false
            else => rx_pop_d
        }
    }
    reg rx_valid_rr : Bit on clk {
        initial it <= false
        it <= when {
            case rst || bus_reset => false
            else => rx_valid_r
        }
    }
    //> The popped byte (rxfifo.rd_data holds it from one clk after
    //> rx_pop_d), paired with rx_valid_rr.  NO reset: holds.
    reg rx_data_d : Word[8] on clk {
        initial it <= 0w8
        it <= when {
            case rst || bus_reset => it
            else => rxfifo.rd_data
        }
    }

    // ---- rx push -------------------------------------------------------------
    //> Accepted bulk-OUT payloads stream from the packet payload RAM
    //> into the rx FIFO, one byte per clk: the payload RAM registers
    //> mem[push_i] into dt_rd_data one clk after the index holds it,
    //> so the 1-stage rx_push_run_d strobe pairs index and byte
    //> exactly (byte i written at the C(2+i)->C(3+i) posedge, once,
    //> in order).  wr_en is pre-gated with !full inside rx_push_run's
    //> own D (the serial accept already required cnt+dt_len <= 64),
    //> so the rxfifo write port sees two clean registers.
    //> Termination is a COUNTDOWN (push_rem): the old `push_i+1 >=
    //> len` compare rode the increment carry chain into push_i's own
    //> clock enable -- the vir-flow critical path (22.0 ns).  The
    //> stop test is a 6-input NOR; push_i's increment feeds only its
    //> own D.  Byte-exact: push_rem==1 in cycle N means cycle N
    //> pushes the last byte, so run drops at N's edge exactly where
    //> the old compare dropped it (push_i visits one extra index in
    //> the trailing cycle; that read is discarded -- run_d is 0 by
    //> then).
    wire ser_accept : Bit {
        it := ser_resp_req && (serial.resp_pid == 2w4)
    }
    reg rx_push_run : Bit on clk {
        initial it <= false
        it <= when {
            case rst || bus_reset => false
            case ser_accept => (rxpkt.dt_len != 0w7) && !rxfifo.full
            case it => any(push_rem[7..1])
            else => it
        }
    }
    reg rx_push_run_d : Bit on clk {
        initial it <= false
        it <= when {
            case rst || bus_reset => false
            else => rx_push_run
        }
    }
    reg push_i : Word[7] on clk {
        initial it <= 0w7
        it <= when {
            case rst || bus_reset => 0w7
            case ser_accept => 0w7
            case rx_push_run => it + 1w7
            else => it
        }
    }
    reg push_rem : Word[7] on clk {
        initial it <= 0w7
        it <= when {
            case rst || bus_reset => 0w7
            case ser_accept => rxpkt.dt_len
            case rx_push_run => it - 1w7
            else => it
        }
    }

    // ---- tx-side gates, room, LEDs --------------------------------------------
    //> The REGISTERED txfifo write gate (see the txfifo banner).
    reg txfifo_wr_d : Bit on clk {
        initial it <= false
        it <= tx_strobe && !txfifo.full
    }
    //> Free slots in the tx FIFO (for usb::Serial's arm sizing).
    wire tx_room : Word[7] {
        it := 16w7 - txfifo.count
    }
    //> tx_ready is REGISTERED (+1 clk stale): the echo's do_push
    //> (its hold_valid clear) then reads only registered terms,
    //> taking the cnt full-compare out of hold_valid's enable cone.
    //> Stale room is safe: the echo pushes at most one byte per ~417
    //> clks (single hold slot) and is the only writer, so no push can
    //> land inside the 1-clk staleness window; the txfifo_wr_d gate
    //> re-checks !full at the registered edge as belt-and-braces.
    reg tx_ready_r : Bit on clk {
        initial it <= false
        it <= !txfifo.full
    }
    //> Does the whole packet fit the rx FIFO?  adder+compare (carry
    //> chain), combinational -- usb::Serial registers the DECISION
    //> one clk later, so this stays out of its response cycle.
    wire rx_sum : Word[8] {
        it := word(0w1, rxfifo.count) + word(0w1, rxpkt.dt_len)
    }
    wire rx_room_ok : Bit {
        it := rx_sum <= 64w8
    }

    //> SET_CONFIGURATION completed -> reset the bulk data toggles
    //> (USB 2.0 §9.1.1.5): edge detect on ep0.configured.  NB: the
    //> delayed copy is rst ONLY -- exactly as the vendored body.
    reg configured_d : Bit on clk {
        initial it <= false
        it <= when {
            case rst => false
            else => ep0.configured
        }
    }
    wire cfg_strobe : Bit {
        it := ep0.configured ^^ configured_d
    }

    //> USB activity indicators: the rx/tx byte-stream strobes
    //> stretched to ~175 ms (the 1-clk rx_valid/tx_strobe strobes are
    //> far too fast to see).  Self-contained counters -- deliberately
    //> outside every USB engine path, NO reset (power-on zero, count
    //> down to rest).
    reg rx_led_cnt : Word[23] on clk {
        initial it <= 0w23
        it <= when {
            case rx_valid_rr  => 0x7f_ffffw23
            case it != 0w23   => it - 1w23
            else => it
        }
    }
    reg tx_led_cnt : Word[23] on clk {
        initial it <= 0w23
        it <= when {
            case tx_strobe    => 0x7f_ffffw23
            case it != 0w23   => it - 1w23
            else => it
        }
    }
}

mod UsbController {
    //> 48 MHz board clock.
    incoming clock : Clock
    //> From UsbPor (instantiated at the top, mirroring the sim TB's
    //> instantiate-the-pieces topology): high once the ~175 ms power-on
    //> count is done.
    incoming por_done : Bit

    // Byte-stream interface (plan §2), identical contract to the old
    // ext mod UsbController this structure replaces.
    //> Byte from the host; valid for one cycle with rx_valid.
    outgoing rx_data   : Word[8]
    //> 1-clk strobe per received byte.
    outgoing rx_valid  : Bit
    //> The tx FIFO has room for another byte.
    outgoing tx_ready  : Bit
    //> Byte toward the host.
    incoming tx_data   : Word[8]
    //> 1-clk push strobe for tx_data.
    incoming tx_strobe : Bit
    //> Flow control back: low = the rx consumer is full, stop popping
    //> (the core NAKs bulk-OUT packets instead).
    incoming rx_ready  : Bit

    //> The core is receiving data (host -> device); stretched ~175 ms
    //> past the last byte (drives led_red, active low, at the top).
    outgoing rxing : Bit
    //> The core is sending data (device -> host); stretched ~175 ms
    //> past the last byte (drives led_green, active low).
    outgoing txing : Bit

    // Pad-facing side: unidirectional wires to/from the UsbPads ext
    // mod (wired by export mod Top in src/top.vir).
    //> D+ drive level out to UsbPads.
    outgoing dp_tx         : Bit
    //> D- drive level out to UsbPads.
    outgoing dn_tx         : Bit
    //> Pad drive enable out to UsbPads.
    outgoing output_enable : Bit
    //> D+ pad sample in from UsbPads.
    incoming dp_rx         : Bit
    //> D- pad sample in from UsbPads.
    incoming dn_rx         : Bit

    //> The core reset is REGISTERED one clk behind por_done: the
    //> por_done flop must sit next to the usb_dp_pu pad (its dominant
    //> load), and a pad-adjacent flop sourcing the core-wide reset
    //> forced the placer to route the reset OUT of the IO region and
    //> back into the fabric (the 4.9 ns first hop of the vir-flow
    //> critical path).  A dedicated flop with no IO load is placed in
    //> the core region instead.  +1 clk of reset assertion at a
    //> ~175 ms POR is free; the core still leaves reset before it can
    //> drive the bus (output_enable is gated by the in-reset core).
    reg por_rst : Bit on clock {
        initial it <= false
        it <= por_done
    }
    wire core_rst : Bit {
        it := !por_rst
    }

    mod core of UsbUart {
        it.clk  := clock
        it.rst  := core_rst
        it.dp_rx := dp_rx
        it.dn_rx := dn_rx
        it.tx_data   := tx_data
        it.tx_strobe := tx_strobe
        it.rx_ready  := rx_ready
    }

    dp_tx          := core.dp_tx
    dn_tx          := core.dn_tx
    output_enable  := core.output_enable
    rx_data        := core.rx_data
    rx_valid       := core.rx_valid
    tx_ready       := core.tx_ready
    rxing          := core.rxing
    txing          := core.txing
}
