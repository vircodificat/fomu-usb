import crc
import endpoint
import ice40
import phy

//> The USB pad-facing link between UsbController and UsbPads: the
//> core's D+/D- drive levels and tristate control (cosi; the client
//> is the core) and the pad samples back (soci; the server is the
//> pads).  Electrical bidirectionality stays inside UsbPads' SB_IO
//> cells; every channel here is unidirectional.
pub socket UsbTxRx {
    cosi dp_tx : Bit
    cosi dn_tx : Bit
    cosi output_enable : Bit

    soci dp_rx : Bit
    soci dn_rx : Bit
}
//> The USB core in Virdant: everything between the byte stream and the
//> USB pads.  This file holds the pad interface (UsbPads), the power-on
//> reset (PowerOnReset), the packet/token decoder (RxPacket), the
//> endpoint protocol mods (usb::Ep0 / usb::Serial, in src/endpoint.vir),
//> and the core tops (UsbUart, wrapped
//> by UsbController).  UsbUart is itself factored into four helpers:
//> the token/data/handshake router (UsbTokenRouter), the response
//> arbiter (UsbArbiter), the bulk-IN snapshot loader (UsbSnapshotLoader)
//> and the bulk byte-stream engine (UsbByteStream, exposing the byte
//> stream as two Pipe[Word[8]] handshake sockets; UsbController
//> forwards those sockets unchanged to the ext-world boundary).  The physical-layer mods (NrziDecoder,
//> BitDestuffer, RxPhy, TxPhy) live in src/phy.vir; the serial CRC
//> LFSRs (Crc5/Crc16) in src/crc.vir.  Only what Virdant cannot express
//> stays vendored in
//> ext/usb_uart.sv and ext/usb_pads.sv: the indexed memories
//> (\usb::TxFifo / \usb::RxFifo / \usb::DescRom) and the bidirectional
//> USB pads (UsbPads, the only `inout` in the design).
//>
//> Topology (wired by export mod Top in src/top.vir):
//>
//>     UsbPor (~175 ms) --por_done--> UsbController --byte stream--> echo
//>     UsbController <=UsbTxRx socket=> UsbPads (ext, SB_IO)
//>
//> The pad-facing side is deliberately UNIDIRECTIONAL: the only
//> bidirectional nets in the whole design live inside UsbPads.


//> The two USB D+/D- tristate pad cells (iCE40 SB_IO, PIN_TYPE
//> 6'b101001) -- the one ext mod that touches a bidirectional net.
//> Body in ext/usb_pads.sv: two SB_IO instances, one per line, sharing
//> a single output_enable (the core drives both lines together or
//> neither).  From Virdant's point of view every wire here is
//> unidirectional: we drive the pads via dp_tx/dn_tx gated by
//> output_enable, and sample them back via dp_rx/dn_rx; the electrical
//> bidirectionality never crosses this boundary (the ext body's
//> `inout` port declarations are the Verilog-side plumbing that gets
//> the SB_IO PACKAGE_PIN nets out to the Top ports / PCF pins).
pub ext mod UsbPads {
    //> USB D+ pad side, out to the Top port (PCF pin A1 in fomu.pcf);
    //> electrically bidirectional, driven/sampled by the SB_IO cell
    //> inside the ext body.
    outgoing usb_dp : Bit
    //> USB D- pad side, out to the Top port (PCF pin A2 in fomu.pcf);
    //> ditto.
    outgoing usb_dn : Bit
    //> The core-facing side: the drive levels / tristate control come
    //> in on the cosi channels, the pad samples go back on the soci
    //> channels (see the usb::UsbTxRx socket banner).
    server socket usb of UsbTxRx
}

//> Power-on reset / USB attach delay
pub mod PowerOnReset {
    //> 48 MHz board clock.
    incoming clock  : Clock
    //> High (sticky) once the POR count completes.  Consumed at the
    //> top (src/top.vir): wired directly to the usb_dp_pu pad (the D+
    //> pull-up = attach), and into UsbController, where it is
    //> registered once more (por_rst) to form the core-wide reset.
    outgoing reg done : Bit on clock {
        initial it <= false
        it <= when {
            case count >= 8_400_000 => true
            else                    => it
        }
    }

    // 24 bits suffice: 8_400_000 < 2^24 = 16_777_216.  Counts up
    // while por_done_r is still low; holds at the terminal count.
    reg count : Word[24] on clock {
        initial it <= 0
        it <= when {
            case !done && (it < 8_400_000) => it + 1
            else                           => it
        }
    }
}

//> A decoded token packet record: usb::RxTokenRec latches it at the
//> token's EOP and holds it until the next token.  The fields are
//> FLAT, not a union: on a SOF capture the addr/endp slots go stale
//> and the frame slot is captured, and vice versa on non-SOF tokens
//> -- exactly the per-field reg semantics this record replaced.
//>
//> `pid` -- the 4-bit PID value (OUT 1 / IN 9 / SOF 5 / SETUP D).
//> `crc_ok` -- the registered CRC5 residual verdict (5'h0C after a
//>   good token stream): a CRC failure delivers the record with this
//>   low, so the protocol layer retries.
//> `addr` -- the device address (sh[7..0]; non-SOF tokens only:
//>   stale on SOF).
//> `endp` -- the endpoint number (sh[11..7]; non-SOF tokens only:
//>   stale on SOF).
//> `frame` -- the SOF frame number (the whole sh; SOF tokens only:
//>   stale on non-SOF tokens).
struct type TokenRec {
    pid : Word[4]
    crc_ok : Bit
    addr : Word[7]
    endp : Word[4]
    frame : Word[11]
}

//> A decoded data packet record: usb::RxDataRec latches it at the
//> data packet's EOP and holds it until the next data packet.
//>
//> `pid` -- the 4-bit data PID value (DATA0 3 / DATA1 B).
//> `len` -- the payload byte count: the data-section byte count
//>   minus the 2 crc16 wire bytes (0 for a bare 2-byte packet).
//> `crc_ok` -- the registered CRC16 residual verdict (16'h800D after
//>   a good payload stream): a CRC failure delivers the record with
//>   this low, so the protocol layer retries.
pub struct type DataRec {
    pid : Word[4]
    len : Word[7]
    crc_ok : Bit
}

//> A decoded handshake record: usb::RxHandshakeRec latches it at the
//> handshake's EOP and holds it until the next handshake.  Nothing
//> follows the PID byte on the wire.
//>
//> `pid` -- the 4-bit handshake PID value (ACK 2 / NAK A / STALL E).
struct type HsRec {
    pid : Word[4]
}

//> usb_rx_packet -- assembles the serial bit stream into packet
//> records (PID, tokens, data payloads, handshakes).  The
//> registered-helper structure (the cap precompute + qualify dance)
//> is load-bearing for the 48 MHz timing -- see
//> wiki/usb-rx-packet.md.
//>
//> Bit counting: nb counts PID-section bits (sync 0..7 ignored, PID
//> byte 0..7, token data 8..18, crc5 wire bits 19..23, parked at 24
//> in the data section); n3 is the data-section bit-in-byte index
//> (0..7, wrapping), with bc counting complete bytes (payload + the
//> 2 trailing crc16 wire bytes, subtracted at EOP).  Emits 1-clock
//> registered pulses tk_*/dt_*/hs_*; bad packets are silent.
//> Payload capture: dt_head = flopped packet bytes 0..7, and the
//> payload RAM (usb::RxRam above) holds bytes 0..63 in block RAM
//> (sync read: dt_rd_addr -> dt_rd_data the next clock).
enum type RxPktState {
    Idle = 0b00w2
    Sync = 0b01
    Body = 0b10
}

//> The payload RAM: 64 x 8-bit, one iCE40 SB_RAM40_4K cell
//> (ice40::SbRam40_4k) with WRITE_MODE/READ_MODE left at the default
//> 0 = NORMAL.  The 8-bit payload rides the cell's low byte (WDATA
//> zero-extended, MASK 0xFF00 masks the upper byte out of the write)
//> and the 6-bit byte index rides the low 6 address bits (zext to
//> the cell's Word[11]).  One write port (single enable -- no decode
//> tree, no per-byte enable fanout) and one registered synchronous
//> read port (present ra this clock, the byte is on rd the NEXT clock:
//> SB_RAM40_4K NORMAL read mode is registered, and RCLKE/RE tied
//> high make the read side free-running).  The cell is instantiated
//> explicitly, so yosys maps it directly -- no inference, no
//> ram_style hint needed.
mod RxRam {
    //> 48 MHz clock.
    incoming clock : Clock
    //> Write enable: byte-complete strobe, pre-gated with !(bc >= 64)
    //> by the caller usb::RxPacket (we = dt_wr && !bc[6]; writes
    //> beyond byte 63 are dropped -- over-length packets go bad and
    //> dt_valid never fires, so no consumer ever sees a dropped
    //> byte).
    incoming we : Bit
    //> Write address: the byte-count index, 0..63.
    incoming wa : Word[6]
    //> Write data byte.
    incoming wd : Word[8]
    //> Read address (present this clock; the byte is on rd next clock).
    incoming ra : Word[6]
    //> Registered read data: mem[ra] as of the previous posedge.
    outgoing rd : Word[8]

    mod ram of ice40::SbRam40_4k {
        it.RCLK  := clock
        it.WCLK  := clock
        it.RCLKE := true
        it.WCLKE := true
        it.RE    := true
        it.WE    := we
        it.WADDR := zext(wa)
        it.RADDR := zext(ra)
        it.WDATA := word(0w8, wd)
        it.MASK  := 0xFF00
        rd := it.RDATA[8..0]
    }
}

//> Bit stream -> packet records: consumes usb::RxPhy's decoded bit
//> stream (bit_i/bit_valid/sop/eop/pkt_err) and emits record pulses
//> -- tk (pulsed Valid[TokenRec] for token arrivals), dt (pulsed
//> Valid[DataRec] for data arrivals), hs_* (handshake) -- for the
//> router in the core top.
//>
//> The held records (Valid[TokenRec] / Valid[DataRec] / Valid[HsRec])
//> are passed through as tok_rec / data_rec / hs_rec for in-design
//> consumers (which unpack them with match).  Token and data arrivals
//> are also promoted to pulsed Valid[T] ports (tk / dt, @Valid for
//> exactly one cycle on capture), serving as both the strobe and the
//> struct payload.  The hs_* flat ports remain for TB compatibility
//> (tb/tb_usb_phy.v).  A packet record is emitted only if the packet
//> was good; CRC failures deliver the record with *_crc_ok low
//> instead (the protocol layer retries), while stuff errors, bad PIDs
//> and over-length payloads make the packet silent (bad).
mod RxPacket {
    //> 48 MHz clock: 4 clock cycles per USB FS bit.
    incoming clock : Clock
    //> Synchronous reset, active high (core reset from UsbController).
    incoming reset : Bit
    //> Bus reset strobe from usb::RxPhy (SE0 held >= 2.5 us): flushes
    //> everything, including partial packet state.
    incoming bus_reset : Bit
    //> Decoded (NRZI-decoded, bit-unstuffed) data bit.
    incoming bit_i : Bit
    //> 1-clock strobe: bit_i is a real packet bit this cycle.
    incoming bit_valid : Bit
    //> 1-clock pulse: start of packet (J->K from idle).
    incoming sop : Bit
    //> 1-clock pulse: end of packet (SE0 held ~1.75 bit times).
    incoming eop : Bit
    //> Sticky per-packet error from usb::RxPhy (stuff violation or
    //> illegal line state); kills the packet.
    incoming pkt_err : Bit
    //> Payload RAM read address (the rx-push byte index in the core;
    //> present this clock, the byte is on dt_rd_data the next).
    incoming dt_rd_addr : Word[6]

    // ---- packet engine + record captures -------------------------------
    mod core of RxPacketCore {
        it.clock := clock
        it.reset := reset
        it.bus_reset := bus_reset
        it.bit_i := bit_i
        it.bit_valid := bit_valid
        it.sop := sop
        it.eop := eop
        it.pkt_err := pkt_err
        it.dt_rd_addr := dt_rd_addr
    }

    // ---- record pass-throughs -------------------------------------------
    //> The held records, for the in-design consumers (they unpack
    //> them with match).  The token record is also promoted to a
    //> pulsed Valid[TokenRec] below (tk).
    //> The held token record (until the next token).
    outgoing tok_rec : Valid[TokenRec] {
        it := core.tok_rec
    }
    //> The held data record (until the next data packet).
    outgoing data_rec : Valid[DataRec] {
        it := core.data_rec
    }
    //> The held handshake record (until the next handshake).
    outgoing hs_rec : Valid[HsRec] {
        it := core.hs_rec
    }

    // ---- flat pass-throughs (handshake) ---------------------------------
    //> The held handshake record (usb::RxPacketCore's capture), unpacked
    //> to the FLAT record port.  While the record is @Invalid, its flat
    //> field serves the pre-split reset value (pid = 0).
    wire hs_p : HsRec {
        it := match core.hs_rec {
            case @Valid(h) => h
            case @Invalid() => ${
                pid = 0w4,
            }
        }
    }

    // ---- token arrival pulse -------------------------------------------
    //> Pulsed token record (@Valid for one cycle on capture, serving
    //> as both the arrival strobe and the struct payload for consumers
    //> that register the fields themselves -- see UsbTokenRouter).
    outgoing tk : Valid[TokenRec] {
        it := when {
            case core.tk_strobe => @Valid(match core.tok_rec {
                case @Valid(t) => t
                case @Invalid() => ${
                    pid = 0w4,
                    crc_ok = false,
                    addr = 0w7,
                    endp = 0w4,
                    frame = 0w11,
                }
            })
            else => @Invalid()
        }
    }
    // ---- data arrival pulse -------------------------------------------
    //> Pulsed data record (@Valid for one cycle on capture, serving
    //> as both the arrival strobe and the struct payload for
    //> consumers that register the fields themselves).
    outgoing dt : Valid[DataRec] {
        it := when {
            case core.dt_strobe => @Valid(match core.data_rec {
                case @Valid(d) => d
                case @Invalid() => ${
                    pid = 0w4,
                    len = 0w7,
                    crc_ok = false,
                }
            })
            else => @Invalid()
        }
    }
    //> Flopped payload head window, packet bytes 0..7 (consumers that
    //> need several bytes AT ONCE -- the EP0 request latch,
    //> SET_LINE_CODING -- cannot use the one-at-a-time RAM port).
    outgoing dt_head : Word[64] {
        it := core.dt_head
    }
    //> Payload RAM registered read (usb::RxRam.rd): present dt_rd_addr,
    //> the byte is here the NEXT clock.
    outgoing dt_rd_data : Word[8] {
        it := core.dt_rd_data
    }

    //> 1-clock pulse: a handshake record was latched this edge.
    outgoing hs_valid : Bit {
        it := core.hs_strobe
    }
    //> Handshake PID (ACK 2 / NAK A / STALL E).
    outgoing hs_pid : Word[4] {
        it := hs_p->pid
    }
}

//> usb_packet_core -- the packet engine behind usb::RxPacket: the
//> sync/PID/bit counting, the payload RAM and its write strobe, the
//> CRC LFSRs and the end-of-packet capture decisions
//> (tok_cap/sof_cap/hs_cap/dat_cap).  The record mods
//> (usb::RxTokenRec / usb::RxDataRec / usb::RxHandshakeRec) are
//> instantiated here, fed from this module's (otherwise private)
//> shared state, and their flat outputs pass through to the facade.
//>
//> FSM + counting: IDLE -> (sop) -> SYNC (skip the 8 sync bits) ->
//> BODY (PID section, then token or data section) -> (eop) -> IDLE.
//> nb counts PID-section bits (sync 0..7 ignored, PID byte 0..7,
//> token data 8..18, crc5 wire bits 19..23, parked at 24 in the data
//> section); n3 is the data-section bit-in-byte index (0..7,
//> wrapping), with bc counting complete bytes (payload + the 2
//> trailing crc16 wire bytes, subtracted at EOP by usb::RxDataRec).
//> Bad packets are silent: every cap is qualified by !bad, so no
//> strobe ever fires.
mod RxPacketCore {
    //> 48 MHz clock: 4 clock cycles per USB FS bit.
    incoming clock : Clock
    //> Synchronous reset, active high (core reset from UsbController).
    incoming reset : Bit
    //> Bus reset strobe from usb::RxPhy (SE0 held >= 2.5 us): flushes
    //> everything, including partial packet state.
    incoming bus_reset : Bit
    //> Decoded (NRZI-decoded, bit-unstuffed) data bit.
    incoming bit_i : Bit
    //> 1-clock strobe: bit_i is a real packet bit this cycle.
    incoming bit_valid : Bit
    //> 1-clock pulse: start of packet (J->K from idle).
    incoming sop : Bit
    //> 1-clock pulse: end of packet (SE0 held ~1.75 bit times).
    incoming eop : Bit
    //> Sticky per-packet error from usb::RxPhy (stuff violation or
    //> illegal line state); kills the packet.
    incoming pkt_err : Bit
    //> Payload RAM read address (the rx-push byte index in the core;
    //> present this clock, the byte is on dt_rd_data the next).
    incoming dt_rd_addr : Word[6]

    // ---- capture helpers, wires ----------------------------------------

    //> PID capture value on this cycle (shift bit_i in at the bottom;
    //> wire order = LSB first).
    wire pid_new : Word[8] {
        it := word(bit_i, pid_r[8..1])
    }
    //> Byte completing on this bit clock (bit_i = the byte MSB,
    //> bshift[7:1] = the earlier 7 bits, LSB first).
    wire dt_byte_new : Word[8] {
        it := word(bit_i, bshift[8..1])
    }
    //> Byte-complete write strobe (registered inputs only: n3/st/sec
    //> are regs; bit_valid/pkt_err are registered upstream in
    //> usb::RxPhy).
    wire dt_wr : Bit {
        it := bit_valid && !pkt_err && (st == #Body) && sec && (n3 == 7w3)
    }

    // ---- CRC LFSRs ----------------------------------------------------
    //> CRC5 advances on token bits nb = 8..23 (data + received crc5
    //> wire bits; residual 5'h0C).  NOT gated by pkt_err: a bad
    //> packet's residual is never sampled.
    mod crc5 of crc::Crc5 {
        it.clock := clock
        it.reset := sop || reset || bus_reset
        it.advance := bit_valid && (st == #Body) && !sec
            && (nb >= 8w5) && (nb < 24w5)
        it.din := bit_i
    }
    //> CRC16 advances on every data-section bit (payload + received
    //> crc16 wire bits; residual 16'h800D).
    mod crc16 of crc::Crc16 {
        it.clock := clock
        it.reset := sop || reset || bus_reset
        it.adv := bit_valid && (st == #Body) && sec
        it.din := bit_i
    }

    // ---- registered helpers --------------------------------------------
    //> Each ends at its OWN register so the wide compares stay out of
    //> the capture strobes' cones (48 MHz timing; the caps are
    //> consumed only at EOP, >= 8 clks after the last bit, so the +1
    //> clock on each is free).  Computed every cycle from registered
    //> inputs; mid-packet values are harmless (only read at EOP).

    //> bc == 66 registered (the over-length hit), split so no 7-bit
    //> compare rides bc's D-cone: bits 6..3 == 0100 and bits 2..0 ==
    //> 010 (66 = 0b1000010).
    reg bc_is_66_r : Bit on clock {
        initial it <= false
        it <= when {
            case reset || bus_reset => false
            else => (bc[7..3] == 4w4) && (bc[3..0] == 2w3)
        }
    }
    //> PID check failure ({~pid, pid}: low nibble != ~high nibble,
    //> i.e. the nibbles XOR != 1111), registered one clock before it
    //> sets `bad`.
    reg pid_bad_r : Bit on clock {
        initial it <= false
        it <= when {
            case reset || bus_reset => false
            else => bit_valid && (st == #Body) && !sec && (nb == 7w5)
                    && ((pid_new[4..0] ^ pid_new[8..4]) != 15w4)
        }
    }
    //> Over-length data hit registered (67th byte = bc == 66 with a
    //> byte completing): feeds `bad`, +1 clock.
    reg bc66_hit_r : Bit on clock {
        initial it <= false
        it <= when {
            case reset || bus_reset => false
            else => bit_valid && (st == #Body) && sec
                    && (n3 == 7w3) && (bc == 66w7)
        }
    }
    //> CRC5 residual compare (5'h0C), registered: the 5-bit equality
    //> tree ends at its own flop instead of riding tk_crc_ok's cone.
    reg crc5_res_r : Bit on clock {
        initial it <= false
        it <= when {
            case reset || bus_reset => false
            else => crc5.crc == 12w5
        }
    }
    //> CRC16 residual compare (16'h800D), registered likewise.
    reg crc16_res_r : Bit on clock {
        initial it <= false
        it <= when {
            case reset || bus_reset => false
            else => crc16.crc == 0x800dw16
        }
    }

    //> Flat sticky per-packet error, plain D (no clock enable): set on
    //> a stuff error (inline), a bad PID or an over-length byte (the
    //> registered hits above, +1 clock); cleared at sop and by reset.
    //> A bad packet is silent: every cap is qualified by !bad, so no
    //> strobe ever fires.
    reg bad : Bit on clock {
        initial it <= false
        it <= when {
            case reset || bus_reset => false
            case sop              => false
            else => it || (bit_valid && pkt_err) || pid_bad_r || bc66_hit_r
        }
    }

    // ---- FSM ------------------------------------------------------------
    //> IDLE -> (sop) -> SYNC (skip the 8 sync bits) -> BODY (PID
    //> section, then token or data section) -> (eop) -> IDLE.
    reg st : RxPktState on clock {
        initial it <= #Idle
        it <= when {
            case reset || bus_reset => #Idle
            case sop             => #Sync
            case eop             => #Idle
            case bit_valid && !pkt_err => mux(it == #Sync && nb == 7w5, #Body, it)
            else => it
        }
    }

    //> PID/token-section bit index: sync 0..7 (ignored), PID byte
    //> 0..7, token data 8..18, crc5 wire bits 19..23; parked at 24 in
    //> the data section (and reached at EOP for a well-formed token).
    reg nb : Word[5] on clock {
        initial it <= 0w5
        it <= when {
            case reset || bus_reset => 0w5
            case sop             => 0w5
            case bit_valid && !pkt_err => match st {
                case #Sync => mux(it == 7w5, 0w5, it + 1w5)
                case #Body => when {
                    // data section: parked at 24
                    case sec     => it
                    // last PID bit: classify the packet from the low 2
                    // PID bits (11 = data -> park at 24; else token/
                    // handshake bits start at 8)
                    case it == 7w5 => mux(pid_new[2..0] == 3w2, 24w5, 8w5)
                    else           => it + 1w5
                }
                else => it
            }
            else => it
        }
    }

    //> Data-section bit-in-byte index (0..7, wraps mod 8).
    reg n3 : Word[3] on clock {
        initial it <= 0w3
        it <= when {
            case reset || bus_reset => 0w3
            case sop             => 0w3
            case bit_valid && !pkt_err => match st {
                case #Sync => mux(nb == 7w5, 0w3, it)
                case #Body => mux(sec,
                    it + 1w3,
                    mux(nb == 7w5 && pid_new[2..0] == 3w2, 0w3, it))
                else => it
            }
            else => it
        }
    }

    //> The PID byte, FROZEN after the PID section (it classifies the
    //> packet at EOP; the token/crc bits never touch it).
    reg pid_r : Word[8] on clock {
        initial it <= 0w8
        it <= when {
            case reset || bus_reset => 0w8
            case sop             => 0w8
            case bit_valid && !pkt_err
                && (st == #Body) && !sec && (nb < 8w5) => pid_new
            else => it
        }
    }

    //> The 11 token bits, shift-up capture (LSB first): at EOP,
    //> addr = tk_sh[6:0], endp = tk_sh[10:7], frame = tk_sh[10:0].
    reg tk_sh : Word[11] on clock {
        initial it <= 0w11
        it <= when {
            case reset || bus_reset => 0w11
            case sop             => 0w11
            case bit_valid && !pkt_err
                && (st == #Body) && !sec
                && (nb >= 8w5) && (nb < 19w5) => word(bit_i, it[11..1])
            else => it
        }
    }

    //> Data-section byte assembly shifter (feeds dt_byte_new).
    reg bshift : Word[8] on clock {
        initial it <= 0w8
        it <= when {
            case reset || bus_reset => 0w8
            case sop             => 0w8
            case bit_valid && !pkt_err
                && (st == #Body) && sec => word(bit_i, it[8..1])
            else => it
        }
    }

    //> Byte count in the data section: payload bytes + the 2
    //> trailing crc16 wire bytes (subtracted at EOP).
    reg bc : Word[7] on clock {
        initial it <= 0w7
        it <= when {
            case reset || bus_reset => 0w7
            case sop             => 0w7
            case bit_valid && !pkt_err
                && (st == #Body) && sec && (n3 == 7w3) => it + 1w7
            else => it
        }
    }

    //> Section flag: 0 = PID section, 1 = data section (set when the
    //> PID low bits say 11).
    reg sec : Bit on clock {
        initial it <= false
        it <= when {
            case reset || bus_reset => false
            case sop             => false
            case bit_valid && !pkt_err
                && (st == #Body) && !it && (nb == 7w5)
                => mux(pid_new[2..0] == 3w2, true, it)
            else => it
        }
    }

    // ---- capture candidates --------------------------------------------
    //> The (wide) end-of-packet capture conditions, precomputed at the
    //> last relevant BIT clock and held until EOP (no bit_valid clks
    //> fire during SE0/EOP, so a hold is safe; any further decoded bit
    //> clears them, so over-long packets stay silent).  The EOP-edge
    //> strobes then close over 2-3 shallow inputs instead of the whole
    //> bit-counting tree.

    //> Registered shared qualify for the PID-section caps (+1 clock: the
    //> caps are consumed only at EOP >= 8 clks later, so it is free).
    //> A same-cycle pkt_err is re-checked inline in every cap.
    reg q_pid_r : Bit on clock {
        initial it <= false
        it <= when {
            case reset || bus_reset => false
            case sop             => false
            case bit_valid => !bad && !pkt_err && (st == #Body) && !sec
            else => it
        }
    }
    //> Registered shared qualify for the data-section cap, ditto.
    reg q_dat_r : Bit on clock {
        initial it <= false
        it <= when {
            case reset || bus_reset => false
            case sop             => false
            case bit_valid => !bad && !pkt_err && (st == #Body) && sec
            else => it
        }
    }

    //> Token cap: last token bit (nb == 23) with token-class PID low
    //> bits (01).
    reg tok_cap : Bit on clock {
        initial it <= false
        it <= when {
            case reset || bus_reset => false
            case sop             => false
            case eop             => false
            case bit_valid => q_pid_r && !pkt_err
                && (pid_r[2..0] == 1w2) && (nb == 23w5)
            else => it
        }
    }
    //> SOF cap: token cap plus PID value 5 (the frame number case).
    reg sof_cap : Bit on clock {
        initial it <= false
        it <= when {
            case reset || bus_reset => false
            case sop             => false
            case eop             => false
            case bit_valid => q_pid_r && !pkt_err
                && (pid_r[2..0] == 1w2) && (nb == 23w5)
                && (pid_r[4..0] == 5w4)
            else => it
        }
    }
    //> Handshake cap: last PID bit (nb == 7) with handshake-class low
    //> bits (00 or 10) and the {~pid, pid} check inline (bad is not
    //> visible yet at this edge -- it comes via the +1-clock pid_bad_r).
    reg hs_cap : Bit on clock {
        initial it <= false
        it <= when {
            case reset || bus_reset => false
            case sop             => false
            case eop             => false
            case bit_valid => q_pid_r && !pkt_err
                && ((pid_r[2..0] == 0w2) || (pid_r[2..0] == 2w2))
                && (nb == 7w5)
                && ((pid_new[4..0] ^ pid_new[8..4]) == 15w4)
            else => it
        }
    }
    //> Data cap: byte-aligned last bit (n3 == 7) with dat_bc_ok_r
    //> (bc in 1..65: at least 2 bytes total at EOP, and one more byte
    //> would still fit the 64-byte payload RAM -- the bc == 66
    //> overflow is gated via the registered bc_is_66_r).
    reg dat_cap : Bit on clock {
        initial it <= false
        it <= when {
            case reset || bus_reset => false
            case sop             => false
            case eop             => false
            case bit_valid => q_dat_r && !pkt_err && (n3 == 7w3) && dat_bc_ok_r
            else => it
        }
    }
    //> Registered byte-count admission for dat_cap (bc in 1..65 as of
    //> the last bit); NOT cleared at sop (holds through, since a
    //> sop-edge recompute would drag bc's D-cone into the strobe
    //> path).
    reg dat_bc_ok_r : Bit on clock {
        initial it <= false
        it <= when {
            case reset || bus_reset => false
            case sop             => it
            case bit_valid => (bc != 0w7) && !bc_is_66_r
            else => it
        }
    }

    // ---- payload storage -----------------------------------------------
    //> The payload RAM instance (block RAM, off the fabric: one write
    //> port + one registered read -- see usb::RxRam above).  Writes
    //> beyond byte 63 are dropped (bc[6]: over-length packets set bad
    //> via bc66_hit_r, so dt_valid never fires and no consumer ever
    //> sees a truncated payload).
    mod ram of RxRam {
        it.clock := clock
        it.we  := dt_wr && !bc[6]
        it.wa  := bc[6..0]
        it.wd  := dt_byte_new
        it.ra  := dt_rd_addr
    }

    // ---- record captures -------------------------------------------
    //> The three record mods.  They read this module's shared
    //> state (pid_r / tk_sh / bc / the caps / the CRC verdicts)
    //> and latch their records at EOP.
    mod tokrec of RxTokenRec {
        it.clock := clock
        it.reset := reset
        it.bus_reset := bus_reset
        it.eop := eop
        it.cap := tok_cap
        it.sof_cap := sof_cap
        it.pid_r := pid_r
        it.sh := tk_sh
        it.crc5_res := crc5_res_r
    }
    //> The held token record (until the next token) + its arrival
    //> strobe.
    outgoing tok_rec : Valid[TokenRec] {
        it := tokrec.rec
    }
    outgoing tk_strobe : Bit {
        it := tokrec.strobe
    }

    // ---- data record -------------------------------------------------
    //> The data record + head window live in usb::RxDataRec; this
    //> instance feeds them the shared packet state (the frozen PID,
    //> the data-section byte count, the byte-complete write strobe,
    //> the completing byte and the CRC16 verdict).
    mod datarec of RxDataRec {
        it.clock := clock
        it.reset := reset
        it.bus_reset := bus_reset
        it.eop := eop
        it.cap := dat_cap
        it.pid_r := pid_r
        it.bc := bc
        it.dat_wr := dt_wr
        it.byte_new := dt_byte_new
        it.crc16_res := crc16_res_r
    }
    //> The held data record (until the next data packet) + its
    //> arrival strobe.
    outgoing data_rec : Valid[DataRec] {
        it := datarec.rec
    }
    outgoing dt_strobe : Bit {
        it := datarec.strobe
    }
    //> Flopped payload head window, packet bytes 0..7 (consumers that
    //> need several bytes AT ONCE -- the EP0 request latch,
    //> SET_LINE_CODING -- cannot use the one-at-a-time RAM port).
    outgoing dt_head : Word[64] {
        it := word(datarec.head7, datarec.head6, datarec.head5,
            datarec.head4, datarec.head3, datarec.head2,
            datarec.head1, datarec.head0)
    }
    //> Payload RAM registered read (usb::RxRam.rd): present dt_rd_addr,
    //> the byte is here the NEXT clock.
    outgoing dt_rd_data : Word[8] {
        it := ram.rd
    }

    // ---- handshake record --------------------------------------------
    //> The handshake record lives in usb::RxHandshakeRec; this
    //> instance feeds it the frozen PID and the handshake cap.
    mod hsrec of RxHandshakeRec {
        it.clock := clock
        it.reset := reset
        it.bus_reset := bus_reset
        it.eop := eop
        it.cap := hs_cap
        it.pid_r := pid_r
    }
    //> The held handshake record (until the next handshake) + its
    //> arrival strobe.
    outgoing hs_rec : Valid[HsRec] {
        it := hsrec.rec
    }
    outgoing hs_strobe : Bit {
        it := hsrec.strobe
    }

}

//> usb_token_record -- the token record, factored out of
//> usb::RxPacketCore.  At a token packet's EOP (cap), latches the
//> PID, the CRC5 verdict and the 11 token bits as a Valid[TokenRec]
//> (per-field stale semantics: @Sof captures only the frame slot, a
//> non-SOF token only addr/endp -- see the TokenRec doc).  The
//> record HOLDS until the next token; `strobe` is the 1-clock
//> arrival pulse.
mod RxTokenRec {
    //> 48 MHz clock: 4 clock cycles per USB FS bit.
    incoming clock : Clock
    //> Synchronous reset, active high (core reset from UsbController).
    incoming reset : Bit
    //> Bus reset strobe from usb::RxPhy (SE0 held >= 2.5 us): flushes
    //> the record.
    incoming bus_reset : Bit
    //> 1-clock pulse: end of packet (SE0 held ~1.75 bit times).
    incoming eop : Bit
    //> Capture decision from usb::RxPacketCore (the token cap).
    incoming cap : Bit
    //> The SOF variant of the cap (the token bits are a frame number).
    incoming sof_cap : Bit
    //> The frozen PID byte.
    incoming pid_r : Word[8]
    //> The 11 captured token bits (LSB first).
    incoming sh : Word[11]
    //> Registered CRC5 residual verdict.
    incoming crc5_res : Bit

    //> The latched record: @Valid from the token's EOP until the next
    //> token latches over it (reset / bus_reset -> @Invalid).
    //> Per-field stale semantics preserved: @Sof captures only the
    //> frame slot (the mux keeps the previous addr/endp), a non-SOF
    //> token captures only addr/endp + pid + crc_ok (the mux keeps
    //> the previous frame).  The held struct value feeds back into
    //> its own D-cone exactly as the flat regs' else => it did.
    //>
    //> The held field extracts end in wires (not inline matches in
    //> the struct literal) to keep every line 4-space-multiple
    //> indented.
    wire held_addr : Word[7] {
        it := match rec {
            case @Valid(t) => t->addr
            case @Invalid() => 0w7
        }
    }
    wire held_endp : Word[4] {
        it := match rec {
            case @Valid(t) => t->endp
            case @Invalid() => 0w4
        }
    }
    wire held_frame : Word[11] {
        it := match rec {
            case @Valid(t) => t->frame
            case @Invalid() => 0w11
        }
    }
    outgoing reg rec : Valid[TokenRec] on clock {
        initial it <= @Invalid()
        it <= when {
            case reset || bus_reset => @Invalid()
            case eop && cap => @Valid(${
                pid = pid_r[4..0],
                crc_ok = crc5_res,
                addr = mux(sof_cap, held_addr, sh[7..0]),
                endp = mux(sof_cap, held_endp, sh[11..7]),
                frame = mux(sof_cap, sh, held_frame),
            })
            else => it
        }
    }
    //> 1-clock pulse: a token record was latched this edge.
    outgoing reg strobe : Bit on clock {
        initial it <= false
        it <= when {
            case reset || bus_reset => false
            else => eop && cap
        }
    }
}

//> usb_handshake_record -- the handshake record, factored out of
//> usb::RxPacketCore.  At a handshake's EOP (cap), latches the PID
//> as a Valid[HsRec]; nothing follows the PID byte on the wire.  The
//> record HOLDS until the next handshake; `strobe` is the 1-clock
//> arrival pulse.
mod RxHandshakeRec {
    //> 48 MHz clock: 4 clock cycles per USB FS bit.
    incoming clock : Clock
    //> Synchronous reset, active high (core reset from UsbController).
    incoming reset : Bit
    //> Bus reset strobe from usb::RxPhy (SE0 held >= 2.5 us): flushes
    //> the record.
    incoming bus_reset : Bit
    //> 1-clock pulse: end of packet (SE0 held ~1.75 bit times).
    incoming eop : Bit
    //> Capture decision from usb::RxPacketCore (the handshake cap).
    incoming cap : Bit
    //> The frozen PID byte.
    incoming pid_r : Word[8]

    //> The latched record: @Valid from the handshake's EOP until the
    //> next handshake latches over it (reset / bus_reset ->
    //> @Invalid).
    outgoing reg rec : Valid[HsRec] on clock {
        initial it <= @Invalid()
        it <= when {
            case reset || bus_reset => @Invalid()
            case eop && cap => @Valid(${ pid = pid_r[4..0] })
            else => it
        }
    }
    //> 1-clock pulse: a handshake record was latched this edge.
    outgoing reg strobe : Bit on clock {
        initial it <= false
        it <= when {
            case reset || bus_reset => false
            else => eop && cap
        }
    }
}

//> usb_data_record -- the data record + the flopped payload head
//> window, factored out of usb::RxPacketCore.  At a data packet's
//> EOP (cap), latches the PID, the payload length (bc - 2: the 2
//> crc16 wire bytes drop out) and the CRC16 verdict as a
//> Valid[DataRec]; the record HOLDS until the next data packet, and
//> `strobe` is the 1-clock arrival pulse.  Also owns the flopped payload head window (bytes 0..7 -- eight
//> SEPARATE byte-regs: each byte's enable is its own shallow decode
//> (dat_wr && bc == k -- k < 8, so the equality subsumes the
//> head-window test) and its D is byte_new directly; the bc compare
//> runs in PARALLEL with the dat_wr cone instead of serially behind
//> it).  A bad packet's payload is still written; the record just
//> never fires for it.
mod RxDataRec {
    //> 48 MHz clock: 4 clock cycles per USB FS bit.
    incoming clock : Clock
    //> Synchronous reset, active high (core reset from UsbController).
    incoming reset : Bit
    //> Bus reset strobe from usb::RxPhy (SE0 held >= 2.5 us): flushes
    //> the record and the head window.
    incoming bus_reset : Bit
    //> 1-clock pulse: end of packet (SE0 held ~1.75 bit times).
    incoming eop : Bit
    //> Capture decision from usb::RxPacketCore (the data cap).
    incoming cap : Bit
    //> The frozen PID byte.
    incoming pid_r : Word[8]
    //> Data-section byte count (payload bytes + the 2 trailing crc16
    //> wire bytes; the length subtracts them back out at EOP).
    incoming bc : Word[7]
    //> Byte-complete write strobe (usb::RxPacketCore's dt_wr).
    incoming dat_wr : Bit
    //> The data-section byte completing on this bit clock.
    incoming byte_new : Word[8]
    //> Registered CRC16 residual verdict.
    incoming crc16_res : Bit

    //> The latched record: @Valid from the data packet's EOP until
    //> the next data packet latches over it (reset / bus_reset ->
    //> @Invalid).
    outgoing reg rec : Valid[DataRec] on clock {
        initial it <= @Invalid()
        it <= when {
            case reset || bus_reset => @Invalid()
            case eop && cap => @Valid(${
                pid = pid_r[4..0],
                len = mux(bc >= 2w7, bc - 2w7, 0w7),
                crc_ok = crc16_res,
            })
            else => it
        }
    }
    //> 1-clock pulse: a data record was latched this edge.
    outgoing reg strobe : Bit on clock {
        initial it <= false
        it <= when {
            case reset || bus_reset => false
            else => eop && cap
        }
    }

    // ---- flopped payload head window ------------------------------------
    //> Packet bytes 0..7 (bc < 8): each byte's enable is its own
    //> shallow decode (dat_wr && bc == k -- k < 8, so the equality
    //> subsumes the head-window test) and its D is byte_new directly;
    //> the bc compare runs in PARALLEL with the dat_wr cone instead of
    //> serially behind it.  A bad packet's payload is still written;
    //> the record just never fires for it.
    outgoing reg head0 : Word[8] on clock {
        initial it <= 0w8
        it <= when {
            case reset || bus_reset => 0w8
            case dat_wr && (bc == 0w7) => byte_new
            else => it
        }
    }
    //> Packet byte 1.
    outgoing reg head1 : Word[8] on clock {
        initial it <= 0w8
        it <= when {
            case reset || bus_reset => 0w8
            case dat_wr && (bc == 1w7) => byte_new
            else => it
        }
    }
    //> Packet byte 2.
    outgoing reg head2 : Word[8] on clock {
        initial it <= 0w8
        it <= when {
            case reset || bus_reset => 0w8
            case dat_wr && (bc == 2w7) => byte_new
            else => it
        }
    }
    //> Packet byte 3.
    outgoing reg head3 : Word[8] on clock {
        initial it <= 0w8
        it <= when {
            case reset || bus_reset => 0w8
            case dat_wr && (bc == 3w7) => byte_new
            else => it
        }
    }
    //> Packet byte 4.
    outgoing reg head4 : Word[8] on clock {
        initial it <= 0w8
        it <= when {
            case reset || bus_reset => 0w8
            case dat_wr && (bc == 4w7) => byte_new
            else => it
        }
    }
    //> Packet byte 5.
    outgoing reg head5 : Word[8] on clock {
        initial it <= 0w8
        it <= when {
            case reset || bus_reset => 0w8
            case dat_wr && (bc == 5w7) => byte_new
            else => it
        }
    }
    //> Packet byte 6.
    outgoing reg head6 : Word[8] on clock {
        initial it <= 0w8
        it <= when {
            case reset || bus_reset => 0w8
            case dat_wr && (bc == 6w7) => byte_new
            else => it
        }
    }
    //> Packet byte 7.
    outgoing reg head7 : Word[8] on clock {
        initial it <= 0w8
        it <= when {
            case reset || bus_reset => 0w8
            case dat_wr && (bc == 7w7) => byte_new
            else => it
        }
    }
}


//> The two sync FIFOs over usb_fifo16x8 (ext/usb_uart.sv): thin
//> fixed-parameter wrappers so the Virdant side can instantiate them
//> as ext mods (Virdant ext mods cannot carry parameters).
//> Port/behavior contract (the usb_fifo16x8 header): the FIFO has NO
//> internal protection -- wr_en must be pre-gated with !full and
//> rd_en with !empty by the caller; the enables carry no count
//> terms, so the count compares never sit in a write/read
//> clock-enable cone (a hard requirement at 48 MHz).  Both call
//> sites comply (usb::UsbUart below): the rx push gate (!rxfifo.full
//> inside rx_push_run) and pop gate (!rxfifo.empty inside rx_pop_d)
//> sit in the strobe pipeline's registers' next-state, the tx write
//> gate is the registered txfifo_wr_d (= tx_strobe && !txfifo.full),
//> and the tx FIFO's only popper -- the snapshot loader -- pops
//> exactly the arm-time min(count,64), so it can never meet empty
//> mid-load.  Simultaneous push+pop is supported; count is 7 bits
//> wide regardless of depth.

//> The 16-deep x 8-bit tx FIFO (usb_fifo16x8 defaults: DEPTH=16,
//> AW=4, RAM=0 -- flop storage, combinational head).
ext mod TxFifo {
    //> 48 MHz clock.
    incoming clock : Clock
    //> Synchronous reset: clears both pointers and the count (the
    //> caller passes reset || bus_reset).
    incoming reset : Bit
    //> Push strobe: wr_data is stored at the next posedge.  The
    //> caller pre-gates with !full (the FIFO has no internal
    //> protection); here that gate is the registered txfifo_wr_d.
    incoming wr_en : Bit
    //> Byte to store at the push edge.
    incoming wr_data : Word[8]
    //> Pop strobe: the head is removed at the next posedge.  The
    //> caller pre-gates with !empty; here the only popper is the
    //> snapshot loader, one byte per clock during a bulk-IN load.
    incoming rd_en : Bit
    //> The head byte, combinational -- valid the whole cycle, so the
    //> snapshot loader captures it into SnapRam on the same edge it
    //> pops (rd_en and snapram.we fire together).
    outgoing rd_data : Word[8]
    //> Bytes stored (0..16).
    outgoing count : Word[7]
    //> Full (count == 16).
    outgoing full : Bit
    //> Empty (count == 0).
    outgoing empty : Bit
}

//> The 64-deep x 8-bit bulk-OUT rx FIFO (DEPTH=64, AW=6, RAM=1):
//> block-RAM storage with the registered free-running read port
//> (keeps 512 flops and their per-byte write-decode cones off the
//> fabric, at the cost of a one-clock-delayed rd_data).  DEPTH=64,
//> not a generic 16: a max-size (64 B) bulk-OUT packet must be
//> absorbed atomically under the whole-packet-must-fit admission
//> rule (endpoint::Serial NAKs an OUT that does not fit whole), which a
//> 16-deep FIFO could never accept.
ext mod RxFifo {
    //> 48 MHz clock.
    incoming clock : Clock
    //> Synchronous reset: clears both pointers and the count (the
    //> caller passes reset || bus_reset).
    incoming reset : Bit
    //> Push strobe: wr_data is stored at the next posedge.  The
    //> caller pre-gates with !full -- the gate lives in rx_push_run's
    //> next-state and the strobe is retimed one clock into
    //> rx_push_run_d (the FIFO has no internal protection).
    incoming wr_en : Bit
    //> Byte to store at the push edge (the payload RAM's registered
    //> read, paired with the strobe one clock later).
    incoming wr_data : Word[8]
    //> Pop strobe: the head is removed at the next posedge.  The
    //> caller pre-gates with !empty (plus a one-clock bubble that
    //> blocks a pop in the cycle after the last byte's pop, so the
    //> 7-bit count can never underflow -- see rx_pop_d).
    incoming rd_en : Bit
    //> The registered read output, trailing the read pointer by one
    //> clock: while the FIFO sits idle it is the current head; the clock
    //> after an rd_en pop it still holds the just-popped byte, and
    //> the new head appears one clock later.  (The caller pairs the
    //> popped byte with the delayed valid strobe -- rx_valid /
    //> rx_data.)
    outgoing rd_data : Word[8]
    //> Bytes stored (0..64).
    outgoing count : Word[7]
    //> Full (count == 64).
    outgoing full : Bit
    //> Empty (count == 0).
    outgoing empty : Bit
}

//> The bulk-IN snapshot RAM (64x8 over one iCE40 SB_RAM40_4K cell):
//> at arm time the snapshot loader pops min(count,64) bytes from the
//> tx FIFO in here (one byte per clock), so an unacknowledged IN
//> packet is retransmitted byte-identically until the host ACKs.
//> The 7-bit ports index a 64-entry window of the cell's 256-deep
//> space: writes are gated to !wa[6] (index >= 64 never writes), and
//> a read index >= 64 lands on entries 64..127, which are NEVER
//> written -- X in simulation (tb/sb_ram_sim.v), zero in the
//> bitstream -- never an aliased byte from 0..63.  (The tx fetch
//> index can lead the consumed bytes during the packet tail; the
//> over-fetched byte is never serialized because tx_len caps the
//> PHY, so the read value is harmless either way -- the
//> never-written upper half just keeps an out-of-range fetch visibly
//> X in simulation instead of silently aliasing a stored byte.)
mod SnapRam {
    //> 48 MHz clock.
    incoming clock : Clock
    //> Write enable: the snapshot loader's per-byte step strobe (one
    //> byte per clock while it drains the tx FIFO).
    incoming we : Bit
    //> Write address: the loader's store index, 0..63 (>= 64 is a
    //> no-op -- the !wa[6] write gate).
    incoming wa : Word[7]
    //> Write byte: the tx FIFO's popped head, captured on the same
    //> edge as the pop (the tx FIFO's head is combinational).
    incoming wd : Word[8]
    //> Read address: the tx byte fetch index (usb::TxPhy's
    //> tx_addr_next); >= 64 hits the never-written upper half.
    incoming ra : Word[7]
    //> Registered read data: mem[ra] as of the previous posedge
    //> (free-running read side: RE/RCLKE tied high, NORMAL mode).
    outgoing rd : Word[8]

    mod ram of ice40::SbRam40_4k {
        it.RCLK  := clock
        it.WCLK  := clock
        it.RCLKE := true
        it.WCLKE := true
        it.RE    := true
        it.WE    := we && !wa[6]
        it.WADDR := zext(wa)
        it.RADDR := zext(ra)
        it.WDATA := word(0w8, wd)
        it.MASK  := 0xFF00
        rd := it.RDATA[8..0]
    }
}

//> The descriptor ROM (256x8 initialized block RAM, registered sync
//> read): contiguous pages -- sel0 device@0 (18 B), sel1 config@18
//> (75 B), sel2 str0@93 (4 B), sel3 str1@97 (10 B), sel4 str2@107
//> (32 B declared: bLength 0x20 -- 28 B of UTF-16 string data
//> followed by zero pad up to the declared length).  Only sel0..4
//> ever reach the ROM: GET_STATUS (sel6) bypasses it -- the tx
//> producer mux in usb::UsbUart returns zero bytes for sel6 -- and
//> sel5 does not exist (endpoint::Ep0 implements no line-coding request;
//> an invalid GET_DESCRIPTOR select STALLs instead of arming).
//> The 256-byte initial block lives in the ext body
//> (ext/usb_uart.sv) -- a plain mod over an ice40::SbRam40_4k cell
//> would need an INIT_FILE hex image instead -- and reads are
//> registered: present ra this clock, the byte is on rd the next clock.
ext mod DescRom {
    //> 48 MHz clock.
    incoming clock : Clock
    //> Read address: the latched response base (EP0 page start +
    //> transfer offset, see rom_addr_r in usb::UsbUart) plus the
    //> in-flight byte fetch index.
    incoming ra : Word[8]
    //> Registered read data: desc_rom[ra] as of the previous posedge.
    outgoing rd : Word[8]
}

//> usb_uart -- the core top: descriptor ROM plumbing, token router,
//> response arbiter, bulk snapshot loader, rx push, FIFOs +
//> byte-stream loopback interface (the EP0 / Serial / TxPhy /
//> RxPhy / RxPacket instantiations live here too).  Every reg's
//> next-state is a priority chain, and every registered-helper
//> structure (the +1/+2-clock token strobes, the registered EP0 data
//> strobe, the countdown terminations) is load-bearing -- see
//> wiki/usb-uart.md.
//> usb_token_router -- the token/data/handshake router.  Turns the
//> shared packet-record outputs (rxpkt tk_*/dt_*/hs_*) into the
//> per-endpoint strobes EP0, Serial and the EP2 NAK responder
//> consume.
//>
//> Every strobe here is a REGISTER; the +1/+2-clock delays are
//> load-bearing for the 48 MHz timing (see wiki/usb-uart.md).  The
//> address compare + pid/endp decode feed ONE register's D-cone
//> instead of fanning into every consumer's clock-enable logic, and
//> no token or data packet can land inside a strobe's delay window
//> (the inter-packet gap is >= 2 bit times = 8 clks).
mod UsbTokenRouter {
    //> 48 MHz clock: 4 clock cycles per USB FS bit.
    incoming clock : Clock
    //> Synchronous reset, active high (the core reset from
    //> UsbController).
    incoming reset : Bit
    //> Bus reset strobe (via the core): flushes the routing state.
    incoming bus_reset : Bit
    //> The device's current address (ep0.dev_addr): only tokens whose
    //> address matches route anywhere.
    incoming dev_addr : Word[7]
    //> Packet assembler's pulsed token record (@Valid for exactly one
    //> cycle on capture, serving as both the arrival strobe and the
    //> struct payload; consumers that need stable field access between
    //> packets register the struct fields themselves).
    incoming tk : Valid[TokenRec]
    //> Packet assembler's pulsed data record (@Valid for one cycle
    //> on capture, serving as both the arrival strobe and the struct
    //> payload).
    incoming dt : Valid[DataRec]
    //> Packet assembler handshake-record strobe (a handshake's EOP).
    incoming hs_valid : Bit
    //> The packet assembler's held handshake record.
    incoming hs : Valid[HsRec]
    //> EP0 router hints: a data packet is expected (ep0_busy), the
    //> transfer is STALLed (ep0_stalling), a response is in flight
    //> (ep0_wait_ack).
    incoming ep0_busy : Bit
    //> The transfer is STALLed (qualifies the data-stage STALL
    //> routing via last_out_ep0).
    incoming ep0_stalling : Bit
    //> An EP0 response is in flight (the handshake goes to EP0).
    incoming ep0_wait_ack : Bit
    //> Serial router hints: an OUT data packet is expected
    //> (ser_busy), a response is in flight (ser_ack_wait).
    incoming ser_busy : Bit
    //> A serial response is in flight (the handshake goes to serial).
    incoming ser_ack_wait : Bit

    // ---- record field extraction (registered) ----------------------------
    //> Registered copies of the pulsed token record's pid and endp
    //> fields, captured on the arrival cycle (when tk is @Valid) and
    //> held between packets for the per-endpoint decodes one clock
    //> later.  This replaces the combinational field extraction from
    //> the held struct, keeping the pid/endp decode in flip-flops
    //> instead of one combinational path.
    reg tk_pid_r : Word[4] on clock {
        initial it <= 0w4
        it <= match tk {
            case @Valid(t) => t->pid
            case @Invalid() => it
        }
    }
    reg tk_endp_r : Word[4] on clock {
        initial it <= 0w4
        it <= match tk {
            case @Valid(t) => t->endp
            case @Invalid() => it
        }
    }
    wire hs_pid : Word[4] {
        it := match hs {
            case @Valid(h) => h->pid
            case @Invalid() => 0w4
        }
    }

    // ---- token-valid gate ----------------------------------------------
    //> The device answers only tokens whose CRC5 checks out AND whose
    //> address matches its current dev_addr (starts 0; SET_ADDRESS
    //> latches at status completion inside ep0).  SOF tokens decode
    //> but are ignored.  The address compare + CRC check are
    //> REGISTERED (+1 clock on the pulsed arrival -- well inside the
    //> device turnaround budget): the match expression feeds ONE
    //> register's D-cone instead of fanning into every consumer's
    //> clock-enable logic.  The pid/endp fields are separately
    //> registered (tk_pid_r/tk_endp_r) so the per-endpoint decodes
    //> one clock later read from flip-flops.
    reg tok_v_r : Bit on clock {
        initial it <= false
        it <= when {
            case reset || bus_reset => false
            else => match tk {
                case @Valid(t) => t->crc_ok && (t->addr == dev_addr)
                case @Invalid() => false
            }
        }
    }

    //> The per-endpoint token strobes, REGISTERED one clock further
    //> (the pid/endp decode otherwise stays combinational off tok_v_r
    //> and lands in every consumer's register-enable cone; no token
    //> can land in the delay -- the inter-packet gap is >= 2 bit
    //> times = 8 clks).  ROUTING: pid 13w4 (SETUP) and 9w4 (IN) and
    //> 1w4 (OUT) at endp 0w4 go to ep0; IN/OUT at endp 1w4 go to
    //> serial; IN/OUT at endp 2w4 only feed ep2's NAK.
    outgoing reg ep0_tk_setup_r : Bit on clock {
        initial it <= false
        it <= when {
            case reset || bus_reset => false
            else => tok_v_r && (tk_pid_r == 13w4) && (tk_endp_r == 0w4)
        }
    }
    //> 1-clock strobe: a valid IN token reached EP0 (endp 0).
    outgoing reg ep0_tk_in_r : Bit on clock {
        initial it <= false
        it <= when {
            case reset || bus_reset => false
            else => tok_v_r && (tk_pid_r == 9w4) && (tk_endp_r == 0w4)
        }
    }
    //> 1-clock strobe: a valid OUT token reached EP0 (endp 0).
    outgoing reg ep0_tk_out_r : Bit on clock {
        initial it <= false
        it <= when {
            case reset || bus_reset => false
            else => tok_v_r && (tk_pid_r == 1w4) && (tk_endp_r == 0w4)
        }
    }
    //> 1-clock strobe: a valid IN token reached the serial endpoint
    //> (endp 1).
    outgoing reg ser_tk_in_r : Bit on clock {
        initial it <= false
        it <= when {
            case reset || bus_reset => false
            else => tok_v_r && (tk_pid_r == 9w4) && (tk_endp_r == 1w4)
        }
    }
    //> 1-clock strobe: a valid OUT token reached the serial endpoint
    //> (endp 1).
    outgoing reg ser_tk_out_r : Bit on clock {
        initial it <= false
        it <= when {
            case reset || bus_reset => false
            else => tok_v_r && (tk_pid_r == 1w4) && (tk_endp_r == 1w4)
        }
    }
    //> 1-clock strobe: a valid IN token reached the notif endpoint
    //> (endp 2; the arbiter NAKs it).
    outgoing reg ep2_tk_in_r : Bit on clock {
        initial it <= false
        it <= when {
            case reset || bus_reset => false
            else => tok_v_r && (tk_pid_r == 9w4) && (tk_endp_r == 2w4)
        }
    }
    //> 1-clock strobe: a valid OUT token reached the notif endpoint
    //> (endp 2; the arbiter NAKs it).
    outgoing reg ep2_tk_out_r : Bit on clock {
        initial it <= false
        it <= when {
            case reset || bus_reset => false
            else => tok_v_r && (tk_pid_r == 1w4) && (tk_endp_r == 2w4)
        }
    }

    //> "last valid token was OUT-to-EP0": qualifies EP0's data-stage
    //> STALL.  While EP0 stalls, the only data packet EP0 may own is
    //> the stalled transfer's OWN data stage (its token was
    //> OUT-to-EP0); every other data packet is left for serial or
    //> ignored.  The token precedes its data packet back-to-back, so
    //> this register is stable across the data packet; the next token
    //> re-evaluates it.
    reg last_out_ep0 : Bit on clock {
        initial it <= false
        it <= when {
            case reset || bus_reset => false
            case tok_v_r => (tk_pid_r == 1w4) && (tk_endp_r == 0w4)
            else => it
        }
    }

    //> Data packet router: the module expecting a data packet owns
    //> it.  EP0's strobe is REGISTERED one clock after arrival: the
    //> rxpkt EOP outputs (dt_len = bc-2, dt_crc_ok = the 16-bit
    //> residual compare) carry wide cones, so gating them into EP0's
    //> accept enables in the arrival cycle is a long path.  Every
    //> field EP0 reads holds until the next packet's EOP, so the
    //> delayed read is bit-identical; the +1 clock is free (no token
    //> can land in the delay).  Serial keeps the arrival-cycle strobe:
    //> its accept decision is already registered one clock later
    //> (dt_acc/dt_rej), so its cone is not critical.
    wire ep0_data_take : Bit {
        it := ep0_busy || (ep0_stalling && last_out_ep0)
    }
    wire ep0_dt_gate : Bit {
        it := match dt {
            case @Valid(dontcare) => ep0_data_take
            case @Invalid() => false
        }
    }
    //> 1-clock strobe: a data packet was routed to EP0 (registered
    //> one clock after the pulsed data arrival; the fields hold, so
    //> the delayed read is bit-identical).
    outgoing reg ep0_dt_valid_r : Bit on clock {
        initial it <= false
        it <= when {
            case reset || bus_reset => false
            else => ep0_dt_gate
        }
    }
    //> Arrival-cycle strobe: a data packet was routed to the serial
    //> endpoint (its accept decision registers one clock later, so
    //> this stays unregistered).
    outgoing ser_dt_valid : Bit {
        it := match dt {
            case @Valid(dontcare) => ser_busy && !ep0_data_take
            case @Invalid() => false
        }
    }

    //> Handshake router: the module with a response in flight owns
    //> it.
    outgoing ep0_hs_ack : Bit {
        it := hs_valid && (hs_pid == 2w4) && ep0_wait_ack
    }
    //> 1-clock pulse: an ACK handshake was routed to the serial
    //> endpoint.
    outgoing ser_hs_ack : Bit {
        it := hs_valid && (hs_pid == 2w4) && !ep0_wait_ack && ser_ack_wait
    }
}

//> usb_arbiter -- the response arbiter.  EP0, Serial and the EP2 NAK
//> responder all need the single tx PHY; requests never overlap in
//> protocol order (one response per token/data packet), so a simple
//> priority mux with an in-flight owner register suffices.
//>
//> The EP2 NAK strobe is REGISTERED (a combinational NAK off the
//> token router would drag the whole token-decode cone into the tx
//> engine's state logic; the response comes 1 clock later, still far
//> inside the turnaround budget).  The owner/NAK state resets by
//> reset ONLY, not bus_reset.
mod UsbArbiter {
    //> 48 MHz clock.
    incoming clock : Clock
    //> Synchronous reset, active high (the core reset).
    incoming reset : Bit
    //> EP0's 1-clock response request + held response params.
    incoming ep0_req : Bit
    //> EP0's held response PID (valid with ep0_req and after).
    incoming ep0_pid : Word[4]
    //> EP0's held response length in bytes.
    incoming ep0_len : Word[7]
    //> Serial's 1-clock response request + held response params.
    incoming ser_req : Bit
    //> Serial's held response PID (valid with ser_req and after).
    incoming ser_pid : Word[4]
    //> Serial's held response length in bytes.
    incoming ser_len : Word[7]
    //> Router-gated EP2 token strobes: every token to the notif EP
    //> gets a NAK.
    incoming ep2_tk_in : Bit
    //> 1-clock strobe: a valid OUT token reached the notif endpoint.
    incoming ep2_tk_out : Bit
    //> The tx PHY's done strobe (the in-flight response finished).
    incoming tx_done : Bit

    //> Notif EP (EP2): the host polls it, the core never arms it --
    //> every token gets a NAK.
    reg ep2_nak_req : Bit on clock {
        initial it <= false
        it <= when {
            case reset => false
            else => ep2_tk_in || ep2_tk_out
        }
    }

    //> The tx arm strobe: any pending response request.  This mod
    //> itself reads it back (tx_owner's D) and packs it into the arm
    //> record below.
    wire tx_start : Bit {
        it := ep0_req || ser_req || ep2_nak_req
    }
    //> In-flight response owner: 0 none, 1 ep0, 2 serial, 3 ep2
    //> (ep2 is the registered NAK, the else arm of the start mux).
    outgoing reg tx_owner : Word[2] on clock {
        initial it <= 0w2
        it <= when {
            case reset => 0w2
            case tx_start => when {
                case ep0_req => 1w2
                case ser_req => 2w2
                else         => 3w2
            }
            case tx_done => 0w2
            else => it
        }
    }
    //> The tx arm record: the strobe (@Valid) plus the response the
    //> tx engine launches (EP2 always NAKs: pid 10w4, len 0).  The
    //> same strobe+payload idiom as the RX-side tk/dt records.
    outgoing tx_arm : Valid[phy::TxRec] {
        it := when {
            case tx_start => @Valid(${
                pid = when {
                    case ep0_req => ep0_pid
                    case ser_req => ser_pid
                    else         => 10w4
                },
                len = when {
                    case ep0_req => ep0_len
                    case ser_req => ser_len
                    else         => 0w7
                },
            })
            else => @Invalid()
        }
    }
}

//> usb_snapshot_loader -- the bulk-IN snapshot loader.  A fresh
//> Serial arm pops min(count,64) bytes from the tx FIFO into the
//> snapshot RAM one byte per clock (byte 0 is first needed ~72+ clks
//> after the arm, so the load always wins the race).  Owns the
//> snapshot RAM.
//>
//> Termination is a COUNTDOWN: rem loads the packet length at arm and
//> decrements once per popped byte; the last byte is being written
//> when rem == 1 -- any(rem[7..1]), a 6-input OR into load_run's D.
//> li's increment feeds only its own D.  Byte schedule: one pop per
//> clock, snap[0..len-1] in order.
mod UsbSnapshotLoader {
    //> 48 MHz clock.
    incoming clock : Clock
    //> Synchronous reset, active high.
    incoming reset : Bit
    //> Bus reset strobe (via the core): aborts a load in flight.
    incoming bus_reset : Bit
    //> The tx arm record (arbiter.tx_arm): the @Valid tag is the arm
    //> strobe.
    incoming tx_arm : Valid[phy::TxRec]
    //> Serial's response request + fresh-arm strobe: the arm is a NEW
    //> bulk-IN packet (vs a retransmit of the pending snapshot).
    incoming ser_req : Bit
    //> 1-clock strobe: the arm is a NEW bulk-IN packet (vs a
    //> retransmit of the pending snapshot); reloads the snapshot RAM
    //> from the tx FIFO.
    incoming ser_fresh : Bit
    //> The tx FIFO's head byte (combinational, valid the whole cycle):
    //> captured into the snapshot RAM on each load step's edge, paired
    //> with the pop.
    incoming fifo_head : Word[8]
    //> The tx byte fetch index (the snapshot RAM's read address).
    incoming rd_addr : Word[7]

    //> The arm record's @Valid tag (the strobe).
    wire tx_arm_valid : Bit {
        it := match tx_arm {
            case @Valid(dontcare) => true
            case @Invalid()       => false
        }
    }
    //> The armed packet's length (don't-care off the arm; consumed
    //> only under arm_fresh).
    wire tx_len : Word[7] {
        it := match tx_arm {
            case @Valid(rec) => rec->len
            case @Invalid()  => 0w7
        }
    }

    //> A fresh bulk-IN arm: the arm strobe with serial's fresh-arm
    //> strobe.
    wire arm_fresh : Bit {
        it := tx_arm_valid && ser_req && ser_fresh
    }
    //> The load-in-flight run flag (drives the tx FIFO's pop -- see
    //> the tx FIFO banner for why the pop decision is registered).
    outgoing reg load_run : Bit on clock {
        initial it <= false
        it <= when {
            case reset || bus_reset => false
            case arm_fresh => tx_len != 0w7
            case it        => any(rem[7..1])
            else => it
        }
    }
    //> The snapshot write index.
    reg li : Word[7] on clock {
        initial it <= 0w7
        it <= when {
            case reset || bus_reset => 0w7
            case arm_fresh => 0w7
            case load_run => it + 1w7
            else => it
        }
    }
    //> The load countdown (termination test any(rem[7..1]) in
    //> load_run's D).
    reg rem : Word[7] on clock {
        initial it <= 0w7
        it <= when {
            case reset || bus_reset => 0w7
            case arm_fresh => tx_len
            case load_run => it - 1w7
            else => it
        }
    }
    //> The snapshot RAM.  we fires on a load step -- not the arm
    //> cycle, not reset -- so each write edge lands exactly where
    //> load_run (and its gated pop) say it should.
    mod snapram of SnapRam {
        it.clock := clock
        it.we  := load_run && !arm_fresh && !(reset || bus_reset)
        it.wa  := li
        it.wd  := fifo_head
        it.ra  := rd_addr
    }
    //> The snapshot RAM's read byte (the tx engine's serial-packet
    //> payload source).
    outgoing snap_rd : Word[8] {
        it := snapram.rd
    }
}

//> usb_byte_stream -- the bulk byte-stream engine: the rx/tx FIFOs,
//> the rx push/pop pipelines, the tx write gate and the LED stretch
//> counters.  Exposes the byte stream as two Pipe[Word[8]] handshake
//> sockets:
//>
//>   rx (client): popped rx-FIFO bytes toward the consumer; the
//>   consumer's ready is end-to-end flow control (when low the rx
//>   FIFO fills, serial NAKs bulk-OUT, the host retries: no byte
//>   loss).
//>
//>   tx (server): the consumer's bytes into the tx FIFO; ready is the
//>   registered FIFO room (+1 clock stale -- see the tx_ready
//>   doccomment for why that is safe).
//>
//> The tx payload is CAPTURED into a register alongside the write
//> strobe: the Valid payload's bits are only guaranteed during the
//> push cycle, and the write strobe is retimed one clock (the
//> registered gate keeps the FIFO full-compare out of every byte's
//> write-enable cone -- a hard requirement at 48 MHz, see the TxFifo
//> banner).  Two pushes within 1 clock cannot occur (the only writer
//> pushes at most one byte per ~417 clks), so the capture register is
//> never overwritten mid-write.
mod UsbByteStream {
    //> 48 MHz clock.
    incoming clock : Clock
    //> Synchronous reset, active high.
    incoming reset : Bit
    //> Bus reset strobe (via the core): flushes the FIFOs and the
    //> push/pop pipelines.
    incoming bus_reset : Bit
    //> Serial accepted the OUT packet (its ACK response): the payload
    //> streams into the rx FIFO.
    incoming ser_accept : Bit
    //> The packet assembler's held data record (the rx push reads
    //> its len field: the accepted packet's payload byte count).
    incoming dat : Valid[DataRec]
    //> The packet payload RAM's registered read byte (paired with the
    //> push strobe one clock later).
    incoming dt_rd_data : Word[8]

    //> The held data record, unpacked (the @Invalid default is the
    //> flat dt_len port's reset value 0).
    wire dt : DataRec {
        it := match dat {
            case @Valid(d) => d
            case @Invalid() => ${
                pid = 0w4,
                len = 0w7,
                crc_ok = false,
            }
        }
    }
    wire dt_len : Word[7] {
        it := dt->len
    }
    //> The snapshot loader's pop strobe: the tx FIFO pops exactly the
    //> arm-time min(count,64), one byte per clock (so it can never
    //> meet empty mid-load).
    incoming tx_pop : Bit

    //> Bulk-OUT byte stream toward the consumer.
    client socket rx of Pipe[Word[8]]
    //> Bulk-IN byte stream from the consumer.
    server socket tx of Pipe[Word[8]]

    // ---- FIFOs -----------------------------------------------------------
    //> The 64-deep bulk-OUT rx FIFO.  wr_en is the REGISTERED push
    //> strobe (rx_push_run_d -- pre-gated with !full in its own D);
    //> rd_en is the REGISTERED pop decision (rx_pop_d, pre-gated with
    //> !empty).
    mod rxfifo of RxFifo {
        it.clock     := clock
        it.reset     := reset || bus_reset
        it.wr_en     := rx_push_run_d
        it.wr_data := dt_rd_data
        it.rd_en   := rx_pop_d
    }
    //> The 16-deep tx FIFO.  The write gate is REGISTERED
    //> (txfifo_wr_d) so the cnt full-compare stays out of every
    //> byte's write-enable cone; wr_data is the REGISTERED payload
    //> capture (tx_byte_d -- see the banner).  rd_en is the snapshot
    //> loader's pop (the only popper, popping exactly min(count,64)
    //> counted at arm).
    mod txfifo of TxFifo {
        it.clock     := clock
        it.reset     := reset || bus_reset
        it.wr_en   := txfifo_wr_d
        it.wr_data := tx_byte_d
        it.rd_en   := tx_pop
    }

    // ---- tx side -----------------------------------------------------------
    //> tx_ready is REGISTERED (+1 clock stale): the consumer's push
    //> decision then reads only registered terms, keeping the cnt
    //> full-compare out of its enable cone.  Stale room is safe: the
    //> only writer pushes at most one byte per ~417 clks (single
    //> hold slot), so no push can land inside the 1-clock staleness
    //> window; the txfifo_wr_d gate re-checks !full at the registered
    //> edge as belt-and-braces.
    reg tx_ready : Bit on clock {
        initial it <= false
        it <= !txfifo.full
        tx.ready := it
    }

    //> The push cycle: the consumer's @Valid payload (one clock
    //> strobe).
    wire tx_push : Bit {
        it := match tx.data {
            case @Valid(dontcare) => true
            case @Invalid()       => false
        }
    }
    //> The payload byte (only read on a push cycle).
    wire tx_byte : Word[8] {
        it := match tx.data {
            case @Valid(b) => b
            case @Invalid() => 0w8
        }
    }
    //> The REGISTERED txfifo write gate (see the banner).
    reg txfifo_wr_d : Bit on clock {
        initial it <= false
        it <= tx_push && !txfifo.full
    }
    //> The REGISTERED payload capture: at the push edge the byte is
    //> captured, then held until the next push, so the write edge one
    //> clock later stores the SAME byte the strobe carried (the Valid
    //> payload's bits are not held past the push cycle).
    reg tx_byte_d : Word[8] on clock {
        initial it <= 0w8
        it <= when {
            case tx_push => tx_byte
            else         => it
        }
    }
    //> The tx FIFO's head byte (combinational), popped by the snapshot
    //> loader one byte per load step.
    outgoing tx_head : Word[8] {
        it := txfifo.rd_data
    }
    //> Tx FIFO status for serial's arm decisions.
    outgoing tx_empty : Bit {
        it := txfifo.empty
    }
    //> Bytes currently in the tx FIFO (for serial's arm sizing).
    outgoing tx_count : Word[7] {
        it := txfifo.count
    }
    //> Free slots in the tx FIFO (for serial's arm sizing).
    outgoing tx_room : Word[7] {
        it := 16w7 - txfifo.count
    }

    // ---- rx side -----------------------------------------------------------
    //> The registered pop-to-consumer pipeline (three stages on the
    //> rx side: the BRAM read is registered): the pop decision, then
    //> the (rx_valid pulse, rx_data byte) pair the consumer latches
    //> one clock after the BRAM read port has produced the popped
    //> byte.  In the top-level loopback the consumer is the echo
    //> server: its ready is end-to-end flow control (when low the rx
    //> FIFO fills, the serial endpoint NAKs bulk-OUT, the host
    //> retries: no byte loss).  The pipelined pair takes the
    //> empty/full decode off the single-cycle paths.
    reg rx_pop_d : Bit on clock {
        initial it <= false
        it <= when {
            case reset || bus_reset => false
            // Pop while the rx FIFO has a byte, the tx FIFO keeps
            // 3-stage-pipe headroom (cnt <= 12: 16 deep - 3 in flight
            // - 1 margin, so a landing push never meets a full txfifo
            // and a pop is never silently dropped), AND the byte-
            // stream consumer signals room (rx.ready -- when low the
            // rx FIFO fills, the serial endpoint NAKs bulk-OUT, the
            // host retries: end-to-end flow control with no byte
            // loss).  Also block a pop when the in-flight pop is
            // consuming the last byte: the scheduled next pop would
            // find an empty FIFO and the 7-bit cnt subtract would
            // wrap to 127, draining stale BRAM bytes forever.
            else => !rxfifo.empty && !(rxfifo.count == 1w7 && it)
                && (txfifo.count < 13w7) && rx.ready
        }
    }
    reg rx_valid_r : Bit on clock {
        initial it <= false
        it <= when {
            case reset || bus_reset => false
            else => rx_pop_d
        }
    }
    //> The popped byte (rxfifo.rd_data holds it from one clock after
    //> rx_pop_d).  NO reset: holds.
    reg rx_data : Word[8] on clock {
        initial it <= 0w8
        it <= when {
            case reset || bus_reset => it
            else => rxfifo.rd_data
        }
    }
    //> 1-clock strobe per received byte (= the pop, +2 clocks).  The
    //> consumer latches the byte on it.
    reg rx_valid : Bit on clock {
        initial it <= false
        it <= when {
            case reset || bus_reset => false
            else => rx_valid_r
        }
    }
    //> The client socket's payload: the popped byte rides @Valid for
    //> exactly the rx_valid strobe cycle.
    wire rx_payload : Valid[Word[8]] {
        it := when {
            case rx_valid => @Valid(rx_data)
            else          => @Invalid()
        }
    }
    rx.data := rx_payload

    // ---- rx push -------------------------------------------------------------
    //> Accepted bulk-OUT payloads stream from the packet payload RAM
    //> into the rx FIFO, one byte per clock: the payload RAM registers
    //> mem[push_i] into dt_rd_data one clock after the index holds it,
    //> so the 1-stage rx_push_run_d strobe pairs index and byte
    //> exactly (byte i written at the C(2+i)->C(3+i) posedge, once,
    //> in order).  wr_en is pre-gated with !full inside rx_push_run's
    //> own D (the serial accept already required cnt+dt_len <= 64),
    //> so the rxfifo write port sees two clean registers.
    //>
    //> Termination is a COUNTDOWN (push_rem): the stop test is a
    //> 6-input NOR; push_i's increment feeds only its own D.
    //> Byte-exact: push_rem==1 in cycle N means cycle N pushes the
    //> last byte, so run drops at N's edge with the last byte
    //> written (push_i visits one extra index in the trailing
    //> cycle; that read is discarded -- run_d is 0 by then).
    reg rx_push_run : Bit on clock {
        initial it <= false
        it <= when {
            case reset || bus_reset => false
            case ser_accept => (dt_len != 0w7) && !rxfifo.full
            case it         => any(push_rem[7..1])
            else => it
        }
    }
    reg rx_push_run_d : Bit on clock {
        initial it <= false
        it <= when {
            case reset || bus_reset => false
            else => rx_push_run
        }
    }
    //> The packet payload RAM's read index: the rx push streams the
    //> accepted payload out through the RAM's registered read port.
    outgoing reg push_i : Word[7] on clock {
        initial it <= 0w7
        it <= when {
            case reset || bus_reset => 0w7
            case ser_accept => 0w7
            case rx_push_run => it + 1w7
            else => it
        }
    }
    reg push_rem : Word[7] on clock {
        initial it <= 0w7
        it <= when {
            case reset || bus_reset => 0w7
            case ser_accept => dt_len
            case rx_push_run => it - 1w7
            else => it
        }
    }
    //> Does the whole packet fit the rx FIFO?  adder+compare (carry
    //> chain), combinational -- serial registers the DECISION one
    //> clock later (dt_acc/dt_rej), so this stays out of its response
    //> cycle.
    wire rx_sum : Word[8] {
        it := word(0w1, rxfifo.count) + word(0w1, dt_len)
    }
    //> True when the accepted packet's payload (dt_len) fits the rx
    //> FIFO's free slots (combinational; serial registers the accept
    //> decision off this).
    outgoing rx_room_ok : Bit {
        it := rx_sum <= 64w8
    }

    // ---- LEDs -----------------------------------------------------------------
    //> USB activity indicators: the rx/tx byte-stream strobes
    //> stretched to ~175 ms (the 1-clock strobes are far too fast to
    //> see).  Self-contained counters -- deliberately outside every
    //> USB engine path, NO reset (power-on zero, count down to rest).
    reg rx_led_count : Word[23] on clock {
        initial it <= 0w23
        it <= when {
            case rx_valid    => 0x7f_ffffw23
            case it != 0w23  => it - 1w23
            else => it
        }
    }
    reg tx_led_count : Word[23] on clock {
        initial it <= 0w23
        it <= when {
            case tx_push     => 0x7f_ffffw23
            case it != 0w23  => it - 1w23
            else => it
        }
    }
    //> The core is receiving data (host -> device); stretched ~175 ms
    //> past the last byte (drives led_red, active low, at the top).
    //> EP0 control traffic is not covered (not in the byte stream).
    outgoing rxing : Bit {
        it := rx_led_count != 0w23
    }
    //> The core is sending data (device -> host); stretched ~175 ms
    //> past the last byte (drives led_green, active low, at the top).
    outgoing txing : Bit {
        it := tx_led_count != 0w23
    }
}

mod UsbUart {
    //> 48 MHz system clock: each USB FS bit spans 4 clock cycles.
    incoming clock : Clock
    //> Synchronous reset
    incoming reset : Bit
    //> USB D+ D- pins (driven by the unified PHY below,
    //> bulk-forwarded to the pads).
    client socket usb of UsbTxRx

    //> Bulk-OUT byte stream toward the consumer
    client socket rx of Pipe[Word[8]]
    //> Bulk-IN byte stream from the consumer
    server socket tx of Pipe[Word[8]]

    //> The core is receiving data (host -> device); stretched ~175 ms
    //> past the last byte (drives led_red, active low, at the top).
    outgoing rxing : Bit {
        it := bytestream.rxing
    }
    //> The core is sending data (device -> host); stretched ~175 ms
    //> past the last byte (drives led_green, active low, at the top).
    outgoing txing : Bit {
        it := bytestream.txing
    }

    //> The unified PHY (src/phy.vir): the RX chain (decoded bit
    //> stream + sop/eop/error/bus_reset strobes) and the TX chain
    //> (packet-record interface) behind the pad-facing UsbTxRx socket,
    //> bulk-forwarded to this module's boundary.
    mod usbphy of phy::Phy {
        it.clock := clock
        it.reset := reset
        usb :=: it.usb

        it.tx_arm   := arbiter.tx_arm
        it.tx_byte  := tx_byte

        unused it.active
        unused it.tx_addr
        unused it.tx_busy
    }

    //> The packet assembler (bits -> tk_*/dt_*/hs_* records).  The
    //> payload RAM read address is the rx-push index push_i: the rx
    //> push streams the accepted payload out through the registered
    //> read port.
    mod rxpkt of RxPacket {
        it.clock       := clock
        it.reset       := reset
        it.bus_reset := usbphy.bus_reset
        it.bit_i     := usbphy.bit_o
        it.bit_valid := usbphy.bit_valid
        it.sop       := usbphy.sop
        it.eop       := usbphy.eop
        it.pkt_err   := usbphy.error
        it.dt_rd_addr := bytestream.push_i[6..0]
        // SOF frames decode but are ignored (the device does no SOF
        // bookkeeping).
        // The dt_* and hs_* flat field outputs are TB-only now (the
        // in-design consumers take the held records).  The token flat
        // fields are gone -- the router consumes the pulsed
        // Valid[TokenRec] directly.  tok_rec (the held record) is
        // likewise unused externally; the pulsed tk port carries
        // the arrival struct for the router.
        unused it.tok_rec

        unused it.hs_pid
    }

    // ---- EP0 + serial protocol modules ---------------------------------
    //> EP0 (control transfers + CDC requests) and Serial (EP1 bulk
    //> data): see their own banners.  The data record is shared
    //> straight off the packet assembler (it holds between packets);
    //> only the per-module data strobes are gated by the router.
    mod ep0 of endpoint::Ep0 {
        it.clock       := clock
        it.reset       := reset
        it.bus_reset := usbphy.bus_reset
        it.tk_setup  := router.ep0_tk_setup_r
        it.tk_in     := router.ep0_tk_in_r
        it.tk_out    := router.ep0_tk_out_r
        it.dt_valid  := router.ep0_dt_valid_r
        it.dat       := rxpkt.data_rec
        it.dt_head   := rxpkt.dt_head
        it.hs_ack    := router.ep0_hs_ack
    }

    mod serial of endpoint::Serial {
        it.clock       := clock
        it.reset       := reset
        it.bus_reset := usbphy.bus_reset
        it.set_cfg   := cfg_strobe
        it.tk_in     := router.ser_tk_in_r
        it.tk_out    := router.ser_tk_out_r
        it.dt_valid  := router.ser_dt_valid
        it.dat       := rxpkt.data_rec
        it.hs_ack    := router.ser_hs_ack
        it.txfifo_empty := bytestream.tx_empty
        it.txfifo_count := bytestream.tx_count
        it.rx_room      := bytestream.rx_room_ok
        it.tx_room      := bytestream.tx_room
    }

    // ---- token router ----------------------------------------------------
    //> Turns the shared packet records into the per-endpoint strobes
    //> (address compare, pid/endp decode, data/handshake routing).
    //> See its banner for why every strobe here is a register.
    mod router of UsbTokenRouter {
        it.clock     := clock
        it.reset     := reset
        it.bus_reset := usbphy.bus_reset
        it.dev_addr  := ep0.dev_addr
        it.tk  := rxpkt.tk
        it.dt  := rxpkt.dt
        it.hs_valid  := rxpkt.hs_valid
        it.hs        := rxpkt.hs_rec
        it.ep0_busy    := ep0.ep0_busy
        it.ep0_stalling := ep0.ep0_stalling
        it.ep0_wait_ack := ep0.ep0_wait_ack
        it.ser_busy    := serial.ser_busy
        it.ser_ack_wait := serial.ser_ack_wait
    }

    // ---- response arbiter ---------------------------------------------------
    //> Picks the owner of the single tx PHY (ep0 / serial / ep2 NAK).
    //> See its banner.
    mod arbiter of UsbArbiter {
        it.clock := clock
        it.reset := reset
        it.ep0_req := ep0.resp_req
        it.ep0_pid := ep0.resp_pid
        it.ep0_len := ep0.resp_len
        it.ser_req := serial.resp_req
        it.ser_pid := serial.resp_pid
        it.ser_len := serial.resp_len
        it.ep2_tk_in  := router.ep2_tk_in_r
        it.ep2_tk_out := router.ep2_tk_out_r
        it.tx_done := usbphy.tx_done
    }

    // ---- snapshot loader ------------------------------------------------------
    //> Drains the tx FIFO into the snapshot RAM on a fresh bulk-IN
    //> arm (min(count,64) bytes, one per clock); owns the snapshot
    //> RAM.  See its banner.
    mod loader of UsbSnapshotLoader {
        it.clock     := clock
        it.reset     := reset
        it.bus_reset := usbphy.bus_reset
        it.tx_arm    := arbiter.tx_arm
        it.ser_req   := serial.resp_req
        it.ser_fresh := serial.resp_fresh
        it.fifo_head := bytestream.tx_head
        it.rd_addr   := byte_rd_addr
    }

    // ---- byte-stream engine ------------------------------------------------------
    //> The rx/tx FIFOs + the rx push/pop pipelines + the LED
    //> counters.  Its byte-stream pipes are the ones exposed at this
    //> module's boundary (forwarded unchanged).
    mod bytestream of UsbByteStream {
        it.clock      := clock
        it.reset      := reset
        it.bus_reset  := usbphy.bus_reset
        it.ser_accept := ser_accept
        it.dat        := rxpkt.data_rec
        it.dt_rd_data := rxpkt.dt_rd_data
        it.tx_pop     := loader.load_run
        // The rx/tx pipes: bulk-forwarded to this module's boundary.
        rx :=: it.rx
        tx :=: it.tx
    }

    //> Serial accepted an OUT packet (its ACK response): the rx push
    //> streams the accepted payload into the rx FIFO.
    wire ser_accept : Bit {
        it := serial.resp_req && (serial.resp_pid == 2w4)
    }

    //> SET_CONFIGURATION completed -> reset the bulk data toggles
    //> (USB 2.0 §9.1.1.5): edge detect on ep0.configured.  The
    //> delayed copy is reset by reset ONLY (survives bus resets until
    //> reconfigured).
    reg configured_d : Bit on clock {
        initial it <= false
        it <= when {
            case reset => false
            else => ep0.configured
        }
    }
    wire cfg_strobe : Bit {
        it := ep0.configured ^^ configured_d
    }

    // ---- byte fetch pipeline ---------------------------------------------
    //> Per byte of the in-flight packet: tx_addr_next (comb from the
    //> tx PHY's bit index) -> byte_rd_addr (reg) -> snap_rd / the
    //> descriptor ROM's rd output (the BRAM sync-read output
    //> registers live inside the ext bodies).  The producer mux below feeds the PHY from
    //> registered sources only; the PHY's tx_byte register is a
    //> further stage.
    reg byte_rd_addr : Word[7] on clock {
        initial it <= 0w7
        it <= usbphy.tx_addr_next
    }
    //> EP0 ROM page start by descriptor select.
    wire rom_page : Word[8] {
        it := match ep0.resp_sel {
            case 0w3 => 0w8
            case 1w3 => 18w8
            case 2w3 => 93w8
            case 3w3 => 97w8
            case 4w3 => 107w8
            else => 0w8
        }
    }
    //> The latched EP0 response base: page start + transfer offset,
    //> latched at arm.  Reset by reset ONLY, not usbphy.bus_reset.
    reg rom_base_r : Word[8] on clock {
        initial it <= 0w8
        it <= when {
            case reset => 0w8
            case ep0.resp_req => rom_page + ep0.resp_base[8..0]
            else => it
        }
    }
    //> The ROM read address, one stage behind the base (free-running
    //> adder; only the latched-at-arm base matters).
    reg rom_addr_r : Word[8] on clock {
        initial it <= 0w8
        it <= rom_base_r + word(0w1, byte_rd_addr)
    }
    mod descrom of DescRom {
        it.clock := clock
        it.ra := rom_addr_r
    }
    //> tx PHY producer mux (registered sources only): serial data
    //> comes from the snapshot RAM; GET_STATUS (sel 6) reads as zero
    //> bytes; everything else reads the descriptor ROM.
    wire tx_byte : Word[8] {
        it := when {
            case arbiter.tx_owner == 2w2 => loader.snap_rd
            case ep0.resp_sel == 6w3 => 0w8
            else => descrom.rd
        }
    }
}

pub mod UsbController {
    //> 48 MHz board clock.
    incoming clock : Clock
    //> From PowerOnReset
    //> high once the ~175 ms power-on count is done.
    incoming por_done : Bit

    //> USB D+ and D- pins
    client socket usb of UsbTxRx

    //> Byte-stream interface to the byte-stream consumer
    //> Bulk-OUT byte stream toward the consumer
    client socket rx of Pipe[Word[8]]
    //> Byte-stream interface to the byte-stream producer
    //> Bulk-IN byte stream from the consumer
    server socket tx of Pipe[Word[8]]

    //> The core is receiving data (host -> device); stretched ~175 ms
    //> past the last byte (drives led_red, active low, at the top).
    outgoing rxing : Bit
    //> The core is sending data (device -> host); stretched ~175 ms
    //> past the last byte (drives led_green, active low).
    outgoing txing : Bit

    //> the core reset persists until a cycle after the power-on reset is complete
    reg core_reset : Bit on clock {
        initial it <= true
        it <= !por_done
    }

    mod core of UsbUart {
        it.clock    := clock
        it.reset    := core_reset
        // The pad-facing UsbTxRx socket: bulk-forwarded from UsbUart.
        usb :=: it.usb
        // The rx/tx pipes: bulk-forwarded from the core.
        rx :=: it.rx
        tx :=: it.tx

        rxing         := it.rxing
        txing         := it.txing
    }
}
